N#ifndef GD32F4XX_H
S#define GD32F4XX_H
S
S#ifdef __cplusplus
S extern "C" {
S#endif
S
S/* define GD32F4xx */
S#if !defined (GD32F450)  && !defined (GD32F405) && !defined (GD32F407)
S  /* #define GD32F450 */
S  /* #define GD32F405 */
S  #define GD32F407
S#endif /* define GD32F4xx */
S
S#if !defined (GD32F450)  && !defined (GD32F405) && !defined (GD32F407)
S #error "Please select the target GD32F4xx device in gd32f4xx.h file"
S#endif /* undefine GD32F4xx tip */
S
S/* define value of high speed crystal oscillator (HXTAL) in Hz */
S#if !defined  (HXTAL_VALUE)
S#define HXTAL_VALUE    ((uint32_t)25000000)
S#endif /* high speed crystal oscillator value */
S
S/* define startup timeout value of high speed crystal oscillator (HXTAL) */
S#if !defined  (HXTAL_STARTUP_TIMEOUT)
S#define HXTAL_STARTUP_TIMEOUT   ((uint16_t)0xFFFF)
S#endif /* high speed crystal oscillator startup timeout */
S
S/* define value of internal 16MHz RC oscillator (IRC16M) in Hz */
S#if !defined  (IRC16M_VALUE)
S#define IRC16M_VALUE  ((uint32_t)16000000)
S#endif /* internal 16MHz RC oscillator value */
S
S/* define startup timeout value of internal 16MHz RC oscillator (IRC16M) */
S#if !defined  (IRC16M_STARTUP_TIMEOUT)
S#define IRC16M_STARTUP_TIMEOUT   ((uint16_t)0x0500)
S#endif /* internal 16MHz RC oscillator startup timeout */
S
S/* define value of internal 32KHz RC oscillator(IRC32K) in Hz */
S#if !defined  (IRC32K_VALUE)
S#define IRC32K_VALUE  ((uint32_t)32000)
S#endif /* internal 32KHz RC oscillator value */
S
S/* define value of low speed crystal oscillator (LXTAL)in Hz */
S#if !defined  (LXTAL_VALUE)
S#define LXTAL_VALUE  ((uint32_t)32768)
S#endif /* low speed crystal oscillator value */
S
S/* I2S external clock in selection */
S//#define I2S_EXTERNAL_CLOCK_IN          (uint32_t)12288000U
S
S/* GD32F4xx firmware library version number V1.0 */
S#define __GD32F4xx_STDPERIPH_VERSION_MAIN   (0x03) /*!< [31:24] main version     */
S#define __GD32F4xx_STDPERIPH_VERSION_SUB1   (0x00) /*!< [23:16] sub1 version     */
S#define __GD32F4xx_STDPERIPH_VERSION_SUB2   (0x00) /*!< [15:8]  sub2 version     */
S#define __GD32F4xx_STDPERIPH_VERSION_RC     (0x00) /*!< [7:0]  release candidate */
S#define __GD32F4xx_STDPERIPH_VERSION        ((__GD32F4xx_STDPERIPH_VERSION_MAIN << 24)\
S                                            |(__GD32F4xx_STDPERIPH_VERSION_SUB1 << 16)\
S                                            |(__GD32F4xx_STDPERIPH_VERSION_SUB2 << 8)\
S                                            |(__GD32F4xx_STDPERIPH_VERSION_RC))
X#define __GD32F4xx_STDPERIPH_VERSION        ((__GD32F4xx_STDPERIPH_VERSION_MAIN << 24)                                            |(__GD32F4xx_STDPERIPH_VERSION_SUB1 << 16)                                            |(__GD32F4xx_STDPERIPH_VERSION_SUB2 << 8)                                            |(__GD32F4xx_STDPERIPH_VERSION_RC))
S
S/* configuration of the cortex-M4 processor and core peripherals */
S#define __CM4_REV                 0x0001   /*!< core revision r0p1                                       */
S#define __MPU_PRESENT             1        /*!< GD32F4xx provide MPU                                     */
S#define __NVIC_PRIO_BITS          4        /*!< GD32F4xx uses 4 bits for the priority levels             */
S#define __Vendor_SysTickConfig    0        /*!< set to 1 if different sysTick config is used             */
S#define __FPU_PRESENT             1        /*!< FPU present                                              */
S/* define interrupt number */
Stypedef enum IRQn
S{
S    /* cortex-M4 processor exceptions numbers */
S    NonMaskableInt_IRQn          = -14,    /*!< 2 non maskable interrupt                                 */
S    MemoryManagement_IRQn        = -12,    /*!< 4 cortex-M4 memory management interrupt                  */
S    BusFault_IRQn                = -11,    /*!< 5 cortex-M4 bus fault interrupt                          */
S    UsageFault_IRQn              = -10,    /*!< 6 cortex-M4 usage fault interrupt                        */
S    SVCall_IRQn                  = -5,     /*!< 11 cortex-M4 SV call interrupt                           */
S    DebugMonitor_IRQn            = -4,     /*!< 12 cortex-M4 debug monitor interrupt                     */
S    PendSV_IRQn                  = -2,     /*!< 14 cortex-M4 pend SV interrupt                           */
S    SysTick_IRQn                 = -1,     /*!< 15 cortex-M4 system tick interrupt                       */
S    /* interruput numbers */
S    WWDGT_IRQn                   = 0,      /*!< window watchdog timer interrupt                          */
S    LVD_IRQn                     = 1,      /*!< LVD through EXTI line detect interrupt                   */
S    TAMPER_STAMP_IRQn            = 2,      /*!< tamper and timestamp through EXTI line detect            */
S    RTC_WKUP_IRQn                = 3,      /*!< RTC wakeup through EXTI line interrupt                   */
S    FMC_IRQn                     = 4,      /*!< FMC interrupt                                            */
S    RCU_CTC_IRQn                 = 5,      /*!< RCU and CTC interrupt                                    */
S    EXTI0_IRQn                   = 6,      /*!< EXTI line 0 interrupts                                   */
S    EXTI1_IRQn                   = 7,      /*!< EXTI line 1 interrupts                                   */
S    EXTI2_IRQn                   = 8,      /*!< EXTI line 2 interrupts                                   */
S    EXTI3_IRQn                   = 9,      /*!< EXTI line 3 interrupts                                   */
S    EXTI4_IRQn                   = 10,     /*!< EXTI line 4 interrupts                                   */
S    DMA0_Channel0_IRQn           = 11,     /*!< DMA0 channel0 Interrupt                                  */
S    DMA0_Channel1_IRQn           = 12,     /*!< DMA0 channel1 Interrupt                                  */
S    DMA0_Channel2_IRQn           = 13,     /*!< DMA0 channel2 interrupt                                  */
S    DMA0_Channel3_IRQn           = 14,     /*!< DMA0 channel3 interrupt                                  */
S    DMA0_Channel4_IRQn           = 15,     /*!< DMA0 channel4 interrupt                                  */
S    DMA0_Channel5_IRQn           = 16,     /*!< DMA0 channel5 interrupt                                  */
S    DMA0_Channel6_IRQn           = 17,     /*!< DMA0 channel6 interrupt                                  */
S    ADC_IRQn                     = 18,     /*!< ADC interrupt                                            */
S    CAN0_TX_IRQn                 = 19,     /*!< CAN0 TX interrupt                                        */
S    CAN0_RX0_IRQn                = 20,     /*!< CAN0 RX0 interrupt                                       */
S    CAN0_RX1_IRQn                = 21,     /*!< CAN0 RX1 interrupt                                       */
S    CAN0_EWMC_IRQn               = 22,     /*!< CAN0 EWMC interrupt                                      */
S    EXTI5_9_IRQn                 = 23,     /*!< EXTI[9:5] interrupts                                     */
S    TIMER0_BRK_TIMER8_IRQn       = 24,     /*!< TIMER0 break and TIMER8 interrupts                       */
S    TIMER0_UP_TIMER9_IRQn        = 25,     /*!< TIMER0 update and TIMER9 interrupts                      */
S    TIMER0_TRG_CMT_TIMER10_IRQn  = 26,     /*!< TIMER0 trigger and commutation  and TIMER10 interrupts   */
S    TIMER0_Channel_IRQn          = 27,     /*!< TIMER0 channel capture compare interrupt                 */
S    TIMER1_IRQn                  = 28,     /*!< TIMER1 interrupt                                         */
S    TIMER2_IRQn                  = 29,     /*!< TIMER2 interrupt                                         */
S    TIMER3_IRQn                  = 30,     /*!< TIMER3 interrupts                                        */
S    I2C0_EV_IRQn                 = 31,     /*!< I2C0 event interrupt                                     */
S    I2C0_ER_IRQn                 = 32,     /*!< I2C0 error interrupt                                     */
S    I2C1_EV_IRQn                 = 33,     /*!< I2C1 event interrupt                                     */
S    I2C1_ER_IRQn                 = 34,     /*!< I2C1 error interrupt                                     */
