NFlagStatus ctc_interrupt_flag_get(uint32_t int_flag)
N{
N    uint32_t interrupt_flag = 0U, intenable = 0U;
N    
N    /* check whether the interrupt is enabled */
N    if(RESET != (int_flag & CTC_FLAG_MASK)){
X    if(RESET != (int_flag & ((uint32_t)0x00000700U))){
N        intenable = CTC_CTL0 & CTC_CTL0_ERRIE;
X        intenable = (*(volatile uint32_t *)(uint32_t)(((((uint32_t)0x40000000U) + 0x00006C00U)) + 0x00U)) & ((uint32_t)((uint32_t)0x01U<<(2)));
N    }else{
N        intenable = CTC_CTL0 & int_flag;
X        intenable = (*(volatile uint32_t *)(uint32_t)(((((uint32_t)0x40000000U) + 0x00006C00U)) + 0x00U)) & int_flag;
N    }
N    
N    /* get interrupt flag status */
