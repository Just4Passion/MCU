L 41 "..\Libraries\GD32F4xx_standard_peripheral\Include\gd32f4xx_rcu.h" 2
N
N/* RCU definitions */
N#define RCU                             RCU_BASE
N
N/* registers definitions */
N#define RCU_CTL                         REG32(RCU + 0x00U)        /*!< control register */
N#define RCU_PLL                         REG32(RCU + 0x04U)        /*!< PLL register */
N#define RCU_CFG0                        REG32(RCU + 0x08U)        /*!< clock configuration register 0 */
N#define RCU_INT                         REG32(RCU + 0x0CU)        /*!< clock interrupt register */
N#define RCU_AHB1RST                     REG32(RCU + 0x10U)        /*!< AHB1 reset register */
N#define RCU_AHB2RST                     REG32(RCU + 0x14U)        /*!< AHB2 reset register */
N#define RCU_AHB3RST                     REG32(RCU + 0x18U)        /*!< AHB3 reset register */
N#define RCU_APB1RST                     REG32(RCU + 0x20U)        /*!< APB1 reset register */
N#define RCU_APB2RST                     REG32(RCU + 0x24U)        /*!< APB2 reset register */
N#define RCU_AHB1EN                      REG32(RCU + 0x30U)        /*!< AHB1 enable register */
N#define RCU_AHB2EN                      REG32(RCU + 0x34U)        /*!< AHB2 enable register */
N#define RCU_AHB3EN                      REG32(RCU + 0x38U)        /*!< AHB3 enable register */
N#define RCU_APB1EN                      REG32(RCU + 0x40U)        /*!< APB1 enable register */
N#define RCU_APB2EN                      REG32(RCU + 0x44U)        /*!< APB2 enable register */
N#define RCU_AHB1SPEN                    REG32(RCU + 0x50U)        /*!< AHB1 sleep mode enable register */
N#define RCU_AHB2SPEN                    REG32(RCU + 0x54U)        /*!< AHB2 sleep mode enable register */
N#define RCU_AHB3SPEN                    REG32(RCU + 0x58U)        /*!< AHB3 sleep mode enable register */ 
N#define RCU_APB1SPEN                    REG32(RCU + 0x60U)        /*!< APB1 sleep mode enable register */
N#define RCU_APB2SPEN                    REG32(RCU + 0x64U)        /*!< APB2 sleep mode enable register */
N#define RCU_BDCTL                       REG32(RCU + 0x70U)        /*!< backup domain control register */
N#define RCU_RSTSCK                      REG32(RCU + 0x74U)        /*!< reset source / clock register */
N#define RCU_PLLSSCTL                    REG32(RCU + 0x80U)        /*!< PLL clock spread spectrum control register */
N#define RCU_PLLI2S                      REG32(RCU + 0x84U)        /*!< PLLI2S register */ 
N#define RCU_PLLSAI                      REG32(RCU + 0x88U)        /*!< PLLSAI register */ 
N#define RCU_CFG1                        REG32(RCU + 0x8CU)        /*!< clock configuration register 1 */
N#define RCU_ADDCTL                      REG32(RCU + 0xC0U)        /*!< Additional clock control register */
N#define RCU_ADDINT                      REG32(RCU + 0xCCU)        /*!< Additional clock interrupt register */
N#define RCU_ADDAPB1RST                  REG32(RCU + 0xE0U)        /*!< APB1 additional reset register */
N#define RCU_ADDAPB1EN                   REG32(RCU + 0xE4U)        /*!< APB1 additional enable register */
N#define RCU_ADDAPB1SPEN                 REG32(RCU + 0xE8U)        /*!< APB1 additional sleep mode enable register */
N#define RCU_VKEY                        REG32(RCU + 0x100U)       /*!< voltage key register */
N#define RCU_DSV                         REG32(RCU + 0x134U)       /*!< deep-sleep mode voltage register */
N
N/* bits definitions */
N/* RCU_CTL */
N#define RCU_CTL_IRC16MEN                BIT(0)                    /*!< internal high speed oscillator enable */
N#define RCU_CTL_IRC16MSTB               BIT(1)                    /*!< IRC16M high speed internal oscillator stabilization flag */
N#define RCU_CTL_IRC16MADJ               BITS(3,7)                 /*!< high speed internal oscillator clock trim adjust value */
N#define RCU_CTL_IRC16MCALIB             BITS(8,15)                /*!< high speed internal oscillator calibration value register */
N#define RCU_CTL_HXTALEN                 BIT(16)                   /*!< external high speed oscillator enable */
N#define RCU_CTL_HXTALSTB                BIT(17)                   /*!< external crystal oscillator clock stabilization flag */
N#define RCU_CTL_HXTALBPS                BIT(18)                   /*!< external crystal oscillator clock bypass mode enable */
N#define RCU_CTL_CKMEN                   BIT(19)                   /*!< HXTAL clock monitor enable */
N#define RCU_CTL_PLLEN                   BIT(24)                   /*!< PLL enable */
N#define RCU_CTL_PLLSTB                  BIT(25)                   /*!< PLL Clock Stabilization Flag */
N#define RCU_CTL_PLLI2SEN                BIT(26)                   /*!< PLLI2S enable */
N#define RCU_CTL_PLLI2SSTB               BIT(27)                   /*!< PLLI2S Clock Stabilization Flag */
N#define RCU_CTL_PLLSAIEN                BIT(28)                   /*!< PLLSAI enable */
N#define RCU_CTL_PLLSAISTB               BIT(29)                   /*!< PLLSAI Clock Stabilization Flag */
N
N/* RCU_PLL */
N#define RCU_PLL_PLLPSC                  BITS(0,5)                 /*!< The PLL VCO source clock prescaler */
N#define RCU_PLL_PLLN                    BITS(6,14)                /*!< The PLL VCO clock multi factor */
N#define RCU_PLL_PLLP                    BITS(16,17)               /*!< The PLLP output frequency division factor from PLL VCO clock */
N#define RCU_PLL_PLLSEL                  BIT(22)                   /*!< PLL Clock Source Selection */
N#define RCU_PLL_PLLQ                    BITS(24,27)               /*!< The PLL Q output frequency division factor from PLL VCO clock */
N
N/* RCU_CFG0 */
N#define RCU_CFG0_SCS                    BITS(0,1)                 /*!< system clock switch */
N#define RCU_CFG0_SCSS                   BITS(2,3)                 /*!< system clock switch status */
N#define RCU_CFG0_AHBPSC                 BITS(4,7)                 /*!< AHB prescaler selection */
N#define RCU_CFG0_APB1PSC                BITS(10,12)               /*!< APB1 prescaler selection */
N#define RCU_CFG0_APB2PSC                BITS(13,15)               /*!< APB2 prescaler selection */
N#define RCU_CFG0_RTCDIV                 BITS(16,20)               /*!< RTC clock divider factor */
N#define RCU_CFG0_CKOUT0SEL              BITS(21,22)               /*!< CKOUT0 Clock Source Selection */
N#define RCU_CFG0_I2SSEL                 BIT(23)                   /*!< I2S Clock Source Selection */
N#define RCU_CFG0_CKOUT0DIV              BITS(24,26)               /*!< The CK_OUT0 divider which the CK_OUT0 frequency can be reduced */
N#define RCU_CFG0_CKOUT1DIV              BITS(27,29)               /*!< The CK_OUT1 divider which the CK_OUT1 frequency can be reduced */
N#define RCU_CFG0_CKOUT1SEL              BITS(30,31)               /*!< CKOUT1 Clock Source Selection */
N
N/* RCU_INT */
N#define RCU_INT_IRC32KSTBIF             BIT(0)                    /*!< IRC32K stabilization interrupt flag */
N#define RCU_INT_LXTALSTBIF              BIT(1)                    /*!< LXTAL stabilization interrupt flag */
N#define RCU_INT_IRC16MSTBIF             BIT(2)                    /*!< IRC16M stabilization interrupt flag */
N#define RCU_INT_HXTALSTBIF              BIT(3)                    /*!< HXTAL stabilization interrupt flag */
N#define RCU_INT_PLLSTBIF                BIT(4)                    /*!< PLL stabilization interrupt flag */
N#define RCU_INT_PLLI2SSTBIF             BIT(5)                    /*!< PLLI2S stabilization interrupt flag */
N#define RCU_INT_PLLSAISTBIF             BIT(6)                    /*!< PLLSAI stabilization interrupt flag */
N#define RCU_INT_CKMIF                   BIT(7)                    /*!< HXTAL clock stuck interrupt flag */
N#define RCU_INT_IRC32KSTBIE             BIT(8)                    /*!< IRC32K stabilization interrupt enable */
N#define RCU_INT_LXTALSTBIE              BIT(9)                    /*!< LXTAL stabilization interrupt enable */
N#define RCU_INT_IRC16MSTBIE             BIT(10)                   /*!< IRC16M stabilization interrupt enable */
N#define RCU_INT_HXTALSTBIE              BIT(11)                   /*!< HXTAL stabilization interrupt enable */
N#define RCU_INT_PLLSTBIE                BIT(12)                   /*!< PLL stabilization interrupt enable */
N#define RCU_INT_PLLI2SSTBIE             BIT(13)                   /*!< PLLI2S Stabilization Interrupt Enable */
N#define RCU_INT_PLLSAISTBIE             BIT(14)                   /*!< PLLSAI Stabilization Interrupt Enable */
N#define RCU_INT_IRC32KSTBIC             BIT(16)                   /*!< IRC32K Stabilization Interrupt Clear */
N#define RCU_INT_LXTALSTBIC              BIT(17)                   /*!< LXTAL Stabilization Interrupt Clear */
N#define RCU_INT_IRC16MSTBIC             BIT(18)                   /*!< IRC16M Stabilization Interrupt Clear */
N#define RCU_INT_HXTALSTBIC              BIT(19)                   /*!< HXTAL Stabilization Interrupt Clear */
N#define RCU_INT_PLLSTBIC                BIT(20)                   /*!< PLL stabilization Interrupt Clear */
N#define RCU_INT_PLLI2SSTBIC             BIT(21)                   /*!< PLLI2S stabilization Interrupt Clear */
N#define RCU_INT_PLLSAISTBIC             BIT(22)                   /*!< PLLSAI stabilization Interrupt Clear */
N#define RCU_INT_CKMIC                   BIT(23)                   /*!< HXTAL Clock Stuck Interrupt Clear */
N
N/* RCU_AHB1RST */
N#define RCU_AHB1RST_PARST               BIT(0)                    /*!< GPIO port A reset */
N#define RCU_AHB1RST_PBRST               BIT(1)                    /*!< GPIO port B reset */
N#define RCU_AHB1RST_PCRST               BIT(2)                    /*!< GPIO port C reset */
N#define RCU_AHB1RST_PDRST               BIT(3)                    /*!< GPIO port D reset */
N#define RCU_AHB1RST_PERST               BIT(4)                    /*!< GPIO port E reset */
