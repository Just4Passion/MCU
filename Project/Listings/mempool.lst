S                                     rt_err_t thread_error,
S                                     struct rt_spinlock *lock);
S
S/* suspend and enqueue */
Srt_err_t rt_thread_suspend_to_list(rt_thread_t thread, rt_list_t *susp_list, int ipc_flags, int suspend_flag);
S/* only for a suspended thread, and caller must hold the scheduler lock */
Srt_err_t rt_susp_list_enqueue(rt_list_t *susp_list, rt_thread_t thread, int ipc_flags);
