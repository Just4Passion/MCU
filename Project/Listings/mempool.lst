N#else
N#include <rthw.h>
N#define rt_atomic_load(ptr) rt_soft_atomic_load(ptr)
N#define rt_atomic_store(ptr, v) rt_soft_atomic_store(ptr, v)
N#define rt_atomic_add(ptr, v) rt_soft_atomic_add(ptr, v)
N#define rt_atomic_sub(ptr, v) rt_soft_atomic_sub(ptr, v)
N#define rt_atomic_and(ptr, v) rt_soft_atomic_and(ptr, v)
N#define rt_atomic_or(ptr, v)  rt_soft_atomic_or(ptr, v)
N#define rt_atomic_xor(ptr, v) rt_soft_atomic_xor(ptr, v)
N#define rt_atomic_exchange(ptr, v) rt_soft_atomic_exchange(ptr, v)
N#define rt_atomic_flag_clear(ptr) rt_soft_atomic_flag_clear(ptr)
N#define rt_atomic_flag_test_and_set(ptr) rt_soft_atomic_flag_test_and_set(ptr)
N#define rt_atomic_compare_exchange_strong(ptr, v,des) rt_soft_atomic_compare_exchange_strong(ptr, v ,des)
N
Nrt_inline rt_atomic_t rt_soft_atomic_exchange(volatile rt_atomic_t *ptr, rt_atomic_t val)
Xstatic __inline rt_atomic_t rt_soft_atomic_exchange(volatile rt_atomic_t *ptr, rt_atomic_t val)
N{
N    rt_base_t level;
N    rt_atomic_t temp;
N    level = rt_hw_interrupt_disable();
N    temp = *ptr;
N    *ptr = val;
N    rt_hw_interrupt_enable(level);
N    return temp;
N}
N
Nrt_inline rt_atomic_t rt_soft_atomic_add(volatile rt_atomic_t *ptr, rt_atomic_t val)
Xstatic __inline rt_atomic_t rt_soft_atomic_add(volatile rt_atomic_t *ptr, rt_atomic_t val)
N{
N    rt_base_t level;
N    rt_atomic_t temp;
N    level = rt_hw_interrupt_disable();
N    temp = *ptr;
N    *ptr += val;
N    rt_hw_interrupt_enable(level);
N    return temp;
N}
N
Nrt_inline rt_atomic_t rt_soft_atomic_sub(volatile rt_atomic_t *ptr, rt_atomic_t val)
Xstatic __inline rt_atomic_t rt_soft_atomic_sub(volatile rt_atomic_t *ptr, rt_atomic_t val)
N{
N    rt_base_t level;
N    rt_atomic_t temp;
N    level = rt_hw_interrupt_disable();
N    temp = *ptr;
N    *ptr -= val;
N    rt_hw_interrupt_enable(level);
N    return temp;
N}
N
Nrt_inline rt_atomic_t rt_soft_atomic_xor(volatile rt_atomic_t *ptr, rt_atomic_t val)
Xstatic __inline rt_atomic_t rt_soft_atomic_xor(volatile rt_atomic_t *ptr, rt_atomic_t val)
N{
N    rt_base_t level;
N    rt_atomic_t temp;
N    level = rt_hw_interrupt_disable();
N    temp = *ptr;
N    *ptr = (*ptr) ^ val;
N    rt_hw_interrupt_enable(level);
N    return temp;
N}
N
Nrt_inline rt_atomic_t rt_soft_atomic_and(volatile rt_atomic_t *ptr, rt_atomic_t val)
Xstatic __inline rt_atomic_t rt_soft_atomic_and(volatile rt_atomic_t *ptr, rt_atomic_t val)
N{
N    rt_base_t level;
N    rt_atomic_t temp;
N    level = rt_hw_interrupt_disable();
N    temp = *ptr;
N    *ptr = (*ptr) & val;
N    rt_hw_interrupt_enable(level);
N    return temp;
N}
N
Nrt_inline rt_atomic_t rt_soft_atomic_or(volatile rt_atomic_t *ptr, rt_atomic_t val)
Xstatic __inline rt_atomic_t rt_soft_atomic_or(volatile rt_atomic_t *ptr, rt_atomic_t val)
N{
N    rt_base_t level;
N    rt_atomic_t temp;
N    level = rt_hw_interrupt_disable();
N    temp = *ptr;
N    *ptr = (*ptr) | val;
N    rt_hw_interrupt_enable(level);
N    return temp;
N}
N
Nrt_inline rt_atomic_t rt_soft_atomic_load(volatile rt_atomic_t *ptr)
Xstatic __inline rt_atomic_t rt_soft_atomic_load(volatile rt_atomic_t *ptr)
N{
N    rt_base_t level;
N    rt_atomic_t temp;
N    level = rt_hw_interrupt_disable();
N    temp = *ptr;
N    rt_hw_interrupt_enable(level);
N    return temp;
N}
N
Nrt_inline void rt_soft_atomic_store(volatile rt_atomic_t *ptr, rt_atomic_t val)
Xstatic __inline void rt_soft_atomic_store(volatile rt_atomic_t *ptr, rt_atomic_t val)
N{
N    rt_base_t level;
N    level = rt_hw_interrupt_disable();
N    *ptr = val;
N    rt_hw_interrupt_enable(level);
N}
N
Nrt_inline rt_atomic_t rt_soft_atomic_flag_test_and_set(volatile rt_atomic_t *ptr)
Xstatic __inline rt_atomic_t rt_soft_atomic_flag_test_and_set(volatile rt_atomic_t *ptr)
N{
N    rt_base_t level;
N    rt_atomic_t temp;
N    level = rt_hw_interrupt_disable();
N    if (*ptr == 0)
N    {
N        temp = 0;
N        *ptr = 1;
N    }
N    else
N        temp = 1;
N    rt_hw_interrupt_enable(level);
N    return temp;
N}
N
Nrt_inline void rt_soft_atomic_flag_clear(volatile rt_atomic_t *ptr)
Xstatic __inline void rt_soft_atomic_flag_clear(volatile rt_atomic_t *ptr)
N{
N    rt_base_t level;
N    level = rt_hw_interrupt_disable();
N    *ptr = 0;
N    rt_hw_interrupt_enable(level);
N}
N
Nrt_inline rt_atomic_t rt_soft_atomic_compare_exchange_strong(volatile rt_atomic_t *ptr1, rt_atomic_t *ptr2,
Xstatic __inline rt_atomic_t rt_soft_atomic_compare_exchange_strong(volatile rt_atomic_t *ptr1, rt_atomic_t *ptr2,
N        rt_atomic_t desired)
N{
N    rt_base_t level;
N    rt_atomic_t temp;
N    level = rt_hw_interrupt_disable();
N    if ((*ptr1) != (*ptr2))
N    {
N        *ptr2 = *ptr1;
N        temp = 0;
N    }
N    else
N    {
N        *ptr1 = desired;
N        temp = 1;
N    }
N    rt_hw_interrupt_enable(level);
N    return temp;
N}
N#endif /* RT_USING_STDC_ATOMIC */
N
Nrt_inline rt_bool_t rt_atomic_dec_and_test(volatile rt_atomic_t *ptr)
Xstatic __inline rt_bool_t rt_atomic_dec_and_test(volatile rt_atomic_t *ptr)
N{
N    return rt_atomic_sub(ptr, 1) == 1;
X    return rt_soft_atomic_sub(ptr, 1) == 1;
N}
N
Nrt_inline rt_atomic_t rt_atomic_fetch_add_unless(volatile rt_atomic_t *ptr, rt_atomic_t a, rt_atomic_t u)
Xstatic __inline rt_atomic_t rt_atomic_fetch_add_unless(volatile rt_atomic_t *ptr, rt_atomic_t a, rt_atomic_t u)
N{
N    rt_atomic_t c = rt_atomic_load(ptr);
X    rt_atomic_t c = rt_soft_atomic_load(ptr);
N
N    do {
N        if (c == u)
N        {
N            break;
N        }
N    } while (!rt_atomic_compare_exchange_strong(ptr, &c, c + a));
X    } while (!rt_soft_atomic_compare_exchange_strong(ptr, &c ,c + a));
N
N    return c;
N}
N
Nrt_inline rt_bool_t rt_atomic_add_unless(volatile rt_atomic_t *ptr, rt_atomic_t a, rt_atomic_t u)
Xstatic __inline rt_bool_t rt_atomic_add_unless(volatile rt_atomic_t *ptr, rt_atomic_t a, rt_atomic_t u)
N{
N    return rt_atomic_fetch_add_unless(ptr, a, u) != u;
N}
N
Nrt_inline rt_bool_t rt_atomic_inc_not_zero(volatile rt_atomic_t *ptr)
Xstatic __inline rt_bool_t rt_atomic_inc_not_zero(volatile rt_atomic_t *ptr)
N{
N    return rt_atomic_add_unless(ptr, 1, 0);
N}
N
N/**
N * @brief initialize a lock-less single list
N *
N * @param l the single list to be initialized
N */
Nrt_inline void rt_ll_slist_init(rt_ll_slist_t *l)
Xstatic __inline void rt_ll_slist_init(rt_ll_slist_t *l)
N{
N    l->next = 0;
N}
N
Nrt_inline void rt_ll_slist_enqueue(rt_ll_slist_t *l, rt_ll_slist_t *n)
Xstatic __inline void rt_ll_slist_enqueue(rt_ll_slist_t *l, rt_ll_slist_t *n)
N{
N    rt_base_t exp;
N    exp = rt_atomic_load(&l->next);
X    exp = rt_soft_atomic_load(&l->next);
N    do
N    {
N        n->next = exp;
N    } while (!rt_atomic_compare_exchange_strong(&l->next, &exp, (rt_base_t)n));
X    } while (!rt_soft_atomic_compare_exchange_strong(&l->next, &exp ,(rt_base_t)n));
N}
N
Nrt_inline rt_ll_slist_t *rt_ll_slist_dequeue(rt_ll_slist_t *l)
Xstatic __inline rt_ll_slist_t *rt_ll_slist_dequeue(rt_ll_slist_t *l)
N{
N    rt_base_t exp;
N    rt_ll_slist_t *head;
N
N    exp = rt_atomic_load(&l->next);
X    exp = rt_soft_atomic_load(&l->next);
N    do
N    {
N        head = (rt_ll_slist_t *)exp;
N    } while (head && !rt_atomic_compare_exchange_strong(&l->next, &exp, rt_atomic_load(&head->next)));
X    } while (head && !rt_soft_atomic_compare_exchange_strong(&l->next, &exp ,rt_soft_atomic_load(&head->next)));
N    return head;
N}
