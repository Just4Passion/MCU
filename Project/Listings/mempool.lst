N
N/**
N * @addtogroup group_thread_management
N */
N
N/**@{*/
N
N/*
N * Thread
N */
N
N/*
N * thread state definitions
N */
N#define RT_THREAD_INIT                       0x00                /**< Initialized status */
N#define RT_THREAD_CLOSE                      0x01                /**< Closed status */
N#define RT_THREAD_READY                      0x02                /**< Ready status */
N#define RT_THREAD_RUNNING                    0x03                /**< Running status */
N
N/*
N * for rt_thread_suspend_with_flag()
N */
Nenum
N{
N    RT_INTERRUPTIBLE = 0,
N    RT_KILLABLE,
N    RT_UNINTERRUPTIBLE,
N};
N
N#define RT_THREAD_SUSPEND_MASK               0x04
N#define RT_SIGNAL_COMMON_WAKEUP_MASK         0x02
N#define RT_SIGNAL_KILL_WAKEUP_MASK           0x01
N
N#define RT_THREAD_SUSPEND_INTERRUPTIBLE      (RT_THREAD_SUSPEND_MASK)                                                             /**< Suspend interruptable 0x4 */
N#define RT_THREAD_SUSPEND                    RT_THREAD_SUSPEND_INTERRUPTIBLE
N#define RT_THREAD_SUSPEND_KILLABLE           (RT_THREAD_SUSPEND_MASK | RT_SIGNAL_COMMON_WAKEUP_MASK)                              /**< Suspend with killable 0x6 */
N#define RT_THREAD_SUSPEND_UNINTERRUPTIBLE    (RT_THREAD_SUSPEND_MASK | RT_SIGNAL_COMMON_WAKEUP_MASK | RT_SIGNAL_KILL_WAKEUP_MASK) /**< Suspend with uninterruptable 0x7 */
N#define RT_THREAD_STAT_MASK                  0x07
N
N#define RT_THREAD_STAT_YIELD            0x08                /**< indicate whether remaining_tick has been reloaded since last schedule */
N#define RT_THREAD_STAT_YIELD_MASK       RT_THREAD_STAT_YIELD
N
N#define RT_THREAD_STAT_SIGNAL           0x10                /**< task hold signals */
N#define RT_THREAD_STAT_SIGNAL_READY     (RT_THREAD_STAT_SIGNAL | RT_THREAD_READY)
N#define RT_THREAD_STAT_SIGNAL_WAIT      0x20                /**< task is waiting for signals */
N#define RT_THREAD_STAT_SIGNAL_PENDING   0x40                /**< signals is held and it has not been procressed */
N#define RT_THREAD_STAT_SIGNAL_MASK      0xf0
N
N/**
N * thread control command definitions
N */
N#define RT_THREAD_CTRL_STARTUP          0x00                /**< Startup thread. */
N#define RT_THREAD_CTRL_CLOSE            0x01                /**< Close thread. */
N#define RT_THREAD_CTRL_CHANGE_PRIORITY  0x02                /**< Change thread priority. */
N#define RT_THREAD_CTRL_INFO             0x03                /**< Get thread information. */
N#define RT_THREAD_CTRL_BIND_CPU         0x04                /**< Set thread bind cpu. */
N#define RT_THREAD_CTRL_RESET_PRIORITY   0x05                /**< Reset thread priority. */
N
N/**
N * CPU usage statistics data
N */
Nstruct rt_cpu_usage_stats
N{
N    rt_ubase_t user;
N    rt_ubase_t system;
N    rt_ubase_t irq;
N    rt_ubase_t idle;
N};
Ntypedef struct rt_cpu_usage_stats *rt_cpu_usage_stats_t;
N
N#ifdef RT_USING_SMP
S
S#define RT_CPU_DETACHED                 RT_CPUS_NR          /**< The thread not running on cpu. */
S#define RT_CPU_MASK                     ((1 << RT_CPUS_NR) - 1) /**< All CPUs mask bit. */
S
S#ifndef RT_SCHEDULE_IPI
S#define RT_SCHEDULE_IPI                 0
S#endif /* RT_SCHEDULE_IPI */
S
S#ifndef RT_STOP_IPI
S#define RT_STOP_IPI                     1
S#endif /* RT_STOP_IPI */
S
S#ifndef RT_SMP_CALL_IPI
S#define RT_SMP_CALL_IPI                 2
S#endif
S
S#define RT_MAX_IPI                      3
S
S#define _SCHEDULER_CONTEXT(fileds) fileds
S
S/**
S * CPUs definitions
S *
S */
Sstruct rt_cpu
S{
S    /**
S     * protected by:
S     *   - other cores: accessing from other coress is undefined behaviour
S     *   - local core: rt_enter_critical()/rt_exit_critical()
S     */
S    _SCHEDULER_CONTEXT(
S        struct rt_thread        *current_thread;
S
S        rt_uint8_t              irq_switch_flag:1;
S        rt_uint8_t              sched_lock_flag:1;
S#ifndef ARCH_USING_HW_THREAD_SELF
S        rt_uint8_t              critical_switch_flag:1;
S#endif /* ARCH_USING_HW_THREAD_SELF */
S
S        rt_uint8_t              current_priority;
S        rt_list_t               priority_table[RT_THREAD_PRIORITY_MAX];
S    #if RT_THREAD_PRIORITY_MAX > 32
S        rt_uint32_t             priority_group;
S        rt_uint8_t              ready_table[32];
S    #else
S        rt_uint32_t             priority_group;
S    #endif /* RT_THREAD_PRIORITY_MAX > 32 */
S
S        rt_atomic_t             tick;   /**< Passing tickes on this core */
S    );
S
S    struct rt_thread            *idle_thread;
S    rt_atomic_t                 irq_nest;
S
S#ifdef RT_USING_SMART
S    struct rt_spinlock          spinlock;
S#endif /* RT_USING_SMART */
S#ifdef RT_USING_CPU_USAGE_TRACER
S    struct rt_cpu_usage_stats   cpu_stat;
S#endif /* RT_USING_CPU_USAGE_TRACER */
S#ifdef ARCH_USING_IRQ_CTX_LIST
S    rt_slist_t                  irq_ctx_head;
S#endif /* ARCH_USING_IRQ_CTX_LIST */
S};
S
N#else /* !RT_USING_SMP */
Nstruct rt_cpu
N{
N    struct rt_thread            *current_thread;
N    struct rt_thread            *idle_thread;
N
N#ifdef RT_USING_CPU_USAGE_TRACER
S    struct rt_cpu_usage_stats   cpu_stat;
N#endif /* RT_USING_CPU_USAGE_TRACER */
N#ifdef ARCH_USING_IRQ_CTX_LIST
S    rt_slist_t                  irq_ctx_head;
N#endif /* ARCH_USING_IRQ_CTX_LIST */
N};
N
N#endif /* RT_USING_SMP */
N
