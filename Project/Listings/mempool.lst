Svoid rt_show_version(void);
S
S#ifdef RT_DEBUGING_ASSERT
Sextern void (*rt_assert_hook)(const char *ex, const char *func, rt_size_t line);
Svoid rt_assert_set_hook(void (*hook)(const char *ex, const char *func, rt_size_t line));
Svoid rt_assert_handler(const char *ex, const char *func, rt_size_t line);
S
S#define RT_ASSERT(EX)                                                         \
Sif (!(EX))                                                                    \
S{                                                                             \
S    rt_assert_handler(#EX, __FUNCTION__, __LINE__);                           \
S}
X#define RT_ASSERT(EX)                                                         if (!(EX))                                                                    {                                                                                 rt_assert_handler(#EX, __FUNCTION__, __LINE__);                           }
S#else
S#define RT_ASSERT(EX) {RT_UNUSED(EX);}
S#endif /* RT_DEBUGING_ASSERT */
S
S#ifdef RT_DEBUGING_CONTEXT
S/* Macro to check current context */
S#define RT_DEBUG_NOT_IN_INTERRUPT                                             \
Sdo                                                                            \
S{                                                                             \
S    if (rt_interrupt_get_nest() != 0)                                         \
S    {                                                                         \
S        rt_kprintf("Function[%s] shall not be used in ISR\n", __FUNCTION__);  \
S        RT_ASSERT(0)                                                          \
S    }                                                                         \
S}                                                                             \
Swhile (0)
X#define RT_DEBUG_NOT_IN_INTERRUPT                                             do                                                                            {                                                                                 if (rt_interrupt_get_nest() != 0)                                             {                                                                                 rt_kprintf("Function[%s] shall not be used in ISR\n", __FUNCTION__);          RT_ASSERT(0)                                                              }                                                                         }                                                                             while (0)
S
S/* "In thread context" means:
S *     1) the scheduler has been started
S *     2) not in interrupt context.
S */
S#define RT_DEBUG_IN_THREAD_CONTEXT                                            \
Sdo                                                                            \
S{                                                                             \
S    if (rt_thread_self() == RT_NULL)                                          \
S    {                                                                         \
S        rt_kprintf("Function[%s] shall not be used before scheduler start\n", \
S                   __FUNCTION__);                                             \
S        RT_ASSERT(0)                                                          \
S    }                                                                         \
S    RT_DEBUG_NOT_IN_INTERRUPT;                                                \
S}                                                                             \
Swhile (0)
X#define RT_DEBUG_IN_THREAD_CONTEXT                                            do                                                                            {                                                                                 if (rt_thread_self() == RT_NULL)                                              {                                                                                 rt_kprintf("Function[%s] shall not be used before scheduler start\n",                    __FUNCTION__);                                                     RT_ASSERT(0)                                                              }                                                                             RT_DEBUG_NOT_IN_INTERRUPT;                                                }                                                                             while (0)
S
S/* "scheduler available" means:
S *     1) the scheduler has been started.
S *     2) not in interrupt context.
S *     3) scheduler is not locked.
S */
S#define RT_DEBUG_SCHEDULER_AVAILABLE(need_check)                              \
Sdo                                                                            \
S{                                                                             \
S    if (need_check)                                                           \
S    {                                                                         \
S        if (rt_critical_level() != 0)                                         \
S        {                                                                     \
S            rt_kprintf("Function[%s]: scheduler is not available\n",          \
S                    __FUNCTION__);                                            \
S            RT_ASSERT(0)                                                      \
S        }                                                                     \
S        RT_DEBUG_IN_THREAD_CONTEXT;                                           \
S    }                                                                         \
S}                                                                             \
Swhile (0)
X#define RT_DEBUG_SCHEDULER_AVAILABLE(need_check)                              do                                                                            {                                                                                 if (need_check)                                                               {                                                                                 if (rt_critical_level() != 0)                                                 {                                                                                 rt_kprintf("Function[%s]: scheduler is not available\n",                              __FUNCTION__);                                                        RT_ASSERT(0)                                                              }                                                                             RT_DEBUG_IN_THREAD_CONTEXT;                                               }                                                                         }                                                                             while (0)
S#else
S#define RT_DEBUG_NOT_IN_INTERRUPT
S#define RT_DEBUG_IN_THREAD_CONTEXT
S#define RT_DEBUG_SCHEDULER_AVAILABLE(need_check)
S#endif /* RT_DEBUGING_CONTEXT */
S
Srt_inline rt_bool_t rt_in_thread_context(void)
S{
S    return rt_thread_self() != RT_NULL && rt_interrupt_get_nest() == 0;
S}
S
S/* is scheduler available */
Srt_inline rt_bool_t rt_scheduler_is_available(void)
S{
S    return rt_critical_level() == 0 && rt_in_thread_context();
S}
S
S#ifdef RT_USING_SMP
S/* is thread bond on core */
Srt_inline rt_bool_t rt_sched_thread_is_binding(rt_thread_t thread)
S{
S    if (thread == RT_NULL)
S    {
S        thread = rt_thread_self();
S    }
S    return !thread || RT_SCHED_CTX(thread).bind_cpu != RT_CPUS_NR;
S}
S
S#else
S#define rt_sched_thread_is_binding(thread) (RT_TRUE)
S#endif
S
S/**@}*/
S
S#ifdef __cplusplus
S}
S#endif
S
