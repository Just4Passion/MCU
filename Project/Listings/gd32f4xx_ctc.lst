N/* function declarations */
N/* initialization functions */
N/* NOR/SRAM */
N/* deinitialize EXMC NOR/SRAM region */
Nvoid exmc_norsram_deinit(uint32_t exmc_norsram_region);
N/* initialize exmc_norsram_parameter_struct with the default values */
Nvoid exmc_norsram_struct_para_init(exmc_norsram_parameter_struct* exmc_norsram_init_struct);
N/* initialize EXMC NOR/SRAM region */
Nvoid exmc_norsram_init(exmc_norsram_parameter_struct* exmc_norsram_init_struct);
N/* enable EXMC NOR/SRAM region */
Nvoid exmc_norsram_enable(uint32_t exmc_norsram_region);
N/* disable EXMC NOR/SRAM region */
Nvoid exmc_norsram_disable(uint32_t exmc_norsram_region);
N/* NAND */
N/* deinitialize EXMC NAND bank */
Nvoid exmc_nand_deinit(uint32_t exmc_nand_bank);
N/* initialize exmc_norsram_parameter_struct with the default values */
Nvoid exmc_nand_struct_para_init(exmc_nand_parameter_struct* exmc_nand_init_struct);
N/* initialize EXMC NAND bank */
Nvoid exmc_nand_init(exmc_nand_parameter_struct* exmc_nand_init_struct);
N/* enable EXMC NAND bank */
Nvoid exmc_nand_enable(uint32_t exmc_nand_bank);
N/* disable EXMC NAND bank */
Nvoid exmc_nand_disable(uint32_t exmc_nand_bank);
N/* PC card */
N/* deinitialize EXMC PC card bank */
Nvoid exmc_pccard_deinit(void);
N/* initialize exmc_pccard_parameter_struct with the default values */
Nvoid exmc_pccard_struct_para_init(exmc_pccard_parameter_struct* exmc_pccard_init_struct);
N/* initialize EXMC PC card bank */
Nvoid exmc_pccard_init(exmc_pccard_parameter_struct* exmc_pccard_init_struct);
N/* enable EXMC PC card bank */
Nvoid exmc_pccard_enable(void);
N/* disable EXMC PC card bank */
Nvoid exmc_pccard_disable(void);
N/* SDRAM */
N/* deinitialize EXMC SDRAM device */
Nvoid exmc_sdram_deinit(uint32_t exmc_sdram_device);
N/* initialize exmc_sdram_parameter_struct with the default values */
Nvoid exmc_sdram_struct_para_init(exmc_sdram_parameter_struct* exmc_sdram_init_struct);
N/* initialize EXMC SDRAM device */
Nvoid exmc_sdram_init(exmc_sdram_parameter_struct* exmc_sdram_init_struct);
N/* SQPIPSRAM */
N/* deinitialize EXMC SQPIPSRAM */
Nvoid exmc_sqpipsram_deinit(void);
N/* initialize exmc_sqpipsram_parameter_struct with the default values */
Nvoid exmc_sqpipsram_struct_para_init(exmc_sqpipsram_parameter_struct* exmc_sqpipsram_init_struct);
N/* initialize EXMC SQPIPSRAM */
Nvoid exmc_sqpipsram_init(exmc_sqpipsram_parameter_struct* exmc_sqpipsram_init_struct);
N
N/* function configuration */
N/* NOR/SRAM */
N/* configure consecutive clock */
Nvoid exmc_norsram_consecutive_clock_config(uint32_t clock_mode);
N/* configure CRAM page size */
Nvoid exmc_norsram_page_size_config(uint32_t exmc_norsram_region, uint32_t page_size);
N/* NAND */
N/* enable or disable the EXMC NAND ECC function */
Nvoid exmc_nand_ecc_config(uint32_t exmc_nand_bank, ControlStatus newvalue);
N/* get the EXMC ECC value */
Nuint32_t exmc_ecc_get(uint32_t exmc_nand_bank);
N/* SDRAM */
N/* enable or disable read sample */
Nvoid exmc_sdram_readsample_enable(ControlStatus newvalue);
N/* configure the delayed sample clock of read data */
Nvoid exmc_sdram_readsample_config(uint32_t delay_cell, uint32_t extra_hclk);
N/* configure the SDRAM memory command */
Nvoid exmc_sdram_command_config(exmc_sdram_command_parameter_struct* exmc_sdram_command_init_struct);
N/* set auto-refresh interval */
Nvoid exmc_sdram_refresh_count_set(uint32_t exmc_count);
N/* set the number of successive auto-refresh command */
Nvoid exmc_sdram_autorefresh_number_set(uint32_t exmc_number);
N/* config the write protection function */
Nvoid exmc_sdram_write_protection_config(uint32_t exmc_sdram_device, ControlStatus newvalue);
N/* get the status of SDRAM device0 or device1 */
Nuint32_t exmc_sdram_bankstatus_get(uint32_t exmc_sdram_device);
N/* SQPIPSRAM */
N/* set the read command */
Nvoid exmc_sqpipsram_read_command_set(uint32_t read_command_mode,uint32_t read_wait_cycle,uint32_t read_command_code);
N/* set the write command */
Nvoid exmc_sqpipsram_write_command_set(uint32_t write_command_mode,uint32_t write_wait_cycle,uint32_t write_command_code);
N/* send SPI read ID command */
Nvoid exmc_sqpipsram_read_id_command_send(void);
N/* send SPI special command which does not have address and data phase */
Nvoid exmc_sqpipsram_write_cmd_send(void);
N/* get the EXMC SPI ID low data */
Nuint32_t exmc_sqpipsram_low_id_get(void);
N/* get the EXMC SPI ID high data */
Nuint32_t exmc_sqpipsram_high_id_get(void);
N/* get the bit value of EXMC send write command bit or read ID command */
NFlagStatus exmc_sqpipsram_send_command_state_get(uint32_t send_command_flag);
N
N/* interrupt & flag functions */
N/* enable EXMC interrupt */
Nvoid exmc_interrupt_enable(uint32_t exmc_bank,uint32_t interrupt);
N/* disable EXMC interrupt */
Nvoid exmc_interrupt_disable(uint32_t exmc_bank,uint32_t interrupt);
N/* get EXMC flag status */
NFlagStatus exmc_flag_get(uint32_t exmc_bank,uint32_t flag);
N/* clear EXMC flag status */
Nvoid exmc_flag_clear(uint32_t exmc_bank,uint32_t flag);
N/* get EXMC interrupt flag */
NFlagStatus exmc_interrupt_flag_get(uint32_t exmc_bank,uint32_t interrupt);
N/* clear EXMC interrupt flag */
Nvoid exmc_interrupt_flag_clear(uint32_t exmc_bank,uint32_t interrupt);
