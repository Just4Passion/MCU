S        };
S        #define INIT_EXPORT(fn, level)                                                       \
S            const char __rti_##fn##_name[] = #fn;                                            \
S            rt_used const struct rt_init_desc __rt_init_desc_##fn rt_section(".rti_fn." level) = \
S            { __rti_##fn##_name, fn};
X        #define INIT_EXPORT(fn, level)                                                                   const char __rti_##fn##_name[] = #fn;                                                        rt_used const struct rt_init_desc __rt_init_desc_##fn rt_section(".rti_fn." level) =             { __rti_##fn##_name, fn};
S    #else
S        #define INIT_EXPORT(fn, level)                                                       \
S            rt_used const init_fn_t __rt_init_##fn rt_section(".rti_fn." level) = fn
X        #define INIT_EXPORT(fn, level)                                                                   rt_used const init_fn_t __rt_init_##fn rt_section(".rti_fn." level) = fn
S    #endif /* RT_DEBUGING_AUTO_INIT */
S#endif /* _MSC_VER */
N#else
N#define INIT_EXPORT(fn, level)
N#endif /* RT_USING_COMPONENTS_INIT */
N
N/* board init routines will be called in board_init() function */
N#define INIT_BOARD_EXPORT(fn)           INIT_EXPORT(fn, "1")
N
N/* init cpu, memory, interrupt-controller, bus... */
N#define INIT_CORE_EXPORT(fn)            INIT_EXPORT(fn, "1.0")
N/* init sys-timer, clk, pinctrl... */
N#define INIT_SUBSYS_EXPORT(fn)          INIT_EXPORT(fn, "1.1")
N/* init platform, user code... */
N#define INIT_PLATFORM_EXPORT(fn)        INIT_EXPORT(fn, "1.2")
N
N/* pre/device/component/env/app init routines will be called in init_thread */
N/* components pre-initialization (pure software initialization) */
N#define INIT_PREV_EXPORT(fn)            INIT_EXPORT(fn, "2")
N/* device initialization */
N#define INIT_DEVICE_EXPORT(fn)          INIT_EXPORT(fn, "3")
N/* components initialization (dfs, lwip, ...) */
N#define INIT_COMPONENT_EXPORT(fn)       INIT_EXPORT(fn, "4")
N/* environment initialization (mount disk, ...) */
N#define INIT_ENV_EXPORT(fn)             INIT_EXPORT(fn, "5")
N/* application initialization (rtgui application etc ...) */
N#define INIT_APP_EXPORT(fn)             INIT_EXPORT(fn, "6")
N
N/* init after mount fs */
N#define INIT_FS_EXPORT(fn)              INIT_EXPORT(fn, "6.0")
N/* init in secondary_cpu_c_start */
N#define INIT_SECONDARY_CPU_EXPORT(fn)   INIT_EXPORT(fn, "7")
N
N#if !defined(RT_USING_FINSH)
X#if !0L
N/* define these to empty, even if not include finsh.h file */
N#define FINSH_FUNCTION_EXPORT(name, desc)
N#define FINSH_FUNCTION_EXPORT_ALIAS(name, alias, desc)
N
N#define MSH_CMD_EXPORT(command, desc)
N#define MSH_CMD_EXPORT_ALIAS(command, alias, desc)
N#elif !defined(FINSH_USING_SYMTAB)
S#define FINSH_FUNCTION_EXPORT_CMD(name, cmd, desc)
N#endif
N
N/* event length */
N#define RT_EVENT_LENGTH                 32
N
N/* memory management option */
N#define RT_MM_PAGE_SIZE                 4096
N#define RT_MM_PAGE_MASK                 (RT_MM_PAGE_SIZE - 1)
N#define RT_MM_PAGE_BITS                 12
N
N/* kernel malloc definitions */
N#ifndef RT_KERNEL_MALLOC
N#define RT_KERNEL_MALLOC(sz)            rt_malloc(sz)
N#endif /* RT_KERNEL_MALLOC */
N
N#ifndef RT_KERNEL_FREE
N#define RT_KERNEL_FREE(ptr)             rt_free(ptr)
N#endif /* RT_KERNEL_FREE */
N
N#ifndef RT_KERNEL_REALLOC
N#define RT_KERNEL_REALLOC(ptr, size)    rt_realloc(ptr, size)
N#endif /* RT_KERNEL_REALLOC */
N
N/**
N * @ingroup group_basic_definition
N *
N * @def RT_IS_ALIGN(addr, align)
N * Return true(1) or false(0).
N *     RT_IS_ALIGN(128, 4) is judging whether 128 aligns with 4.
N *     The result is 1, which means 128 aligns with 4.
N * @note If the address is NULL, false(0) will be returned
N */
N#define RT_IS_ALIGN(addr, align) ((!(addr & (align - 1))) && (addr != RT_NULL))
N
N/**
N * @ingroup group_basic_definition
N *
N * @def RT_ALIGN(size, align)
N * Return the most contiguous size aligned at specified width. RT_ALIGN(13, 4)
N * would return 16.
N * @note align Must be an integer power of 2 or the result will be incorrect
N */
N#define RT_ALIGN(size, align)           (((size) + (align) - 1) & ~((align) - 1))
N
N/**
N * @ingroup group_basic_definition
N *
N * @def RT_ALIGN_DOWN(size, align)
N * Return the down number of aligned at specified width. RT_ALIGN_DOWN(13, 4)
N * would return 12.
N * @note align Must be an integer power of 2 or the result will be incorrect
N */
N#define RT_ALIGN_DOWN(size, align)      ((size) & ~((align) - 1))
N
N/**
N * @addtogroup group_object_management
N */
N
N/**@{*/
N
N/*
N * kernel object macros
N */
N#define RT_OBJECT_FLAG_MODULE           0x80            /**< is module object. */
N
N/**
N * Base structure of Kernel object
N */
Nstruct rt_object
N{
N#if RT_NAME_MAX > 0
X#if 8 > 0
N    char        name[RT_NAME_MAX];                       /**< dynamic name of kernel object */
X    char        name[8];                        
N#else
S    const char *name;                                    /**< static name of kernel object */
N#endif /* RT_NAME_MAX > 0 */
N    rt_uint8_t  type;                                    /**< type of kernel object */
N    rt_uint8_t  flag;                                    /**< flag of kernel object */
N
N#ifdef RT_USING_MODULE
S    void      * module_id;                               /**< id of application module */
N#endif /* RT_USING_MODULE */
N
N#ifdef RT_USING_SMART
S    rt_atomic_t lwp_ref_count;                           /**< ref count for lwp */
N#endif /* RT_USING_SMART */
N
N    rt_list_t   list;                                    /**< list node of kernel object */
N};
Ntypedef struct rt_object *rt_object_t;                   /**< Type for kernel objects. */
N
N/**
N * iterator of rt_object_for_each()
N *
N * data is the data passing in to rt_object_for_each(). iterator can return
N * RT_EOK to continue the iteration; or any positive value to break the loop
N * successfully; or any negative errno to break the loop on failure.
N */
Ntypedef rt_err_t (*rt_object_iter_t)(rt_object_t object, void *data);
N
N/**
N *  The object type can be one of the follows with specific
N *  macros enabled:
N *  - Thread
N *  - Semaphore
N *  - Mutex
N *  - Event
N *  - MailBox
N *  - MessageQueue
N *  - MemHeap
N *  - MemPool
N *  - Device
N *  - Timer
N *  - Module
N *  - Unknown
N *  - Static
N */
Nenum rt_object_class_type
N{
N    RT_Object_Class_Null          = 0x00,      /**< The object is not used. */
N    RT_Object_Class_Thread        = 0x01,      /**< The object is a thread. */
N    RT_Object_Class_Semaphore     = 0x02,      /**< The object is a semaphore. */
N    RT_Object_Class_Mutex         = 0x03,      /**< The object is a mutex. */
N    RT_Object_Class_Event         = 0x04,      /**< The object is a event. */
N    RT_Object_Class_MailBox       = 0x05,      /**< The object is a mail box. */
N    RT_Object_Class_MessageQueue  = 0x06,      /**< The object is a message queue. */
N    RT_Object_Class_MemHeap       = 0x07,      /**< The object is a memory heap. */
N    RT_Object_Class_MemPool       = 0x08,      /**< The object is a memory pool. */
N    RT_Object_Class_Device        = 0x09,      /**< The object is a device. */
N    RT_Object_Class_Timer         = 0x0a,      /**< The object is a timer. */
N    RT_Object_Class_Module        = 0x0b,      /**< The object is a module. */
N    RT_Object_Class_Memory        = 0x0c,      /**< The object is a memory. */
N    RT_Object_Class_Channel       = 0x0d,      /**< The object is a channel */
N    RT_Object_Class_ProcessGroup  = 0x0e,      /**< The object is a process group */
N    RT_Object_Class_Session       = 0x0f,      /**< The object is a session */
N    RT_Object_Class_Custom        = 0x10,      /**< The object is a custom object */
N    RT_Object_Class_Unknown       = 0x11,      /**< The object is unknown. */
N    RT_Object_Class_Static        = 0x80       /**< The object is a static object. */
N};
N
N/**
N * The information of the kernel object
N */
Nstruct rt_object_information
N{
N    enum rt_object_class_type type;                     /**< object class type */
N    rt_list_t                 object_list;              /**< object list */
N    rt_size_t                 object_size;              /**< object size */
N    struct rt_spinlock        spinlock;
N};
N
N/**
N * The hook function call macro
N */
N#ifndef RT_USING_HOOK
N#define RT_OBJECT_HOOK_CALL(func, argv)
N
N#else
S
S/**
S * @brief Add hook point in the routines
S * @note Usage:
S * void foo() {
S *     do_something();
S *
S *     RT_OBJECT_HOOK_CALL(foo);
S *
S *     do_other_things();
S * }
S */
S#define _RT_OBJECT_HOOK_CALL(func, argv) __ON_HOOK_ARGS(func, argv)
S#define RT_OBJECT_HOOK_CALL(func, argv)  _RT_OBJECT_HOOK_CALL(func, argv)
S
S    #ifdef RT_HOOK_USING_FUNC_PTR
S        #define __ON_HOOK_ARGS(__hook, argv)        do {if ((__hook) != RT_NULL) __hook argv; } while (0)
S    #else
S        #define __ON_HOOK_ARGS(__hook, argv)
S    #endif /* RT_HOOK_USING_FUNC_PTR */
N#endif /* RT_USING_HOOK */
N
N#ifdef RT_USING_HOOKLIST
S
S/**
S * @brief Add declaration for hook list types.
S *
S * @note Usage:
S * This is typically used in your header. In foo.h using this like:
S *
S * ```foo.h
S *     typedef void (*bar_hook_proto_t)(arguments...);
S *     RT_OBJECT_HOOKLIST_DECLARE(bar_hook_proto_t, bar_myhook);
S * ```
S */
S#define RT_OBJECT_HOOKLIST_DECLARE(handler_type, name) \
S    typedef struct name##_hooklistnode                 \
S    {                                                  \
S        handler_type handler;                          \
S        rt_list_t list_node;                           \
S    } *name##_hooklistnode_t;                          \
S    extern volatile rt_ubase_t name##_nested;          \
S    void name##_sethook(name##_hooklistnode_t node);   \
S    void name##_rmhook(name##_hooklistnode_t node)
X#define RT_OBJECT_HOOKLIST_DECLARE(handler_type, name)     typedef struct name##_hooklistnode                     {                                                          handler_type handler;                                  rt_list_t list_node;                               } *name##_hooklistnode_t;                              extern volatile rt_ubase_t name##_nested;              void name##_sethook(name##_hooklistnode_t node);       void name##_rmhook(name##_hooklistnode_t node)
S
S/**
S * @brief Add declaration for hook list node.
S *
S * @note Usage
S * You can add a hook like this.
S *
S * ```addhook.c
S * void myhook(arguments...) { do_something(); }
S * RT_OBJECT_HOOKLIST_DEFINE_NODE(bar_myhook, myhook_node, myhook);
S *
S * void addhook(void)
S * {
S *      bar_myhook_sethook(myhook);
S * }
S * ```
S *
S * BTW, you can also find examples codes under
S * `examples/utest/testcases/kernel/hooklist_tc.c`.
S */
S#define RT_OBJECT_HOOKLIST_DEFINE_NODE(hookname, nodename, hooker_handler) \
S    struct hookname##_hooklistnode nodename = {                            \
S        .handler = hooker_handler,                                         \
S        .list_node = RT_LIST_OBJECT_INIT(nodename.list_node),              \
S    };
X#define RT_OBJECT_HOOKLIST_DEFINE_NODE(hookname, nodename, hooker_handler)     struct hookname##_hooklistnode nodename = {                                    .handler = hooker_handler,                                                 .list_node = RT_LIST_OBJECT_INIT(nodename.list_node),                  };
S
S/**
S * @note Usage
S * Add this macro to the source file where your hook point is inserted.
S */
S#define RT_OBJECT_HOOKLIST_DEFINE(name)                                      \
S    static rt_list_t name##_hooklist = RT_LIST_OBJECT_INIT(name##_hooklist); \
S    static struct rt_spinlock name##lock = RT_SPINLOCK_INIT;                 \
S    volatile rt_ubase_t name##_nested = 0;                                   \
S    void name##_sethook(name##_hooklistnode_t node)                          \
S    {                                                                        \
S        rt_ubase_t level = rt_spin_lock_irqsave(&name##lock);                \
S        while (name##_nested)                                                \
S        {                                                                    \
S            rt_spin_unlock_irqrestore(&name##lock, level);                   \
S            level = rt_spin_lock_irqsave(&name##lock);                       \
S        }                                                                    \
S        rt_list_insert_before(&name##_hooklist, &node->list_node);           \
S        rt_spin_unlock_irqrestore(&name##lock, level);                       \
S    }                                                                        \
S    void name##_rmhook(name##_hooklistnode_t node)                           \
S    {                                                                        \
S        rt_ubase_t level = rt_spin_lock_irqsave(&name##lock);                \
S        while (name##_nested)                                                \
S        {                                                                    \
S            rt_spin_unlock_irqrestore(&name##lock, level);                   \
S            level = rt_spin_lock_irqsave(&name##lock);                       \
S        }                                                                    \
S        rt_list_remove(&node->list_node);                                    \
S        rt_spin_unlock_irqrestore(&name##lock, level);                       \
S    }
X#define RT_OBJECT_HOOKLIST_DEFINE(name)                                          static rt_list_t name##_hooklist = RT_LIST_OBJECT_INIT(name##_hooklist);     static struct rt_spinlock name##lock = RT_SPINLOCK_INIT;                     volatile rt_ubase_t name##_nested = 0;                                       void name##_sethook(name##_hooklistnode_t node)                              {                                                                                rt_ubase_t level = rt_spin_lock_irqsave(&name##lock);                        while (name##_nested)                                                        {                                                                                rt_spin_unlock_irqrestore(&name##lock, level);                               level = rt_spin_lock_irqsave(&name##lock);                               }                                                                            rt_list_insert_before(&name##_hooklist, &node->list_node);                   rt_spin_unlock_irqrestore(&name##lock, level);                           }                                                                            void name##_rmhook(name##_hooklistnode_t node)                               {                                                                                rt_ubase_t level = rt_spin_lock_irqsave(&name##lock);                        while (name##_nested)                                                        {                                                                                rt_spin_unlock_irqrestore(&name##lock, level);                               level = rt_spin_lock_irqsave(&name##lock);                               }                                                                            rt_list_remove(&node->list_node);                                            rt_spin_unlock_irqrestore(&name##lock, level);                           }
S
S/**
S * @brief Add hook list point in the routines. Multiple hookers in the list will
S *        be called one by one starting from head node.
S *
S * @note Usage:
S * void foo() {
S *     do_something();
S *
S *     RT_OBJECT_HOOKLIST_CALL(foo);
S *
S *     do_other_things();
S * }
S */
S#define _RT_OBJECT_HOOKLIST_CALL(nodetype, nested, list, lock, argv)  \
S    do                                                                \
S    {                                                                 \
S        nodetype iter, next;                                          \
S        rt_ubase_t level = rt_spin_lock_irqsave(&lock);               \
S        nested += 1;                                                  \
S        rt_spin_unlock_irqrestore(&lock, level);                      \
S        if (!rt_list_isempty(&list))                                  \
S        {                                                             \
S            rt_list_for_each_entry_safe(iter, next, &list, list_node) \
S            {                                                         \
S                iter->handler argv;                                   \
S            }                                                         \
S        }                                                             \
S        level = rt_spin_lock_irqsave(&lock);                          \
S        nested -= 1;                                                  \
S        rt_spin_unlock_irqrestore(&lock, level);                      \
S    } while (0)
X#define _RT_OBJECT_HOOKLIST_CALL(nodetype, nested, list, lock, argv)      do                                                                    {                                                                         nodetype iter, next;                                                  rt_ubase_t level = rt_spin_lock_irqsave(&lock);                       nested += 1;                                                          rt_spin_unlock_irqrestore(&lock, level);                              if (!rt_list_isempty(&list))                                          {                                                                         rt_list_for_each_entry_safe(iter, next, &list, list_node)             {                                                                         iter->handler argv;                                               }                                                                 }                                                                     level = rt_spin_lock_irqsave(&lock);                                  nested -= 1;                                                          rt_spin_unlock_irqrestore(&lock, level);                          } while (0)
S#define RT_OBJECT_HOOKLIST_CALL(name, argv)                        \
S    _RT_OBJECT_HOOKLIST_CALL(name##_hooklistnode_t, name##_nested, \
S                             name##_hooklist, name##lock, argv)
X#define RT_OBJECT_HOOKLIST_CALL(name, argv)                            _RT_OBJECT_HOOKLIST_CALL(name##_hooklistnode_t, name##_nested,                              name##_hooklist, name##lock, argv)
S
N#else
N
N#define RT_OBJECT_HOOKLIST_DECLARE(handler_type, name)
N#define RT_OBJECT_HOOKLIST_DEFINE_NODE(hookname, nodename, hooker_handler)
N#define RT_OBJECT_HOOKLIST_DEFINE(name)
N#define RT_OBJECT_HOOKLIST_CALL(name, argv)
N#endif /* RT_USING_HOOKLIST */
N
N/**@}*/
N
N/**
N * @addtogroup group_clock_management
N */
N
N/**@{*/
N
N/**
N * clock & timer macros
N */
N#define RT_TIMER_FLAG_DEACTIVATED       0x0             /**< timer is deactive */
N#define RT_TIMER_FLAG_ACTIVATED         0x1             /**< timer is active */
N#define RT_TIMER_FLAG_ONE_SHOT          0x0             /**< one shot timer */
N#define RT_TIMER_FLAG_PERIODIC          0x2             /**< periodic timer */
N
N#define RT_TIMER_FLAG_HARD_TIMER        0x0             /**< hard timer,the timer's callback function will be called in tick isr. */
N#define RT_TIMER_FLAG_SOFT_TIMER        0x4             /**< soft timer,the timer's callback function will be called in timer thread. */
N#define RT_TIMER_FLAG_THREAD_TIMER \
N    (0x8 | RT_TIMER_FLAG_HARD_TIMER)                    /**< thread timer that cooperates with scheduler directly */
X#define RT_TIMER_FLAG_THREAD_TIMER     (0x8 | RT_TIMER_FLAG_HARD_TIMER)                     
N
N#define RT_TIMER_CTRL_SET_TIME          0x0             /**< set timer control command */
N#define RT_TIMER_CTRL_GET_TIME          0x1             /**< get timer control command */
N#define RT_TIMER_CTRL_SET_ONESHOT       0x2             /**< change timer to one shot */
N#define RT_TIMER_CTRL_SET_PERIODIC      0x3             /**< change timer to periodic */
N#define RT_TIMER_CTRL_GET_STATE         0x4             /**< get timer run state active or deactive*/
N#define RT_TIMER_CTRL_GET_REMAIN_TIME   0x5             /**< get the remaining hang time */
N#define RT_TIMER_CTRL_GET_FUNC          0x6             /**< get timer timeout func  */
N#define RT_TIMER_CTRL_SET_FUNC          0x7             /**< set timer timeout func  */
N#define RT_TIMER_CTRL_GET_PARM          0x8             /**< get timer parameter  */
N#define RT_TIMER_CTRL_SET_PARM          0x9             /**< set timer parameter  */
N
N#ifndef RT_TIMER_SKIP_LIST_LEVEL
N#define RT_TIMER_SKIP_LIST_LEVEL          1
N#endif
N
N/* 1 or 3 */
N#ifndef RT_TIMER_SKIP_LIST_MASK
N#define RT_TIMER_SKIP_LIST_MASK         0x3             /**< Timer skips the list mask */
N#endif
N
N/**
N * timeout handler of rt_timer
N */
Ntypedef void (*rt_timer_func_t)(void *parameter);
N
N/**
N * timer structure
N */
Nstruct rt_timer
N{
N    struct rt_object parent;                            /**< inherit from rt_object */
N
N    rt_list_t        row[RT_TIMER_SKIP_LIST_LEVEL];
X    rt_list_t        row[1];
N
N    rt_timer_func_t  timeout_func;                      /**< timeout function */
N    void             *parameter;                        /**< timeout function's parameter */
N
N    rt_tick_t        init_tick;                         /**< timer timeout tick */
N    rt_tick_t        timeout_tick;                      /**< timeout tick */
N};
Ntypedef struct rt_timer *rt_timer_t;
N
N/**@}*/
N
