N#ifndef GD32F4XX_DBG_H
N#define GD32F4XX_DBG_H
N
N#include "gd32f4xx.h"
N
N/* DBG definitions */
N#define DBG                      DBG_BASE
N
N/* registers definitions */
N#define DBG_ID                   REG32(DBG + 0x00U)         /*!< DBG_ID code register */
N#define DBG_CTL0                 REG32(DBG + 0x04U)         /*!< DBG control register 0 */
N#define DBG_CTL1                 REG32(DBG + 0x08U)         /*!< DBG control register 1 */
N#define DBG_CTL2                 REG32(DBG + 0x0CU)         /*!< DBG control register 2 */
N
N/* bits definitions */
N/* DBG_ID */
N#define DBG_ID_ID_CODE           BITS(0,31)                 /*!< DBG ID code values */
N
N/* DBG_CTL0 */
N#define DBG_CTL0_SLP_HOLD        BIT(0)                     /*!< keep debugger connection during sleep mode */
N#define DBG_CTL0_DSLP_HOLD       BIT(1)                     /*!< keep debugger connection during deepsleep mode */
N#define DBG_CTL0_STB_HOLD        BIT(2)                     /*!< keep debugger connection during standby mode */
N#define DBG_CTL0_TRACE_IOEN      BIT(5)                     /*!< enable trace pin assignment */
N#define DBG_CTL0_TRACE_MODE      BITS(6,7)                  /*!< trace pin mode selection */
N
N/* DBG_CTL1 */
N#define DBG_CTL1_TIMER1_HOLD     BIT(0)                     /*!< hold TIMER1 counter when core is halted */
N#define DBG_CTL1_TIMER2_HOLD     BIT(1)                     /*!< hold TIMER2 counter when core is halted */
N#define DBG_CTL1_TIMER3_HOLD     BIT(2)                     /*!< hold TIMER3 counter when core is halted */
N#define DBG_CTL1_TIMER4_HOLD     BIT(3)                     /*!< hold TIMER4 counter when core is halted */
N#define DBG_CTL1_TIMER5_HOLD     BIT(4)                     /*!< hold TIMER5 counter when core is halted */
N#define DBG_CTL1_TIMER6_HOLD     BIT(5)                     /*!< hold TIMER6 counter when core is halted */
N#define DBG_CTL1_TIMER11_HOLD    BIT(6)                     /*!< hold TIMER11 counter when core is halted */
N#define DBG_CTL1_TIMER12_HOLD    BIT(7)                     /*!< hold TIMER12 counter when core is halted */
N#define DBG_CTL1_TIMER13_HOLD    BIT(8)                     /*!< hold TIMER13 counter when core is halted */
N#define DBG_CTL1_RTC_HOLD        BIT(10)                    /*!< hold RTC calendar and wakeup counter when core is halted */
N#define DBG_CTL1_WWDGT_HOLD      BIT(11)                    /*!< debug WWDGT kept when core is halted */
N#define DBG_CTL1_FWDGT_HOLD      BIT(12)                    /*!< debug FWDGT kept when core is halted */
N#define DBG_CTL1_I2C0_HOLD       BIT(21)                    /*!< hold I2C0 smbus when core is halted */
N#define DBG_CTL1_I2C1_HOLD       BIT(22)                    /*!< hold I2C1 smbus when core is halted */
N#define DBG_CTL1_I2C2_HOLD       BIT(23)                    /*!< hold I2C2 smbus when core is halted */
N#define DBG_CTL1_CAN0_HOLD       BIT(25)                    /*!< debug CAN0 kept when core is halted */
N#define DBG_CTL1_CAN1_HOLD       BIT(26)                    /*!< debug CAN1 kept when core is halted */
N
N/* DBG_CTL2 */
N#define DBG_CTL2_TIMER0_HOLD     BIT(0)                     /*!< hold TIMER0 counter when core is halted */
N#define DBG_CTL2_TIMER7_HOLD     BIT(1)                     /*!< hold TIMER7 counter when core is halted */
N#define DBG_CTL2_TIMER8_HOLD     BIT(16)                    /*!< hold TIMER8 counter when core is halted */
N#define DBG_CTL2_TIMER9_HOLD     BIT(17)                    /*!< hold TIMER9 counter when core is halted */
N#define DBG_CTL2_TIMER10_HOLD    BIT(18)                    /*!< hold TIMER10 counter when core is halted */
N
N/* constants definitions */
N#define DBG_LOW_POWER_SLEEP      DBG_CTL0_SLP_HOLD          /*!< keep debugger connection during sleep mode */
N#define DBG_LOW_POWER_DEEPSLEEP  DBG_CTL0_DSLP_HOLD         /*!< keep debugger connection during deepsleep mode */
N#define DBG_LOW_POWER_STANDBY    DBG_CTL0_STB_HOLD          /*!< keep debugger connection during standby mode */
N
N/* define the peripheral debug hold bit position and its register index offset */
N#define DBG_REGIDX_BIT(regidx, bitpos)      (((regidx) << 6) | (bitpos))
N#define DBG_REG_VAL(periph)                 (REG32(DBG + ((uint32_t)(periph) >> 6)))
N#define DBG_BIT_POS(val)                    ((uint32_t)(val) & 0x1FU)
N
N/* register index */
Nenum dbg_reg_idx
N{
N    DBG_IDX_CTL0  = 0x04U,
N    DBG_IDX_CTL1  = 0x08U,
N    DBG_IDX_CTL2  = 0x0CU
N};
N
Ntypedef enum
N{
N    DBG_TIMER1_HOLD            = DBG_REGIDX_BIT(DBG_IDX_CTL1, 0U),                    /*!< hold TIMER1 counter when core is halted */
X    DBG_TIMER1_HOLD            = (((DBG_IDX_CTL1) << 6) | (0U)),                     
N    DBG_TIMER2_HOLD            = DBG_REGIDX_BIT(DBG_IDX_CTL1, 1U),                    /*!< hold TIMER2 counter when core is halted */
X    DBG_TIMER2_HOLD            = (((DBG_IDX_CTL1) << 6) | (1U)),                     
N    DBG_TIMER3_HOLD            = DBG_REGIDX_BIT(DBG_IDX_CTL1, 2U),                    /*!< hold TIMER3 counter when core is halted */
X    DBG_TIMER3_HOLD            = (((DBG_IDX_CTL1) << 6) | (2U)),                     
N    DBG_TIMER4_HOLD            = DBG_REGIDX_BIT(DBG_IDX_CTL1, 3U),                    /*!< hold TIMER4 counter when core is halted */
X    DBG_TIMER4_HOLD            = (((DBG_IDX_CTL1) << 6) | (3U)),                     
N    DBG_TIMER5_HOLD            = DBG_REGIDX_BIT(DBG_IDX_CTL1, 4U),                    /*!< hold TIMER5 counter when core is halted */
X    DBG_TIMER5_HOLD            = (((DBG_IDX_CTL1) << 6) | (4U)),                     
N    DBG_TIMER6_HOLD            = DBG_REGIDX_BIT(DBG_IDX_CTL1, 5U),                    /*!< hold TIMER6 counter when core is halted */
X    DBG_TIMER6_HOLD            = (((DBG_IDX_CTL1) << 6) | (5U)),                     
N    DBG_TIMER11_HOLD           = DBG_REGIDX_BIT(DBG_IDX_CTL1, 6U),                    /*!< hold TIMER11 counter when core is halted */
X    DBG_TIMER11_HOLD           = (((DBG_IDX_CTL1) << 6) | (6U)),                     
N    DBG_TIMER12_HOLD           = DBG_REGIDX_BIT(DBG_IDX_CTL1, 7U),                    /*!< hold TIMER12 counter when core is halted */
X    DBG_TIMER12_HOLD           = (((DBG_IDX_CTL1) << 6) | (7U)),                     
N    DBG_TIMER13_HOLD           = DBG_REGIDX_BIT(DBG_IDX_CTL1, 8U),                    /*!< hold TIMER13 counter when core is halted */
X    DBG_TIMER13_HOLD           = (((DBG_IDX_CTL1) << 6) | (8U)),                     
N    DBG_RTC_HOLD               = DBG_REGIDX_BIT(DBG_IDX_CTL1, 10U),                   /*!< hold RTC calendar and wakeup counter when core is halted */
X    DBG_RTC_HOLD               = (((DBG_IDX_CTL1) << 6) | (10U)),                    
N    DBG_WWDGT_HOLD             = DBG_REGIDX_BIT(DBG_IDX_CTL1, 11U),                   /*!< debug WWDGT kept when core is halted */
X    DBG_WWDGT_HOLD             = (((DBG_IDX_CTL1) << 6) | (11U)),                    
N    DBG_FWDGT_HOLD             = DBG_REGIDX_BIT(DBG_IDX_CTL1, 12U),                   /*!< debug FWDGT kept when core is halted */
X    DBG_FWDGT_HOLD             = (((DBG_IDX_CTL1) << 6) | (12U)),                    
N    DBG_I2C0_HOLD              = DBG_REGIDX_BIT(DBG_IDX_CTL1, 21U),                   /*!< hold I2C0 smbus when core is halted */
X    DBG_I2C0_HOLD              = (((DBG_IDX_CTL1) << 6) | (21U)),                    
N    DBG_I2C1_HOLD              = DBG_REGIDX_BIT(DBG_IDX_CTL1, 22U),                   /*!< hold I2C1 smbus when core is halted */
X    DBG_I2C1_HOLD              = (((DBG_IDX_CTL1) << 6) | (22U)),                    
N    DBG_I2C2_HOLD              = DBG_REGIDX_BIT(DBG_IDX_CTL1, 23U),                   /*!< hold I2C2 smbus when core is halted */
X    DBG_I2C2_HOLD              = (((DBG_IDX_CTL1) << 6) | (23U)),                    
N    DBG_CAN0_HOLD              = DBG_REGIDX_BIT(DBG_IDX_CTL1, 25U),                   /*!< debug CAN0 kept when core is halted */
X    DBG_CAN0_HOLD              = (((DBG_IDX_CTL1) << 6) | (25U)),                    
N    DBG_CAN1_HOLD              = DBG_REGIDX_BIT(DBG_IDX_CTL1, 26U),                   /*!< debug CAN1 kept when core is halted */
X    DBG_CAN1_HOLD              = (((DBG_IDX_CTL1) << 6) | (26U)),                    
N    DBG_TIMER0_HOLD            = DBG_REGIDX_BIT(DBG_IDX_CTL2, 0U),        /*!< hold TIMER0 counter when core is halted */
X    DBG_TIMER0_HOLD            = (((DBG_IDX_CTL2) << 6) | (0U)),         
N    DBG_TIMER7_HOLD            = DBG_REGIDX_BIT(DBG_IDX_CTL2, 1U),        /*!< hold TIMER7 counter when core is halted */
X    DBG_TIMER7_HOLD            = (((DBG_IDX_CTL2) << 6) | (1U)),         
N    DBG_TIMER8_HOLD            = DBG_REGIDX_BIT(DBG_IDX_CTL2, 16U),       /*!< hold TIMER8 counter when core is halted */
X    DBG_TIMER8_HOLD            = (((DBG_IDX_CTL2) << 6) | (16U)),        
N    DBG_TIMER9_HOLD            = DBG_REGIDX_BIT(DBG_IDX_CTL2, 17U),       /*!< hold TIMER9 counter when core is halted */
X    DBG_TIMER9_HOLD            = (((DBG_IDX_CTL2) << 6) | (17U)),        
N    DBG_TIMER10_HOLD           = DBG_REGIDX_BIT(DBG_IDX_CTL2, 18U)       /*!< hold TIMER10 counter when core is halted */
X    DBG_TIMER10_HOLD           = (((DBG_IDX_CTL2) << 6) | (18U))        
N}dbg_periph_enum;
N
N#define CTL0_TRACE_MODE(regval)       (BITS(6,7)&((uint32_t)(regval)<<6))
N#define TRACE_MODE_ASYNC              CTL0_TRACE_MODE(0)    /*!< trace pin used for async mode */
N#define TRACE_MODE_SYNC_DATASIZE_1    CTL0_TRACE_MODE(1)    /*!< trace pin used for sync mode and data size is 1 */
N#define TRACE_MODE_SYNC_DATASIZE_2    CTL0_TRACE_MODE(2)    /*!< trace pin used for sync mode and data size is 2 */
N#define TRACE_MODE_SYNC_DATASIZE_4    CTL0_TRACE_MODE(3)    /*!< trace pin used for sync mode and data size is 4 */
N
N/* function declarations */
N/* deinitialize the DBG */
Nvoid dbg_deinit(void);
N/* read DBG_ID code register */
Nuint32_t dbg_id_get(void);
N
N/* enable low power behavior when the MCU is in debug mode */
Nvoid dbg_low_power_enable(uint32_t dbg_low_power);
N/* disable low power behavior when the MCU is in debug mode */
Nvoid dbg_low_power_disable(uint32_t dbg_low_power);
N
N/* enable peripheral behavior when the MCU is in debug mode */
Nvoid dbg_periph_enable(dbg_periph_enum dbg_periph);
N/* disable peripheral behavior when the MCU is in debug mode */
Nvoid dbg_periph_disable(dbg_periph_enum dbg_periph);
N
N/* enable trace pin assignment */
Nvoid dbg_trace_pin_enable(void);
N/* disable trace pin assignment */
Nvoid dbg_trace_pin_disable(void);
N/* set trace pin mode */
Nvoid dbg_trace_pin_mode_set(uint32_t trace_mode);
N
N#endif /* GD32F4XX_DBG_H */
