N
N/* bit operations */
N#define REG32(addr)                  (*(volatile uint32_t *)(uint32_t)(addr))
N#define REG16(addr)                  (*(volatile uint16_t *)(uint32_t)(addr))
N#define REG8(addr)                   (*(volatile uint8_t *)(uint32_t)(addr))
N#define BIT(x)                       ((uint32_t)((uint32_t)0x01U<<(x)))
N#define BITS(start, end)             ((0xFFFFFFFFUL << (start)) & (0xFFFFFFFFUL >> (31U - (uint32_t)(end))))
N#define GET_BITS(regval, start, end) (((regval) & BITS((start),(end))) >> (start))
N
N/* main flash and SRAM memory map */
N#define FLASH_BASE            ((uint32_t)0x08000000U)        /*!< main FLASH base address          */
N#define TCMSRAM_BASE          ((uint32_t)0x10000000U)        /*!< TCMSRAM(64KB) base address       */
N#define OPTION_BASE           ((uint32_t)0x1FFEC000U)        /*!< Option bytes base address        */
N#define SRAM_BASE             ((uint32_t)0x20000000U)        /*!< SRAM0 base address               */
N
N/* peripheral memory map */
N#define APB1_BUS_BASE         ((uint32_t)0x40000000U)        /*!< apb1 base address                */
N#define APB2_BUS_BASE         ((uint32_t)0x40010000U)        /*!< apb2 base address                */
N#define AHB1_BUS_BASE         ((uint32_t)0x40020000U)        /*!< ahb1 base address                */
N#define AHB2_BUS_BASE         ((uint32_t)0x50000000U)        /*!< ahb2 base address                */
N
N/* EXMC memory map */
N#define EXMC_BASE             ((uint32_t)0xA0000000U)        /*!< EXMC register base address       */
N
N/* advanced peripheral bus 1 memory map */
N#define TIMER_BASE            (APB1_BUS_BASE + 0x00000000U)  /*!< TIMER base address               */
N#define RTC_BASE              (APB1_BUS_BASE + 0x00002800U)  /*!< RTC base address                 */
N#define WWDGT_BASE            (APB1_BUS_BASE + 0x00002C00U)  /*!< WWDGT base address               */
N#define FWDGT_BASE            (APB1_BUS_BASE + 0x00003000U)  /*!< FWDGT base address               */
N#define I2S_ADD_BASE          (APB1_BUS_BASE + 0x00003400U)  /*!< I2S1_add base address            */
N#define SPI_BASE              (APB1_BUS_BASE + 0x00003800U)  /*!< SPI base address                 */
N#define USART_BASE            (APB1_BUS_BASE + 0x00004400U)  /*!< USART base address               */
N#define I2C_BASE              (APB1_BUS_BASE + 0x00005400U)  /*!< I2C base address                 */
N#define CAN_BASE              (APB1_BUS_BASE + 0x00006400U)  /*!< CAN base address                 */
N#define CTC_BASE              (APB1_BUS_BASE + 0x00006C00U)  /*!< CTC base address                 */
N#define PMU_BASE              (APB1_BUS_BASE + 0x00007000U)  /*!< PMU base address                 */
N#define DAC_BASE              (APB1_BUS_BASE + 0x00007400U)  /*!< DAC base address                 */
N#define IREF_BASE             (APB1_BUS_BASE + 0x0000C400U)  /*!< IREF base address                */
N
N/* advanced peripheral bus 2 memory map */
N#define TLI_BASE              (APB2_BUS_BASE + 0x00006800U)  /*!< TLI base address                 */
N#define SYSCFG_BASE           (APB2_BUS_BASE + 0x00003800U)  /*!< SYSCFG base address              */
N#define EXTI_BASE             (APB2_BUS_BASE + 0x00003C00U)  /*!< EXTI base address                */
N#define SDIO_BASE             (APB2_BUS_BASE + 0x00002C00U)  /*!< SDIO base address                */
N#define ADC_BASE              (APB2_BUS_BASE + 0x00002000U)  /*!< ADC base address                 */
N/* advanced high performance bus 1 memory map */
N#define GPIO_BASE             (AHB1_BUS_BASE + 0x00000000U)  /*!< GPIO base address                */
N#define CRC_BASE              (AHB1_BUS_BASE + 0x00003000U)  /*!< CRC base address                 */
N#define RCU_BASE              (AHB1_BUS_BASE + 0x00003800U)  /*!< RCU base address                 */
N#define FMC_BASE              (AHB1_BUS_BASE + 0x00003C00U)  /*!< FMC base address                 */
N#define BKPSRAM_BASE          (AHB1_BUS_BASE + 0x00004000U)  /*!< BKPSRAM base address             */
N#define DMA_BASE              (AHB1_BUS_BASE + 0x00006000U)  /*!< DMA base address                 */
N#define ENET_BASE             (AHB1_BUS_BASE + 0x00008000U)  /*!< ENET base address                */
N#define IPA_BASE              (AHB1_BUS_BASE + 0x0000B000U)  /*!< IPA base address                 */
N#define USBHS_BASE            (AHB1_BUS_BASE + 0x00020000U)  /*!< USBHS base address               */
N
N/* advanced high performance bus 2 memory map */
N#define USBFS_BASE            (AHB2_BUS_BASE + 0x00000000U)  /*!< USBFS base address               */
N#define DCI_BASE              (AHB2_BUS_BASE + 0x00050000U)  /*!< DCI base address                 */
N#define TRNG_BASE             (AHB2_BUS_BASE + 0x00060800U)  /*!< TRNG base address                */
N/* option byte and debug memory map */
N#define OB_BASE               ((uint32_t)0x1FFEC000U)        /*!< OB base address                  */
N#define DBG_BASE              ((uint32_t)0xE0042000U)        /*!< DBG base address                 */
