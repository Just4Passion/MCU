N#ifndef GD32F4XX_PMU_H
N#define GD32F4XX_PMU_H
N
N#include "gd32f4xx.h"
N
N/* PMU definitions */
N#define PMU                           PMU_BASE                 /*!< PMU base address */
N
N/* registers definitions */
N#define PMU_CTL                       REG32((PMU) + 0x00U)     /*!< PMU control register */
N#define PMU_CS                        REG32((PMU) + 0x04U)     /*!< PMU control and status register */
N
N/* bits definitions */
N/* PMU_CTL */
N#define PMU_CTL_LDOLP                 BIT(0)                   /*!< LDO low power mode */
N#define PMU_CTL_STBMOD                BIT(1)                   /*!< standby mode */
N#define PMU_CTL_WURST                 BIT(2)                   /*!< wakeup flag reset */
N#define PMU_CTL_STBRST                BIT(3)                   /*!< standby flag reset */
N#define PMU_CTL_LVDEN                 BIT(4)                   /*!< low voltage detector enable */
N#define PMU_CTL_LVDT                  BITS(5,7)                /*!< low voltage detector threshold */
N#define PMU_CTL_BKPWEN                BIT(8)                   /*!< backup domain write enable */
N#define PMU_CTL_LDLP                  BIT(10)                  /*!< low-driver mode when use low power LDO */
N#define PMU_CTL_LDNP                  BIT(11)                  /*!< low-driver mode when use normal power LDO */
N#define PMU_CTL_LDOVS                 BITS(14,15)              /*!< LDO output voltage select */
N#define PMU_CTL_HDEN                  BIT(16)                  /*!< high-driver mode enable */
N#define PMU_CTL_HDS                   BIT(17)                  /*!< high-driver mode switch */
N#define PMU_CTL_LDEN                  BITS(18,19)              /*!< low-driver mode enable in deep-sleep mode */
N
N/* PMU_CS */
N#define PMU_CS_WUF                    BIT(0)                   /*!< wakeup flag */
N#define PMU_CS_STBF                   BIT(1)                   /*!< standby flag */
N#define PMU_CS_LVDF                   BIT(2)                   /*!< low voltage detector status flag */
N#define PMU_CS_BLDORF                 BIT(3)                   /*!< backup SRAM LDO ready flag */
N#define PMU_CS_WUPEN                  BIT(8)                   /*!< wakeup pin enable */
N#define PMU_CS_BLDOON                 BIT(9)                   /*!< backup SRAM LDO on */
N#define PMU_CS_LDOVSRF                BIT(14)                  /*!< LDO voltage select ready flag */
N#define PMU_CS_HDRF                   BIT(16)                  /*!< high-driver ready flag */
N#define PMU_CS_HDSRF                  BIT(17)                  /*!< high-driver switch ready flag */
N#define PMU_CS_LDRF                   BITS(18,19)              /*!< Low-driver mode ready flag */
N
N/* constants definitions */
N/* PMU low voltage detector threshold definitions */
N#define CTL_LVDT(regval)              (BITS(5,7)&((uint32_t)(regval)<<5))
N#define PMU_LVDT_0                    CTL_LVDT(0)              /*!< voltage threshold is 2.1V */
N#define PMU_LVDT_1                    CTL_LVDT(1)              /*!< voltage threshold is 2.3V */
N#define PMU_LVDT_2                    CTL_LVDT(2)              /*!< voltage threshold is 2.4V */
N#define PMU_LVDT_3                    CTL_LVDT(3)              /*!< voltage threshold is 2.6V */
N#define PMU_LVDT_4                    CTL_LVDT(4)              /*!< voltage threshold is 2.7V */
N#define PMU_LVDT_5                    CTL_LVDT(5)              /*!< voltage threshold is 2.9V */
N#define PMU_LVDT_6                    CTL_LVDT(6)              /*!< voltage threshold is 3.0V */
N#define PMU_LVDT_7                    CTL_LVDT(7)              /*!< voltage threshold is 3.1V */
N
N/* PMU LDO output voltage select definitions */
N#define CTL_LDOVS(regval)             (BITS(14,15)&((uint32_t)(regval)<<14))
N#define PMU_LDOVS_LOW                 CTL_LDOVS(1)             /*!< LDO output voltage low mode */
N#define PMU_LDOVS_MID                 CTL_LDOVS(2)             /*!< LDO output voltage mid mode */
N#define PMU_LDOVS_HIGH                CTL_LDOVS(3)             /*!< LDO output voltage high mode */
N
N/* PMU low-driver mode enable in deep-sleep mode */
N#define CTL_LDEN(regval)              (BITS(18,19)&((uint32_t)(regval)<<18))
N#define PMU_LOWDRIVER_DISABLE         CTL_LDEN(0)              /*!< low-driver mode disable in deep-sleep mode */
N#define PMU_LOWDRIVER_ENABLE          CTL_LDEN(3)              /*!< low-driver mode enable in deep-sleep mode */
N
N/* PMU high-driver mode switch */
N#define CTL_HDS(regval)               (BIT(17)&((uint32_t)(regval)<<17))
N#define PMU_HIGHDR_SWITCH_NONE        CTL_HDS(0)               /*!< no high-driver mode switch */
N#define PMU_HIGHDR_SWITCH_EN          CTL_HDS(1)               /*!< high-driver mode switch */
N
N/* PMU low-driver mode when use low power LDO */
N#define CTL_LDLP(regval)              (BIT(10)&((uint32_t)(regval)<<10))
N#define PMU_NORMALDR_LOWPWR           CTL_LDLP(0)              /*!< normal driver when use low power LDO */
N#define PMU_LOWDR_LOWPWR              CTL_LDLP(1)              /*!< low-driver mode enabled when LDEN is 11 and use low power LDO */
N
N/* PMU low-driver mode when use normal power LDO */
N#define CTL_LDNP(regval)              (BIT(11)&((uint32_t)(regval)<<11))
N#define PMU_NORMALDR_NORMALPWR        CTL_LDNP(0)              /*!< normal driver when use normal power LDO */
N#define PMU_LOWDR_NORMALPWR           CTL_LDNP(1)              /*!< low-driver mode enabled when LDEN is 11 and use normal power LDO */
N
N/* PMU low power mode ready flag definitions */
N#define CS_LDRF(regval)               (BITS(18,19)&((uint32_t)(regval)<<18))
N#define PMU_LDRF_NORMAL               CS_LDRF(0)               /*!< normal driver in deep-sleep mode */
N#define PMU_LDRF_LOWDRIVER            CS_LDRF(3)               /*!< low-driver mode in deep-sleep mode */
N
N/* PMU backup SRAM LDO on or off */
N#define CS_BLDOON(regval)             (BIT(9)&((uint32_t)(regval)<<9))
N#define PMU_BLDOON_OFF                CS_BLDOON(0)             /*!< backup SRAM LDO off */
N#define PMU_BLDOON_ON                 CS_BLDOON(1)             /*!< the backup SRAM LDO on */
N
N/* PMU flag definitions */
N#define PMU_FLAG_WAKEUP               PMU_CS_WUF               /*!< wakeup flag status */
N#define PMU_FLAG_STANDBY              PMU_CS_STBF              /*!< standby flag status */
N#define PMU_FLAG_LVD                  PMU_CS_LVDF              /*!< lvd flag status */
N#define PMU_FLAG_BLDORF               PMU_CS_BLDORF            /*!< backup SRAM LDO ready flag */
N#define PMU_FLAG_LDOVSRF              PMU_CS_LDOVSRF           /*!< LDO voltage select ready flag */
N#define PMU_FLAG_HDRF                 PMU_CS_HDRF              /*!< high-driver ready flag */
N#define PMU_FLAG_HDSRF                PMU_CS_HDSRF             /*!< high-driver switch ready flag */
N#define PMU_FLAG_LDRF                 PMU_CS_LDRF              /*!< low-driver mode ready flag */
N
N/* PMU ldo definitions */
N#define PMU_LDO_NORMAL                ((uint32_t)0x00000000U)  /*!< LDO normal work when PMU enter deepsleep mode */
N#define PMU_LDO_LOWPOWER              PMU_CTL_LDOLP            /*!< LDO work at low power status when PMU enter deepsleep mode */
N
N/* PMU flag reset definitions */
N#define PMU_FLAG_RESET_WAKEUP         ((uint8_t)0x00U)         /*!< wakeup flag reset */
N#define PMU_FLAG_RESET_STANDBY        ((uint8_t)0x01U)         /*!< standby flag reset */
N
N/* PMU command constants definitions */
N#define WFI_CMD                       ((uint8_t)0x00U)         /*!< use WFI command */
N#define WFE_CMD                       ((uint8_t)0x01U)         /*!< use WFE command */
N
N/* function declarations */
N/* reset PMU register */
Nvoid pmu_deinit(void);
N
N/* select low voltage detector threshold */
Nvoid pmu_lvd_select(uint32_t lvdt_n);
N/* LDO output voltage select */
Nvoid pmu_ldo_output_select(uint32_t ldo_output);
N/* PMU lvd disable */
Nvoid pmu_lvd_disable(void);
N
N/* functions of low-driver mode and high-driver mode in deep-sleep mode */
N/* high-driver mode switch */
Nvoid pmu_highdriver_switch_select(uint32_t highdr_switch);
N/* high-driver mode enable */
Nvoid pmu_highdriver_mode_enable(void);
N/* high-driver mode disable */
Nvoid pmu_highdriver_mode_disable(void);
N/* low-driver mode enable in deep-sleep mode */
Nvoid pmu_low_driver_mode_enable(uint32_t lowdr_mode);
N/* in deep-sleep mode, low-driver mode when use low power LDO */
Nvoid pmu_lowdriver_lowpower_config(uint32_t mode);
N/* in deep-sleep mode, low-driver mode when use normal power LDO */
Nvoid pmu_lowdriver_normalpower_config(uint32_t mode);
N
N/* set PMU mode */
N/* PMU work at sleep mode */
Nvoid pmu_to_sleepmode(uint8_t sleepmodecmd);
N/* PMU work at deepsleep mode */
Nvoid pmu_to_deepsleepmode(uint32_t ldo, uint8_t deepsleepmodecmd);
N/* PMU work at standby mode */
Nvoid pmu_to_standbymode(uint8_t standbymodecmd);
N/* PMU wakeup pin enable */
Nvoid pmu_wakeup_pin_enable(void);
N/* PMU wakeup pin disable */
Nvoid pmu_wakeup_pin_disable(void);
N
N/* backup related functions */
N/* backup SRAM LDO on */
Nvoid pmu_backup_ldo_config(uint32_t bkp_ldo);
N/* backup domain write enable */
Nvoid pmu_backup_write_enable(void);
N/* backup domain write disable */
Nvoid pmu_backup_write_disable(void);
N
N/* flag functions */
N/* reset flag bit */
Nvoid pmu_flag_reset(uint32_t flag_reset);
N/* get flag status */
NFlagStatus pmu_flag_get(uint32_t pmu_flag);
N
N#endif /* GD32F4XX_PMU_H */
L 59 "..\User\config\gd32f4xx_libopt.h" 2
