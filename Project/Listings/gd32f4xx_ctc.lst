N#endif /* define GD32F4xx */
N
N#if !defined (GD32F450)  && !defined (GD32F405) && !defined (GD32F407)
X#if !0L  && !0L && !1L
S #error "Please select the target GD32F4xx device in gd32f4xx.h file"
