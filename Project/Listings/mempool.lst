S
S#define _LWP_NSIG       64
S
S#ifdef ARCH_CPU_64BIT
S#define _LWP_NSIG_BPW   64
S#else
S#define _LWP_NSIG_BPW   32
S#endif
S
S#define _LWP_NSIG_WORDS (RT_ALIGN(_LWP_NSIG, _LWP_NSIG_BPW) / _LWP_NSIG_BPW)
S
Stypedef void (*lwp_sighandler_t)(int);
Stypedef void (*lwp_sigaction_t)(int signo, siginfo_t *info, void *context);
S
Stypedef struct {
S    unsigned long sig[_LWP_NSIG_WORDS];
S} lwp_sigset_t;
S
S#if _LWP_NSIG <= 64
S#define lwp_sigmask(signo)      ((lwp_sigset_t){.sig = {[0] = ((long)(1u << ((signo)-1)))}})
S#define lwp_sigset_init(mask)   ((lwp_sigset_t){.sig = {[0] = (long)(mask)}})
S#endif /* _LWP_NSIG <= 64 */
S
Sstruct lwp_sigaction {
S    union {
S        void (*_sa_handler)(int);
S        void (*_sa_sigaction)(int, siginfo_t *, void *);
S    } __sa_handler;
S    lwp_sigset_t sa_mask;
S    int sa_flags;
S    void (*sa_restorer)(void);
S};
S
Stypedef struct lwp_siginfo_ext {
S    union {
S        /* for SIGCHLD */
S        struct {
S            int status;
S            clock_t utime;
S            clock_t stime;
S        } sigchld;
S    };
S} *lwp_siginfo_ext_t;
S
Stypedef struct lwp_siginfo {
S    rt_list_t node;
S
S    struct {
S        int signo;
S        int code;
S
S        int from_tid;
S        pid_t from_pid;
S    } ksiginfo;
S
S    /* the signal specified extension field */
S    struct lwp_siginfo_ext *ext;
S} *lwp_siginfo_t;
S
Stypedef struct lwp_sigqueue {
S    rt_list_t siginfo_list;
S    lwp_sigset_t sigset_pending;
S} *lwp_sigqueue_t;
S
Sstruct lwp_thread_signal {
S    lwp_sigset_t sigset_mask;
S    struct lwp_sigqueue sig_queue;
S};
S
Sstruct rt_user_context
S{
S    void *sp;
S    void *pc;
S    void *flag;
S
S    void *ctx;
S};
N#endif /* RT_USING_SMART */
N
Ntypedef void (*rt_thread_cleanup_t)(struct rt_thread *tid);
N
N/**
N * Thread structure
N */
N
Nstruct rt_thread
N{
N    struct rt_object            parent;
N
N    /* stack point and entry */
N    void                        *sp;                    /**< stack point */
N    void                        *entry;                 /**< entry */
N    void                        *parameter;             /**< parameter */
N    void                        *stack_addr;            /**< stack address */
N    rt_uint32_t                 stack_size;             /**< stack size */
N
N    /* error code */
N    rt_err_t                    error;                  /**< error code */
N
N#ifdef RT_USING_SMP
S    rt_atomic_t                 cpus_lock_nest;         /**< cpus lock count */
N#endif
N
N    RT_SCHED_THREAD_CTX
X    struct rt_sched_thread_ctx sched_thread_ctx;
N    struct rt_timer             thread_timer;           /**< built-in thread timer */
N    rt_thread_cleanup_t         cleanup;                /**< cleanup function when thread exit */
N
N#ifdef RT_USING_MUTEX
N    /* object for IPC */
N    rt_list_t                   taken_object_list;
N    rt_object_t                 pending_object;
N#endif /* RT_USING_MUTEX */
N
N#ifdef RT_USING_EVENT
S    /* thread event */
S    rt_uint32_t                 event_set;
S    rt_uint8_t                  event_info;
N#endif /* RT_USING_EVENT */
N
N#ifdef RT_USING_SIGNALS
S    rt_sigset_t                 sig_pending;            /**< the pending signals */
S    rt_sigset_t                 sig_mask;               /**< the mask bits of signal */
S
S#ifndef RT_USING_SMP
S    void                        *sig_ret;               /**< the return stack pointer from signal */
S#endif /* RT_USING_SMP */
S    rt_sighandler_t             *sig_vectors;           /**< vectors of signal handler */
S    void                        *si_list;               /**< the signal infor list */
N#endif /* RT_USING_SIGNALS */
N
N#ifdef RT_USING_CPU_USAGE
S    rt_uint64_t                 duration_tick;          /**< cpu usage tick */
N#endif /* RT_USING_CPU_USAGE */
N
N#ifdef RT_USING_PTHREADS
S    void                        *pthread_data;          /**< the handle of pthread data, adapt 32/64bit */
N#endif /* RT_USING_PTHREADS */
N
N    /* light weight process if present */
N#ifdef RT_USING_SMART
S    void                        *msg_ret;               /**< the return msg */
S
S    void                        *lwp;                   /**< the lwp reference */
S    /* for user create */
S    void                        *user_entry;
S    void                        *user_stack;
S    rt_uint32_t                 user_stack_size;
S    rt_uint32_t                 *kernel_sp;             /**< kernel stack point */
S    rt_list_t                   sibling;                /**< next thread of same process */
S
S    struct lwp_thread_signal    signal;                 /**< lwp signal for user-space thread */
S    struct rt_user_context      user_ctx;               /**< user space context */
S    struct rt_wakeup            wakeup_handle;          /**< wakeup handle for IPC */
S    rt_atomic_t                 exit_request;           /**< pending exit request of thread */
S    int                         tid;                    /**< thread ID used by process */
S    int                         tid_ref_count;          /**< reference of tid */
S    void                        *susp_recycler;         /**< suspended recycler on this thread */
S    void                        *robust_list;           /**< pi lock, very carefully, it's a userspace list!*/
S
S#ifndef ARCH_MM_MMU
S    lwp_sighandler_t            signal_handler[32];
S#else
S    int                         step_exec;
S    int                         debug_attach_req;
S    int                         debug_ret_user;
S    int                         debug_suspend;
S    struct rt_hw_exp_stack      *regs;
S    void                        *thread_idr;            /** lwp thread indicator */
S    int                         *clear_child_tid;
S#endif /* ARCH_MM_MMU */
N#endif /* RT_USING_SMART */
N
N#ifdef RT_USING_CPU_USAGE_TRACER
S    rt_ubase_t                  user_time;              /**< Ticks on user */
S    rt_ubase_t                  system_time;            /**< Ticks on system */
N#endif /* RT_USING_CPU_USAGE_TRACER */
N
N#ifdef RT_USING_MEM_PROTECTION
S    void *mem_regions;
S#ifdef RT_USING_HW_STACK_GUARD
S    void *stack_buf;
S#endif /* RT_USING_HW_STACK_GUARD */
N#endif /* RT_USING_MEM_PROTECTION */
N
N    struct rt_spinlock          spinlock;
N    rt_ubase_t                  user_data;              /**< private user data beyond this thread */
N};
Ntypedef struct rt_thread *rt_thread_t;
N
N#ifdef RT_USING_SMART
S#define LWP_IS_USER_MODE(t) ((t)->user_ctx.ctx == RT_NULL)
N#else
N#define LWP_IS_USER_MODE(t) (0)
N#endif /* RT_USING_SMART */
N
N/**@}*/
N
N/**
N * @addtogroup group_thread_comm
N */
N
N/**@{*/
N
N/**
N * IPC flags and control command definitions
N */
N#define RT_IPC_FLAG_FIFO                0x00            /**< FIFOed IPC. @ref group_thread_comm. */
N#define RT_IPC_FLAG_PRIO                0x01            /**< PRIOed IPC. @ref group_thread_comm. */
N
N#define RT_IPC_CMD_UNKNOWN              0x00            /**< unknown IPC command */
N#define RT_IPC_CMD_RESET                0x01            /**< reset IPC object */
N#define RT_IPC_CMD_GET_STATE            0x02            /**< get the state of IPC object */
N#define RT_IPC_CMD_SET_VLIMIT           0x03            /**< set max limit value of IPC value */
N
N#define RT_WAITING_FOREVER              -1              /**< Block forever until get resource. */
N#define RT_WAITING_NO                   0               /**< Non-block. */
N
N/**
N * Base structure of IPC object
N */
Nstruct rt_ipc_object
N{
N    struct rt_object parent;                            /**< inherit from rt_object */
N
N    rt_list_t suspend_thread;                 /**< threads pended on this resource */
N};
N
N/**
N * @addtogroup group_semaphore Semaphore
N * @{
N */
N
N#ifdef RT_USING_SEMAPHORE
N/**
N * Semaphore structure
N */
Nstruct rt_semaphore
N{
N    struct rt_ipc_object parent;                        /**< inherit from ipc_object */
N
N    rt_uint16_t          value;                         /**< value of semaphore. */
N    rt_uint16_t          max_value;
N    struct rt_spinlock   spinlock;
N};
Ntypedef struct rt_semaphore *rt_sem_t;
N#endif /* RT_USING_SEMAPHORE */
N
N/**@}*/
N
N/**
N * @addtogroup group_mutex Mutex
N * @{
N */
N
N#ifdef RT_USING_MUTEX
N/**
N * Mutual exclusion (mutex) structure
N */
Nstruct rt_mutex
N{
N    struct rt_ipc_object parent;                        /**< inherit from ipc_object */
N
N    rt_uint8_t           ceiling_priority;              /**< the priority ceiling of mutexe */
N    rt_uint8_t           priority;                      /**< the maximal priority for pending thread */
N    rt_uint8_t           hold;                          /**< numbers of thread hold the mutex */
N    rt_uint8_t           reserved;                      /**< reserved field */
N
N    struct rt_thread    *owner;                         /**< current owner of mutex */
N    rt_list_t            taken_list;                    /**< the object list taken by thread */
N    struct rt_spinlock   spinlock;
N};
Ntypedef struct rt_mutex *rt_mutex_t;
N#endif /* RT_USING_MUTEX */
N
N/**@}*/
N
N/**
N * @addtogroup group_event Event
N * @{
N */
N
N#ifdef RT_USING_EVENT
S/**
S * flag definitions in event
S */
S#define RT_EVENT_FLAG_AND               0x01            /**< logic and */
S#define RT_EVENT_FLAG_OR                0x02            /**< logic or */
S#define RT_EVENT_FLAG_CLEAR             0x04            /**< clear flag */
S
S/*
S * event structure
S */
Sstruct rt_event
S{
S    struct rt_ipc_object parent;                        /**< inherit from ipc_object */
S
S    rt_uint32_t          set;                           /**< event set */
S    struct rt_spinlock   spinlock;
S};
Stypedef struct rt_event *rt_event_t;
N#endif /* RT_USING_EVENT */
N
N/**@}*/
N
N/**
N * @addtogroup group_mailbox MailBox
