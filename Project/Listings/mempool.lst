N#ifdef RT_USING_MEMPOOL
S
S#if defined(RT_USING_HOOK) && defined(RT_HOOK_USING_FUNC_PTR)
Sstatic void (*rt_mp_alloc_hook)(struct rt_mempool *mp, void *block);
Sstatic void (*rt_mp_free_hook)(struct rt_mempool *mp, void *block);
S
S/**
S * @addtogroup group_hook
S */
S
S/**@{*/
S
S/**
S * @brief This function will set a hook function, which will be invoked when a memory
S *        block is allocated from the memory pool.
S *
S * @param hook the hook function
S */
Svoid rt_mp_alloc_sethook(void (*hook)(struct rt_mempool *mp, void *block))
S{
S    rt_mp_alloc_hook = hook;
S}
S
S/**
S * @brief This function will set a hook function, which will be invoked when a memory
S *        block is released to the memory pool.
S *
S * @param hook the hook function
S */
Svoid rt_mp_free_sethook(void (*hook)(struct rt_mempool *mp, void *block))
S{
S    rt_mp_free_hook = hook;
S}
S
S/**@}*/
S#endif /* RT_USING_HOOK */
S
S/**
S * @addtogroup group_memory_management
S */
S
S/**@{*/
S
S/**
S * @brief  This function will initialize a memory pool object, normally which is used
S *         for static object.
S *
S * @param  mp is the memory pool object.
S *
S * @param  name is the name of the memory pool.
S *
S * @param  start is the start address of the memory pool.
S *
S * @param  size is the total size of the memory pool.
S *
S * @param  block_size is the size for each block..
S *
S * @return RT_EOK
S */
Srt_err_t rt_mp_init(struct rt_mempool *mp,
S                    const char        *name,
S                    void              *start,
S                    rt_size_t          size,
S                    rt_size_t          block_size)
S{
S    rt_uint8_t *block_ptr;
S    rt_size_t offset;
S
S    /* parameter check */
S    RT_ASSERT(mp != RT_NULL);
S    RT_ASSERT(name != RT_NULL);
S    RT_ASSERT(start != RT_NULL);
S    RT_ASSERT(size > 0 && block_size > 0);
S
S    /* initialize object */
S    rt_object_init(&(mp->parent), RT_Object_Class_MemPool, name);
S
S    /* initialize memory pool */
S    mp->start_address = start;
S    mp->size = RT_ALIGN_DOWN(size, RT_ALIGN_SIZE);
S
S    /* align the block size */
S    block_size = RT_ALIGN(block_size, RT_ALIGN_SIZE);
S    mp->block_size = block_size;
S
S    /* align to align size byte */
S    mp->block_total_count = mp->size / (mp->block_size + sizeof(rt_uint8_t *));
S    mp->block_free_count  = mp->block_total_count;
S
S    /* initialize suspended thread list */
S    rt_list_init(&(mp->suspend_thread));
S
S    /* initialize free block list */
S    block_ptr = (rt_uint8_t *)mp->start_address;
S    for (offset = 0; offset < mp->block_total_count; offset ++)
S    {
S        *(rt_uint8_t **)(block_ptr + offset * (block_size + sizeof(rt_uint8_t *))) =
S            (rt_uint8_t *)(block_ptr + (offset + 1) * (block_size + sizeof(rt_uint8_t *)));
S    }
S
S    *(rt_uint8_t **)(block_ptr + (offset - 1) * (block_size + sizeof(rt_uint8_t *))) =
S        RT_NULL;
S
S    mp->block_list = block_ptr;
S    rt_spin_lock_init(&(mp->spinlock));
S
S    return RT_EOK;
S}
SRTM_EXPORT(rt_mp_init);
S
S/**
S * @brief  This function will detach a memory pool from system object management.
S *
S * @param  mp is the memory pool object.
S *
S * @return RT_EOK
S */
Srt_err_t rt_mp_detach(struct rt_mempool *mp)
S{
S    rt_base_t level;
S
S    /* parameter check */
S    RT_ASSERT(mp != RT_NULL);
S    RT_ASSERT(rt_object_get_type(&mp->parent) == RT_Object_Class_MemPool);
S    RT_ASSERT(rt_object_is_systemobject(&mp->parent));
S
S    level = rt_spin_lock_irqsave(&(mp->spinlock));
S    /* wake up all suspended threads */
S    rt_susp_list_resume_all(&mp->suspend_thread, RT_ERROR);
S
S    /* detach object */
S    rt_object_detach(&(mp->parent));
S    rt_spin_unlock_irqrestore(&(mp->spinlock), level);
S
S    return RT_EOK;
S}
SRTM_EXPORT(rt_mp_detach);
S
S#ifdef RT_USING_HEAP
S/**
S * @brief This function will create a mempool object and allocate the memory pool from
S *        heap.
S *
S * @param name is the name of memory pool.
S *
S * @param block_count is the count of blocks in memory pool.
S *
S * @param block_size is the size for each block.
S *
S * @return the created mempool object
S */
Srt_mp_t rt_mp_create(const char *name,
S                     rt_size_t   block_count,
S                     rt_size_t   block_size)
S{
S    rt_uint8_t *block_ptr;
S    struct rt_mempool *mp;
S    rt_size_t offset;
S
S    RT_DEBUG_NOT_IN_INTERRUPT;
S
S    /* parameter check */
S    RT_ASSERT(name != RT_NULL);
S    RT_ASSERT(block_count > 0 && block_size > 0);
S
S    /* allocate object */
S    mp = (struct rt_mempool *)rt_object_allocate(RT_Object_Class_MemPool, name);
S    /* allocate object failed */
S    if (mp == RT_NULL)
S        return RT_NULL;
S
S    /* initialize memory pool */
S    block_size     = RT_ALIGN(block_size, RT_ALIGN_SIZE);
S    mp->block_size = block_size;
S    mp->size       = (block_size + sizeof(rt_uint8_t *)) * block_count;
S
S    /* allocate memory */
S    mp->start_address = rt_malloc((block_size + sizeof(rt_uint8_t *)) *
S                                  block_count);
S    if (mp->start_address == RT_NULL)
S    {
S        /* no memory, delete memory pool object */
S        rt_object_delete(&(mp->parent));
S
S        return RT_NULL;
S    }
S
S    mp->block_total_count = block_count;
S    mp->block_free_count  = mp->block_total_count;
S
S    /* initialize suspended thread list */
S    rt_list_init(&(mp->suspend_thread));
S
S    /* initialize free block list */
S    block_ptr = (rt_uint8_t *)mp->start_address;
S    for (offset = 0; offset < mp->block_total_count; offset ++)
S    {
S        *(rt_uint8_t **)(block_ptr + offset * (block_size + sizeof(rt_uint8_t *)))
S            = block_ptr + (offset + 1) * (block_size + sizeof(rt_uint8_t *));
S    }
S
S    *(rt_uint8_t **)(block_ptr + (offset - 1) * (block_size + sizeof(rt_uint8_t *)))
S        = RT_NULL;
S
S    mp->block_list = block_ptr;
S    rt_spin_lock_init(&(mp->spinlock));
S
S    return mp;
S}
SRTM_EXPORT(rt_mp_create);
S
S/**
S * @brief This function will delete a memory pool and release the object memory.
S *
S * @param mp is the memory pool object.
S *
S * @return RT_EOK
S */
Srt_err_t rt_mp_delete(rt_mp_t mp)
S{
S    rt_base_t level;
S
S    RT_DEBUG_NOT_IN_INTERRUPT;
S
S    /* parameter check */
S    RT_ASSERT(mp != RT_NULL);
S    RT_ASSERT(rt_object_get_type(&mp->parent) == RT_Object_Class_MemPool);
S    RT_ASSERT(rt_object_is_systemobject(&mp->parent) == RT_FALSE);
S
S    level = rt_spin_lock_irqsave(&(mp->spinlock));
S    /* wake up all suspended threads */
S    rt_susp_list_resume_all(&mp->suspend_thread, RT_ERROR);
S
S    rt_spin_unlock_irqrestore(&(mp->spinlock), level);
S
S    /* release allocated room */
S    rt_free(mp->start_address);
S
S    /* detach object */
S    rt_object_delete(&(mp->parent));
S
S    return RT_EOK;
S}
SRTM_EXPORT(rt_mp_delete);
S#endif /* RT_USING_HEAP */
S
S/**
S * @brief This function will allocate a block from memory pool.
S *
S * @param mp is the memory pool object.
S *
S * @param time is the maximum waiting time for allocating memory.
S *             - 0 for not waiting, allocating memory immediately.
S *
S * @return the allocated memory block or RT_NULL on allocated failed.
S */
Svoid *rt_mp_alloc(rt_mp_t mp, rt_int32_t time)
S{
S    rt_uint8_t *block_ptr;
S    rt_base_t level;
S    struct rt_thread *thread;
S    rt_uint32_t before_sleep = 0;
S
S    /* parameter check */
S    RT_ASSERT(mp != RT_NULL);
S
S    /* get current thread */
S    thread = rt_thread_self();
S
S    level = rt_spin_lock_irqsave(&(mp->spinlock));
S
S    while (mp->block_free_count == 0)
S    {
S        /* memory block is unavailable. */
S        if (time == 0)
S        {
S            rt_spin_unlock_irqrestore(&(mp->spinlock), level);
S
S            rt_set_errno(-RT_ETIMEOUT);
S
S            return RT_NULL;
S        }
S
S        RT_DEBUG_NOT_IN_INTERRUPT;
S
S        thread->error = RT_EOK;
S
S        /* need suspend thread */
S        rt_thread_suspend_to_list(thread, &mp->suspend_thread, RT_IPC_FLAG_FIFO, RT_UNINTERRUPTIBLE);
S
S        if (time > 0)
S        {
S            /* get the start tick of timer */
S            before_sleep = rt_tick_get();
S
S            /* init thread timer and start it */
S            rt_timer_control(&(thread->thread_timer),
S                             RT_TIMER_CTRL_SET_TIME,
S                             &time);
S            rt_timer_start(&(thread->thread_timer));
S        }
S
S        /* enable interrupt */
S        rt_spin_unlock_irqrestore(&(mp->spinlock), level);
S
S        /* do a schedule */
S        rt_schedule();
S
S        if (thread->error != RT_EOK)
S            return RT_NULL;
S
S        if (time > 0)
S        {
S            time -= rt_tick_get() - before_sleep;
S            if (time < 0)
S                time = 0;
S        }
S        level = rt_spin_lock_irqsave(&(mp->spinlock));
S    }
S
S    /* memory block is available. decrease the free block counter */
S    mp->block_free_count--;
S
S    /* get block from block list */
S    block_ptr = mp->block_list;
S    RT_ASSERT(block_ptr != RT_NULL);
S
S    /* Setup the next free node. */
S    mp->block_list = *(rt_uint8_t **)block_ptr;
S
S    /* point to memory pool */
S    *(rt_uint8_t **)block_ptr = (rt_uint8_t *)mp;
S
S    rt_spin_unlock_irqrestore(&(mp->spinlock), level);
S
S    RT_OBJECT_HOOK_CALL(rt_mp_alloc_hook,
S                        (mp, (rt_uint8_t *)(block_ptr + sizeof(rt_uint8_t *))));
S
S    return (rt_uint8_t *)(block_ptr + sizeof(rt_uint8_t *));
S}
SRTM_EXPORT(rt_mp_alloc);
S
S/**
S * @brief This function will release a memory block.
S *
S * @param block the address of memory block to be released.
S */
Svoid rt_mp_free(void *block)
S{
S    rt_uint8_t **block_ptr;
S    struct rt_mempool *mp;
S    rt_base_t level;
S
S    /* parameter check */
S    if (block == RT_NULL) return;
S
S    /* get the control block of pool which the block belongs to */
S    block_ptr = (rt_uint8_t **)((rt_uint8_t *)block - sizeof(rt_uint8_t *));
S    mp        = (struct rt_mempool *)*block_ptr;
S
S    RT_OBJECT_HOOK_CALL(rt_mp_free_hook, (mp, block));
S
S    level = rt_spin_lock_irqsave(&(mp->spinlock));
S
S    /* increase the free block count */
S    mp->block_free_count ++;
S
S    /* link the block into the block list */
S    *block_ptr = mp->block_list;
S    mp->block_list = (rt_uint8_t *)block_ptr;
S
S    if (rt_susp_list_dequeue(&mp->suspend_thread, RT_EOK))
S    {
S        rt_spin_unlock_irqrestore(&(mp->spinlock), level);
S
S        /* do a schedule */
S        rt_schedule();
S
S        return;
S    }
S    rt_spin_unlock_irqrestore(&(mp->spinlock), level);
S}
SRTM_EXPORT(rt_mp_free);
S
S/**@}*/
S
N#endif /* RT_USING_MEMPOOL */
