N#include "gd32f4xx.h"
N
N/* IREF definitions */
N#define IREF                            IREF_BASE              /*!< IREF base address */
N
N/* registers definitions */
N#define IREF_CTL                        REG32(IREF + 0x300U)   /*!< IREF control register */
N
N/* bits definitions */
N/* IREF_CTL */
N#define IREF_CTL_CSDT                   BITS(0,5)              /*!< current step data */
N#define IREF_CTL_SCMOD                  BIT(7)                 /*!< sink current mode */
N#define IREF_CTL_CPT                    BITS(8,12)             /*!< current precision trim */
N#define IREF_CTL_SSEL                   BIT(14)                /*!< step selection */ 
N#define IREF_CTL_CREN                   BIT(15)                /*!< current reference enable */
N
N/* constants definitions */
N/* IREF current precision trim */
N#define CTL_CPT(regval)                 (BITS(8,12) & ((uint32_t)(regval) << 8))
N#define IREF_CUR_PRECISION_TRIM_0       CTL_CPT(0)             /*!< IREF current precision trim 0 */
N#define IREF_CUR_PRECISION_TRIM_1       CTL_CPT(1)             /*!< IREF current precision trim 1 */
N#define IREF_CUR_PRECISION_TRIM_2       CTL_CPT(2)             /*!< IREF current precision trim 2 */
