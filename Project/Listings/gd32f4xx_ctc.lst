N#ifndef GD32F4XX_USART_H
N#define GD32F4XX_USART_H
N
N#include "gd32f4xx.h"
N
N/* USARTx(x=0,1,2,5)/UARTx(x=3,4,6,7) definitions */
N#define USART1                        USART_BASE                     /*!< USART1 base address */
N#define USART2                        (USART_BASE+0x00000400U)       /*!< USART2 base address */
N#define UART3                         (USART_BASE+0x00000800U)       /*!< UART3 base address */
N#define UART4                         (USART_BASE+0x00000C00U)       /*!< UART4 base address */
N#define UART6                         (USART_BASE+0x00003400U)       /*!< UART6 base address */
N#define UART7                         (USART_BASE+0x00003800U)       /*!< UART7 base address */
N#define USART0                        (USART_BASE+0x0000CC00U)       /*!< USART0 base address */
N#define USART5                        (USART_BASE+0x0000D000U)       /*!< USART5 base address */
N
N/* registers definitions */
N#define USART_STAT0(usartx)           REG32((usartx) + 0x00U)        /*!< USART status register 0 */
N#define USART_DATA(usartx)            REG32((usartx) + 0x04U)        /*!< USART data register */
N#define USART_BAUD(usartx)            REG32((usartx) + 0x08U)        /*!< USART baud rate register */
N#define USART_CTL0(usartx)            REG32((usartx) + 0x0CU)        /*!< USART control register 0 */
N#define USART_CTL1(usartx)            REG32((usartx) + 0x10U)        /*!< USART control register 1 */
N#define USART_CTL2(usartx)            REG32((usartx) + 0x14U)        /*!< USART control register 2 */
N#define USART_GP(usartx)              REG32((usartx) + 0x18U)        /*!< USART guard time and prescaler register */
N#define USART_CTL3(usartx)            REG32((usartx) + 0x80U)        /*!< USART control register 3 */
N#define USART_RT(usartx)              REG32((usartx) + 0x84U)        /*!< USART receiver timeout register */
N#define USART_STAT1(usartx)           REG32((usartx) + 0x88U)        /*!< USART status register 1 */
N#define USART_CHC(usartx)             REG32((usartx) + 0xC0U)        /*!< USART coherence control register */
N
N/* bits definitions */
N/* USARTx_STAT0 */
N#define USART_STAT0_PERR              BIT(0)       /*!< parity error flag */
N#define USART_STAT0_FERR              BIT(1)       /*!< frame error flag */
N#define USART_STAT0_NERR              BIT(2)       /*!< noise error flag */
N#define USART_STAT0_ORERR             BIT(3)       /*!< overrun error */
N#define USART_STAT0_IDLEF             BIT(4)       /*!< IDLE frame detected flag */
N#define USART_STAT0_RBNE              BIT(5)       /*!< read data buffer not empty */
N#define USART_STAT0_TC                BIT(6)       /*!< transmission complete */
N#define USART_STAT0_TBE               BIT(7)       /*!< transmit data buffer empty */
N#define USART_STAT0_LBDF              BIT(8)       /*!< LIN break detected flag */
N#define USART_STAT0_CTSF              BIT(9)       /*!< CTS change flag */
N
N/* USARTx_DATA */
N#define USART_DATA_DATA               BITS(0,8)    /*!< transmit or read data value */
N
N/* USARTx_BAUD */
N#define USART_BAUD_FRADIV             BITS(0,3)    /*!< fraction part of baud-rate divider */
N#define USART_BAUD_INTDIV             BITS(4,15)   /*!< integer part of baud-rate divider */
N
N/* USARTx_CTL0 */
N#define USART_CTL0_SBKCMD             BIT(0)       /*!< send break command */
N#define USART_CTL0_RWU                BIT(1)       /*!< receiver wakeup from mute mode */
N#define USART_CTL0_REN                BIT(2)       /*!< receiver enable */
N#define USART_CTL0_TEN                BIT(3)       /*!< transmitter enable */
N#define USART_CTL0_IDLEIE             BIT(4)       /*!< idle line detected interrupt enable */
N#define USART_CTL0_RBNEIE             BIT(5)       /*!< read data buffer not empty interrupt and overrun error interrupt enable */
N#define USART_CTL0_TCIE               BIT(6)       /*!< transmission complete interrupt enable */
N#define USART_CTL0_TBEIE              BIT(7)       /*!< transmitter buffer empty interrupt enable */
N#define USART_CTL0_PERRIE             BIT(8)       /*!< parity error interrupt enable */
N#define USART_CTL0_PM                 BIT(9)       /*!< parity mode */
N#define USART_CTL0_PCEN               BIT(10)      /*!< parity check function enable */
N#define USART_CTL0_WM                 BIT(11)      /*!< wakeup method in mute mode */
N#define USART_CTL0_WL                 BIT(12)      /*!< word length */
N#define USART_CTL0_UEN                BIT(13)      /*!< USART enable */
N#define USART_CTL0_OVSMOD             BIT(15)      /*!< oversample mode */
N
N/* USARTx_CTL1 */
N#define USART_CTL1_ADDR               BITS(0,3)    /*!< address of USART */
N#define USART_CTL1_LBLEN              BIT(5)       /*!< LIN break frame length */
N#define USART_CTL1_LBDIE              BIT(6)       /*!< LIN break detected interrupt eanble */
N#define USART_CTL1_CLEN               BIT(8)       /*!< CK length */
N#define USART_CTL1_CPH                BIT(9)       /*!< CK phase */
N#define USART_CTL1_CPL                BIT(10)      /*!< CK polarity */
N#define USART_CTL1_CKEN               BIT(11)      /*!< CK pin enable */
N#define USART_CTL1_STB                BITS(12,13)  /*!< STOP bits length */
N#define USART_CTL1_LMEN               BIT(14)      /*!< LIN mode enable */
N
N/* USARTx_CTL2 */
N#define USART_CTL2_ERRIE              BIT(0)       /*!< error interrupt enable */
N#define USART_CTL2_IREN               BIT(1)       /*!< IrDA mode enable */
N#define USART_CTL2_IRLP               BIT(2)       /*!< IrDA low-power */
N#define USART_CTL2_HDEN               BIT(3)       /*!< half-duplex enable */
N#define USART_CTL2_NKEN               BIT(4)       /*!< NACK enable in smartcard mode */
N#define USART_CTL2_SCEN               BIT(5)       /*!< smartcard mode enable */
N#define USART_CTL2_DENR               BIT(6)       /*!< DMA request enable for reception */
N#define USART_CTL2_DENT               BIT(7)       /*!< DMA request enable for transmission */
N#define USART_CTL2_RTSEN              BIT(8)       /*!< RTS enable */
N#define USART_CTL2_CTSEN              BIT(9)       /*!< CTS enable */
N#define USART_CTL2_CTSIE              BIT(10)      /*!< CTS interrupt enable */
N#define USART_CTL2_OSB                BIT(11)      /*!< one sample bit method */
N
N/* USARTx_GP */
N#define USART_GP_PSC                  BITS(0,7)    /*!< prescaler value for dividing the system clock */
N#define USART_GP_GUAT                 BITS(8,15)   /*!< guard time value in smartcard mode */
N 
N/* USARTx_CTL3 */
N#define USART_CTL3_RTEN               BIT(0)       /*!< receiver timeout enable */
N#define USART_CTL3_SCRTNUM            BITS(1,3)    /*!< smartcard auto-retry number */
N#define USART_CTL3_RTIE               BIT(4)       /*!< interrupt enable bit of receive timeout event */
N#define USART_CTL3_EBIE               BIT(5)       /*!< interrupt enable bit of end of block event */
N#define USART_CTL3_RINV               BIT(8)       /*!< RX pin level inversion */
N#define USART_CTL3_TINV               BIT(9)       /*!< TX pin level inversion */
N#define USART_CTL3_DINV               BIT(10)      /*!< data bit level inversion */
N#define USART_CTL3_MSBF               BIT(11)      /*!< most significant bit first */
N
N/* USARTx_RT */
N#define USART_RT_RT                   BITS(0,23)   /*!< receiver timeout threshold */
N#define USART_RT_BL                   BITS(24,31)  /*!< block length */
N
N/* USARTx_STAT1 */
N#define USART_STAT1_RTF               BIT(11)      /*!< receiver timeout flag */
N#define USART_STAT1_EBF               BIT(12)      /*!< end of block flag */
N#define USART_STAT1_BSY               BIT(16)      /*!< busy flag */
N
N/* USARTx_CHC */
N#define USART_CHC_HCM                 BIT(0)       /*!< hardware flow control coherence mode */
N#define USART_CHC_PCM                 BIT(1)       /*!< parity check coherence mode */
N#define USART_CHC_BCM                 BIT(2)       /*!< break frame coherence mode */
N#define USART_CHC_EPERR               BIT(8)       /*!< early parity error flag */
N
N/* constants definitions */
N/* define the USART bit position and its register index offset */
N#define USART_REGIDX_BIT(regidx, bitpos)    (((uint32_t)(regidx) << 6) | (uint32_t)(bitpos))
N#define USART_REG_VAL(usartx, offset)       (REG32((usartx) + (((uint32_t)(offset) & 0xFFFFU) >> 6)))
N#define USART_BIT_POS(val)                  ((uint32_t)(val) & 0x1FU)
N#define USART_REGIDX_BIT2(regidx, bitpos, regidx2, bitpos2)   (((uint32_t)(regidx2) << 22) | (uint32_t)((bitpos2) << 16)\
N                                                              | (((uint32_t)(regidx) << 6) | (uint32_t)(bitpos)))
X#define USART_REGIDX_BIT2(regidx, bitpos, regidx2, bitpos2)   (((uint32_t)(regidx2) << 22) | (uint32_t)((bitpos2) << 16)                                                              | (((uint32_t)(regidx) << 6) | (uint32_t)(bitpos)))
N#define USART_REG_VAL2(usartx, offset)      (REG32((usartx) + ((uint32_t)(offset) >> 22)))
N#define USART_BIT_POS2(val)                 (((uint32_t)(val) & 0x1F0000U) >> 16)
N
N/* register offset */
N#define USART_STAT0_REG_OFFSET              0x00U        /*!< STAT0 register offset */
N#define USART_STAT1_REG_OFFSET              0x88U        /*!< STAT1 register offset */
N#define USART_CTL0_REG_OFFSET               0x0CU        /*!< CTL0 register offset */
N#define USART_CTL1_REG_OFFSET               0x10U        /*!< CTL1 register offset */
N#define USART_CTL2_REG_OFFSET               0x14U        /*!< CTL2 register offset */
N#define USART_CTL3_REG_OFFSET               0x80U        /*!< CTL3 register offset */
N#define USART_CHC_REG_OFFSET                0xC0U        /*!< CHC register offset */
N
N/* USART flags */
Ntypedef enum
N{
N    /* flags in STAT0 register */
N    USART_FLAG_CTS = USART_REGIDX_BIT(USART_STAT0_REG_OFFSET, 9U),      /*!< CTS change flag */
X    USART_FLAG_CTS = (((uint32_t)(0x00U) << 6) | (uint32_t)(9U)),       
N    USART_FLAG_LBD = USART_REGIDX_BIT(USART_STAT0_REG_OFFSET, 8U),      /*!< LIN break detected flag */
X    USART_FLAG_LBD = (((uint32_t)(0x00U) << 6) | (uint32_t)(8U)),       
N    USART_FLAG_TBE = USART_REGIDX_BIT(USART_STAT0_REG_OFFSET, 7U),      /*!< transmit data buffer empty */
X    USART_FLAG_TBE = (((uint32_t)(0x00U) << 6) | (uint32_t)(7U)),       
N    USART_FLAG_TC = USART_REGIDX_BIT(USART_STAT0_REG_OFFSET, 6U),       /*!< transmission complete */
X    USART_FLAG_TC = (((uint32_t)(0x00U) << 6) | (uint32_t)(6U)),        
N    USART_FLAG_RBNE = USART_REGIDX_BIT(USART_STAT0_REG_OFFSET, 5U),     /*!< read data buffer not empty */
X    USART_FLAG_RBNE = (((uint32_t)(0x00U) << 6) | (uint32_t)(5U)),      
N    USART_FLAG_IDLE = USART_REGIDX_BIT(USART_STAT0_REG_OFFSET, 4U),     /*!< IDLE frame detected flag */
X    USART_FLAG_IDLE = (((uint32_t)(0x00U) << 6) | (uint32_t)(4U)),      
N    USART_FLAG_ORERR = USART_REGIDX_BIT(USART_STAT0_REG_OFFSET, 3U),    /*!< overrun error */
X    USART_FLAG_ORERR = (((uint32_t)(0x00U) << 6) | (uint32_t)(3U)),     
N    USART_FLAG_NERR = USART_REGIDX_BIT(USART_STAT0_REG_OFFSET, 2U),     /*!< noise error flag */
X    USART_FLAG_NERR = (((uint32_t)(0x00U) << 6) | (uint32_t)(2U)),      
N    USART_FLAG_FERR = USART_REGIDX_BIT(USART_STAT0_REG_OFFSET, 1U),     /*!< frame error flag */
X    USART_FLAG_FERR = (((uint32_t)(0x00U) << 6) | (uint32_t)(1U)),      
N    USART_FLAG_PERR = USART_REGIDX_BIT(USART_STAT0_REG_OFFSET, 0U),     /*!< parity error flag */
X    USART_FLAG_PERR = (((uint32_t)(0x00U) << 6) | (uint32_t)(0U)),      
N    /* flags in STAT1 register */
N    USART_FLAG_BSY = USART_REGIDX_BIT(USART_STAT1_REG_OFFSET, 16U),     /*!< busy flag */
X    USART_FLAG_BSY = (((uint32_t)(0x88U) << 6) | (uint32_t)(16U)),      
N    USART_FLAG_EB = USART_REGIDX_BIT(USART_STAT1_REG_OFFSET, 12U),      /*!< end of block flag */
X    USART_FLAG_EB = (((uint32_t)(0x88U) << 6) | (uint32_t)(12U)),       
N    USART_FLAG_RT = USART_REGIDX_BIT(USART_STAT1_REG_OFFSET, 11U),      /*!< receiver timeout flag */
X    USART_FLAG_RT = (((uint32_t)(0x88U) << 6) | (uint32_t)(11U)),       
N    /* flags in CHC register */
N    USART_FLAG_EPERR = USART_REGIDX_BIT(USART_CHC_REG_OFFSET, 8U),      /*!< early parity error flag */
X    USART_FLAG_EPERR = (((uint32_t)(0xC0U) << 6) | (uint32_t)(8U)),       
N}usart_flag_enum;
N
N/* USART interrupt flags */
Ntypedef enum
N{
N    /* interrupt flags in CTL0 register */
N    USART_INT_FLAG_PERR = USART_REGIDX_BIT2(USART_CTL0_REG_OFFSET, 8U, USART_STAT0_REG_OFFSET, 0U),       /*!< parity error interrupt and flag */
X    USART_INT_FLAG_PERR = (((uint32_t)(0x00U) << 22) | (uint32_t)((0U) << 16) | (((uint32_t)(0x0CU) << 6) | (uint32_t)(8U))),        
N    USART_INT_FLAG_TBE = USART_REGIDX_BIT2(USART_CTL0_REG_OFFSET, 7U, USART_STAT0_REG_OFFSET, 7U),        /*!< transmitter buffer empty interrupt and flag */
X    USART_INT_FLAG_TBE = (((uint32_t)(0x00U) << 22) | (uint32_t)((7U) << 16) | (((uint32_t)(0x0CU) << 6) | (uint32_t)(7U))),         
N    USART_INT_FLAG_TC = USART_REGIDX_BIT2(USART_CTL0_REG_OFFSET, 6U, USART_STAT0_REG_OFFSET, 6U),         /*!< transmission complete interrupt and flag */
X    USART_INT_FLAG_TC = (((uint32_t)(0x00U) << 22) | (uint32_t)((6U) << 16) | (((uint32_t)(0x0CU) << 6) | (uint32_t)(6U))),          
N    USART_INT_FLAG_RBNE = USART_REGIDX_BIT2(USART_CTL0_REG_OFFSET, 5U, USART_STAT0_REG_OFFSET, 5U),       /*!< read data buffer not empty interrupt and flag */
X    USART_INT_FLAG_RBNE = (((uint32_t)(0x00U) << 22) | (uint32_t)((5U) << 16) | (((uint32_t)(0x0CU) << 6) | (uint32_t)(5U))),        
N    USART_INT_FLAG_RBNE_ORERR = USART_REGIDX_BIT2(USART_CTL0_REG_OFFSET, 5U, USART_STAT0_REG_OFFSET, 3U), /*!< read data buffer not empty interrupt and overrun error flag */
X    USART_INT_FLAG_RBNE_ORERR = (((uint32_t)(0x00U) << 22) | (uint32_t)((3U) << 16) | (((uint32_t)(0x0CU) << 6) | (uint32_t)(5U))),  
N    USART_INT_FLAG_IDLE = USART_REGIDX_BIT2(USART_CTL0_REG_OFFSET, 4U, USART_STAT0_REG_OFFSET, 4U),       /*!< IDLE line detected interrupt and flag */
X    USART_INT_FLAG_IDLE = (((uint32_t)(0x00U) << 22) | (uint32_t)((4U) << 16) | (((uint32_t)(0x0CU) << 6) | (uint32_t)(4U))),        
N    /* interrupt flags in CTL1 register */
N    USART_INT_FLAG_LBD = USART_REGIDX_BIT2(USART_CTL1_REG_OFFSET, 6U, USART_STAT0_REG_OFFSET, 8U),        /*!< LIN break detected interrupt and flag */
X    USART_INT_FLAG_LBD = (((uint32_t)(0x00U) << 22) | (uint32_t)((8U) << 16) | (((uint32_t)(0x10U) << 6) | (uint32_t)(6U))),         
N    /* interrupt flags in CTL2 register */
N    USART_INT_FLAG_CTS = USART_REGIDX_BIT2(USART_CTL2_REG_OFFSET, 10U, USART_STAT0_REG_OFFSET, 9U),       /*!< CTS interrupt and flag */
X    USART_INT_FLAG_CTS = (((uint32_t)(0x00U) << 22) | (uint32_t)((9U) << 16) | (((uint32_t)(0x14U) << 6) | (uint32_t)(10U))),        
N    USART_INT_FLAG_ERR_ORERR = USART_REGIDX_BIT2(USART_CTL2_REG_OFFSET, 0U, USART_STAT0_REG_OFFSET, 3U),  /*!< error interrupt and overrun error */
X    USART_INT_FLAG_ERR_ORERR = (((uint32_t)(0x00U) << 22) | (uint32_t)((3U) << 16) | (((uint32_t)(0x14U) << 6) | (uint32_t)(0U))),   
N    USART_INT_FLAG_ERR_NERR = USART_REGIDX_BIT2(USART_CTL2_REG_OFFSET, 0U, USART_STAT0_REG_OFFSET, 2U),   /*!< error interrupt and noise error flag */
X    USART_INT_FLAG_ERR_NERR = (((uint32_t)(0x00U) << 22) | (uint32_t)((2U) << 16) | (((uint32_t)(0x14U) << 6) | (uint32_t)(0U))),    
N    USART_INT_FLAG_ERR_FERR = USART_REGIDX_BIT2(USART_CTL2_REG_OFFSET, 0U, USART_STAT0_REG_OFFSET, 1U),   /*!< error interrupt and frame error flag */
X    USART_INT_FLAG_ERR_FERR = (((uint32_t)(0x00U) << 22) | (uint32_t)((1U) << 16) | (((uint32_t)(0x14U) << 6) | (uint32_t)(0U))),    
N    /* interrupt flags in CTL3 register */
N    USART_INT_FLAG_EB = USART_REGIDX_BIT2(USART_CTL3_REG_OFFSET, 5U, USART_STAT1_REG_OFFSET, 12U),        /*!< interrupt enable bit of end of block event and flag */
X    USART_INT_FLAG_EB = (((uint32_t)(0x88U) << 22) | (uint32_t)((12U) << 16) | (((uint32_t)(0x80U) << 6) | (uint32_t)(5U))),         
N    USART_INT_FLAG_RT = USART_REGIDX_BIT2(USART_CTL3_REG_OFFSET, 4U, USART_STAT1_REG_OFFSET, 11U),        /*!< interrupt enable bit of receive timeout event and flag */
X    USART_INT_FLAG_RT = (((uint32_t)(0x88U) << 22) | (uint32_t)((11U) << 16) | (((uint32_t)(0x80U) << 6) | (uint32_t)(4U))),         
N}usart_interrupt_flag_enum;
N
N/* USART interrupt flags */
Ntypedef enum
N{
N    /* interrupt in CTL0 register */
N    USART_INT_PERR = USART_REGIDX_BIT(USART_CTL0_REG_OFFSET, 8U),      /*!< parity error interrupt */
X    USART_INT_PERR = (((uint32_t)(0x0CU) << 6) | (uint32_t)(8U)),       
N    USART_INT_TBE = USART_REGIDX_BIT(USART_CTL0_REG_OFFSET, 7U),       /*!< transmitter buffer empty interrupt */
X    USART_INT_TBE = (((uint32_t)(0x0CU) << 6) | (uint32_t)(7U)),        
N    USART_INT_TC = USART_REGIDX_BIT(USART_CTL0_REG_OFFSET, 6U),        /*!< transmission complete interrupt */
X    USART_INT_TC = (((uint32_t)(0x0CU) << 6) | (uint32_t)(6U)),         
N    USART_INT_RBNE = USART_REGIDX_BIT(USART_CTL0_REG_OFFSET, 5U),      /*!< read data buffer not empty interrupt and overrun error interrupt */
X    USART_INT_RBNE = (((uint32_t)(0x0CU) << 6) | (uint32_t)(5U)),       
N    USART_INT_IDLE = USART_REGIDX_BIT(USART_CTL0_REG_OFFSET, 4U),      /*!< IDLE line detected interrupt */
X    USART_INT_IDLE = (((uint32_t)(0x0CU) << 6) | (uint32_t)(4U)),       
N    /* interrupt in CTL1 register */
N    USART_INT_LBD = USART_REGIDX_BIT(USART_CTL1_REG_OFFSET, 6U),       /*!< LIN break detected interrupt */
X    USART_INT_LBD = (((uint32_t)(0x10U) << 6) | (uint32_t)(6U)),        
N    /* interrupt in CTL2 register */
N    USART_INT_CTS = USART_REGIDX_BIT(USART_CTL2_REG_OFFSET, 10U),      /*!< CTS interrupt */
X    USART_INT_CTS = (((uint32_t)(0x14U) << 6) | (uint32_t)(10U)),       
N    USART_INT_ERR = USART_REGIDX_BIT(USART_CTL2_REG_OFFSET, 0U),       /*!< error interrupt */
X    USART_INT_ERR = (((uint32_t)(0x14U) << 6) | (uint32_t)(0U)),        
N    /* interrupt in CTL3 register */
N    USART_INT_EB = USART_REGIDX_BIT(USART_CTL3_REG_OFFSET, 5U),        /*!< interrupt enable bit of end of block event */
X    USART_INT_EB = (((uint32_t)(0x80U) << 6) | (uint32_t)(5U)),         
N    USART_INT_RT = USART_REGIDX_BIT(USART_CTL3_REG_OFFSET, 4U),        /*!< interrupt enable bit of receive timeout event */
X    USART_INT_RT = (((uint32_t)(0x80U) << 6) | (uint32_t)(4U)),         
N}usart_interrupt_enum;
N
N/* USART invert configure */
Ntypedef enum
N{
N    /* data bit level inversion */
N    USART_DINV_ENABLE,                             /*!< data bit level inversion */
N    USART_DINV_DISABLE,                            /*!< data bit level not inversion */
N    /* TX pin level inversion */
N    USART_TXPIN_ENABLE,                            /*!< TX pin level inversion */
N    USART_TXPIN_DISABLE,                           /*!< TX pin level not inversion */
N    /* RX pin level inversion */
N    USART_RXPIN_ENABLE,                            /*!< RX pin level inversion */
N    USART_RXPIN_DISABLE,                           /*!< RX pin level not inversion */
N}usart_invert_enum;
N
N/* USART receiver configure */
N#define CTL0_REN(regval)              (BIT(2) & ((uint32_t)(regval) << 2))
N#define USART_RECEIVE_ENABLE          CTL0_REN(1)                      /*!< enable receiver */
N#define USART_RECEIVE_DISABLE         CTL0_REN(0)                      /*!< disable receiver */
N
N/* USART transmitter configure */
N#define CTL0_TEN(regval)              (BIT(3) & ((uint32_t)(regval) << 3))
N#define USART_TRANSMIT_ENABLE         CTL0_TEN(1)                      /*!< enable transmitter */
N#define USART_TRANSMIT_DISABLE        CTL0_TEN(0)                      /*!< disable transmitter */
N
N/* USART parity bits definitions */
N#define CTL0_PM(regval)               (BITS(9,10) & ((uint32_t)(regval) << 9))
N#define USART_PM_NONE                 CTL0_PM(0)                       /*!< no parity */
N#define USART_PM_EVEN                 CTL0_PM(2)                       /*!< even parity */
N#define USART_PM_ODD                  CTL0_PM(3)                       /*!< odd parity */
N
N/* USART wakeup method in mute mode */
N#define CTL0_WM(regval)               (BIT(11) & ((uint32_t)(regval) << 11))
N#define USART_WM_IDLE                 CTL0_WM(0)                       /*!< idle Line */
N#define USART_WM_ADDR                 CTL0_WM(1)                       /*!< address mask */
N
N/* USART word length definitions */
N#define CTL0_WL(regval)               (BIT(12) & ((uint32_t)(regval) << 12))
N#define USART_WL_8BIT                 CTL0_WL(0)                       /*!< 8 bits */
N#define USART_WL_9BIT                 CTL0_WL(1)                       /*!< 9 bits */
N
N/* USART oversampling mode definitions */
N#define CTL0_OVSMOD(regval)           (BIT(15) & ((uint32_t)(regval) << 15))
N#define USART_OVSMOD_16               CTL0_OVSMOD(0)                   /*!< 16 bits */
N#define USART_OVSMOD_8                CTL0_OVSMOD(1)                   /*!< 8 bits */
N
N/* USART stop bits definitions */
N#define CTL1_STB(regval)              (BITS(12,13) & ((uint32_t)(regval) << 12))
N#define USART_STB_1BIT                CTL1_STB(0)                      /*!< 1 bit */
N#define USART_STB_0_5BIT              CTL1_STB(1)                      /*!< 0.5 bit */
N#define USART_STB_2BIT                CTL1_STB(2)                      /*!< 2 bits */
N#define USART_STB_1_5BIT              CTL1_STB(3)                      /*!< 1.5 bits */
N
N/* USART LIN break frame length */
N#define CTL1_LBLEN(regval)            (BIT(5) & ((uint32_t)(regval) << 5))
N#define USART_LBLEN_10B               CTL1_LBLEN(0)                    /*!< 10 bits */
N#define USART_LBLEN_11B               CTL1_LBLEN(1)                    /*!< 11 bits */
N
N/* USART CK length */
N#define CTL1_CLEN(regval)             (BIT(8) & ((uint32_t)(regval) << 8))
N#define USART_CLEN_NONE               CTL1_CLEN(0)                     /*!< there are 7 CK pulses for an 8 bit frame and 8 CK pulses for a 9 bit frame */
N#define USART_CLEN_EN                 CTL1_CLEN(1)                     /*!< there are 8 CK pulses for an 8 bit frame and 9 CK pulses for a 9 bit frame */
N
N/* USART clock phase */
N#define CTL1_CPH(regval)              (BIT(9) & ((uint32_t)(regval) << 9))
N#define USART_CPH_1CK                 CTL1_CPH(0)                      /*!< first clock transition is the first data capture edge */
N#define USART_CPH_2CK                 CTL1_CPH(1)                      /*!< second clock transition is the first data capture edge */
N
N/* USART clock polarity */
N#define CTL1_CPL(regval)              (BIT(10) & ((uint32_t)(regval) << 10))
N#define USART_CPL_LOW                 CTL1_CPL(0)                      /*!< steady low value on CK pin */
N#define USART_CPL_HIGH                CTL1_CPL(1)                      /*!< steady high value on CK pin */
N
N/* USART DMA request for receive configure */
N#define CLT2_DENR(regval)             (BIT(6) & ((uint32_t)(regval) << 6))
N#define USART_DENR_ENABLE             CLT2_DENR(1)                     /*!< DMA request enable for reception */
N#define USART_DENR_DISABLE            CLT2_DENR(0)                     /*!< DMA request disable for reception */
N
N/* USART DMA request for transmission configure */
N#define CLT2_DENT(regval)             (BIT(7) & ((uint32_t)(regval) << 7))
N#define USART_DENT_ENABLE             CLT2_DENT(1)                     /*!< DMA request enable for transmission */
N#define USART_DENT_DISABLE            CLT2_DENT(0)                     /*!< DMA request disable for transmission */
N
N/* USART RTS configure */
N#define CLT2_RTSEN(regval)            (BIT(8) & ((uint32_t)(regval) << 8))
N#define USART_RTS_ENABLE              CLT2_RTSEN(1)                    /*!< RTS enable */
N#define USART_RTS_DISABLE             CLT2_RTSEN(0)                    /*!< RTS disable */
N
N/* USART CTS configure */
N#define CLT2_CTSEN(regval)            (BIT(9) & ((uint32_t)(regval) << 9))
N#define USART_CTS_ENABLE              CLT2_CTSEN(1)                    /*!< CTS enable */
N#define USART_CTS_DISABLE             CLT2_CTSEN(0)                    /*!< CTS disable */
N
N/* USART one sample bit method configure */
N#define CTL2_OSB(regval)              (BIT(11) & ((uint32_t)(regval) << 11))
N#define USART_OSB_1bit                CTL2_OSB(1)                      /*!< 1 bit */
N#define USART_OSB_3bit                CTL2_OSB(0)                      /*!< 3 bits */
N
N/* USART IrDA low-power enable */
N#define CTL2_IRLP(regval)             (BIT(2) & ((uint32_t)(regval) << 2))
N#define USART_IRLP_LOW                CTL2_IRLP(1)                     /*!< low-power */
N#define USART_IRLP_NORMAL             CTL2_IRLP(0)                     /*!< normal */
N
N/* USART data is transmitted/received with the LSB/MSB first */
N#define CTL3_MSBF(regval)             (BIT(11) & ((uint32_t)(regval) << 11))
N#define USART_MSBF_LSB                CTL3_MSBF(0)                     /*!< LSB first */
N#define USART_MSBF_MSB                CTL3_MSBF(1)                     /*!< MSB first */
N
N/* break frame coherence mode */
N#define CHC_BCM(regval)               (BIT(2) & ((uint32_t)(regval) << 2))
N#define USART_BCM_NONE                CHC_BCM(0)                       /*!< no parity error is detected */
N#define USART_BCM_EN                  CHC_BCM(1)                       /*!< parity error is detected */
N
N/* USART parity check coherence mode */
N#define CHC_PCM(regval)               (BIT(1) & ((uint32_t)(regval) << 1))
N#define USART_PCM_NONE                CHC_PCM(0)                       /*!< not check parity */
N#define USART_PCM_EN                  CHC_PCM(1)                       /*!< check the parity */
N
N/* USART hardware flow control coherence mode */
N#define CHC_HCM(regval)               (BIT(0) & ((uint32_t)(regval) << 0))
N#define USART_HCM_NONE                CHC_HCM(0)                       /*!< nRTS signal equals to the rxne status register */
N#define USART_HCM_EN                  CHC_HCM(1)                       /*!< nRTS signal is set when the last data bit has been sampled */
N
N/* function declarations */
N/* initialization functions */
N/* reset USART */
Nvoid usart_deinit(uint32_t usart_periph);
N/* configure usart baud rate value */
Nvoid usart_baudrate_set(uint32_t usart_periph, uint32_t baudval);
N/* configure usart parity function */
Nvoid usart_parity_config(uint32_t usart_periph, uint32_t paritycfg);
N/* configure usart word length */
Nvoid usart_word_length_set(uint32_t usart_periph, uint32_t wlen);
N/* configure usart stop bit length */
Nvoid usart_stop_bit_set(uint32_t usart_periph, uint32_t stblen);
N/* enable usart */
Nvoid usart_enable(uint32_t usart_periph);
N/* disable usart */
Nvoid usart_disable(uint32_t usart_periph);
N/* configure USART transmitter */
Nvoid usart_transmit_config(uint32_t usart_periph, uint32_t txconfig);
N/* configure USART receiver */
Nvoid usart_receive_config(uint32_t usart_periph, uint32_t rxconfig);
N
N/* USART normal mode communication */
N/* data is transmitted/received with the LSB/MSB first */
Nvoid usart_data_first_config(uint32_t usart_periph, uint32_t msbf);
N/* configure USART inverted */
Nvoid usart_invert_config(uint32_t usart_periph, usart_invert_enum invertpara);
N/* configure the USART oversample mode */
Nvoid usart_oversample_config(uint32_t usart_periph, uint32_t oversamp);
N/* configure sample bit method */
Nvoid usart_sample_bit_config(uint32_t usart_periph, uint32_t obsm);
N/* enable receiver timeout */
Nvoid usart_receiver_timeout_enable(uint32_t usart_periph);
N/* disable receiver timeout */
Nvoid usart_receiver_timeout_disable(uint32_t usart_periph);
N/* configure receiver timeout threshold */
Nvoid usart_receiver_timeout_threshold_config(uint32_t usart_periph, uint32_t rtimeout);
N/* USART transmit data function */
Nvoid usart_data_transmit(uint32_t usart_periph, uint32_t data);
N/* USART receive data function */
Nuint16_t usart_data_receive(uint32_t usart_periph);
N
N/* multi-processor communication */
N/* configure address of the USART */
Nvoid usart_address_config(uint32_t usart_periph, uint8_t addr);
N/* enable mute mode */
Nvoid usart_mute_mode_enable(uint32_t usart_periph);
N/* disable mute mode */
Nvoid usart_mute_mode_disable(uint32_t usart_periph);
N/* configure wakeup method in mute mode */
Nvoid usart_mute_mode_wakeup_config(uint32_t usart_periph, uint32_t wmehtod);
N
N/* LIN mode communication */
N/* enable LIN mode */
Nvoid usart_lin_mode_enable(uint32_t usart_periph);
N/* disable LIN mode */
Nvoid usart_lin_mode_disable(uint32_t usart_periph);
N/* LIN break detection length */
Nvoid usart_lin_break_detection_length_config(uint32_t usart_periph, uint32_t lblen);
N/* send break frame */
Nvoid usart_send_break(uint32_t usart_periph);
N
N/* half-duplex communication */
N/* enable half-duplex mode */
Nvoid usart_halfduplex_enable(uint32_t usart_periph);
N/* disable half-duplex mode */
Nvoid usart_halfduplex_disable(uint32_t usart_periph);
N
N/* synchronous communication */
N/* enable CK pin in synchronous mode */
Nvoid usart_synchronous_clock_enable(uint32_t usart_periph);
N/* disable CK pin in synchronous mode */
Nvoid usart_synchronous_clock_disable(uint32_t usart_periph);
N/* configure usart synchronous mode parameters */
Nvoid usart_synchronous_clock_config(uint32_t usart_periph, uint32_t clen, uint32_t cph, uint32_t cpl);
N
N/* smartcard communication */
N/* configure guard time value in smartcard mode */
Nvoid usart_guard_time_config(uint32_t usart_periph, uint32_t guat);
N/* enable smartcard mode */
Nvoid usart_smartcard_mode_enable(uint32_t usart_periph);
N/* disable smartcard mode */
Nvoid usart_smartcard_mode_disable(uint32_t usart_periph);
N/* enable NACK in smartcard mode */
Nvoid usart_smartcard_mode_nack_enable(uint32_t usart_periph);
N/* disable NACK in smartcard mode */
Nvoid usart_smartcard_mode_nack_disable(uint32_t usart_periph);
N/* configure smartcard auto-retry number */
Nvoid usart_smartcard_autoretry_config(uint32_t usart_periph, uint32_t scrtnum);
N/* configure block length */
Nvoid usart_block_length_config(uint32_t usart_periph, uint32_t bl);
N
N/* IrDA communication */
N/* enable IrDA mode */
Nvoid usart_irda_mode_enable(uint32_t usart_periph);
N/* disable IrDA mode */
Nvoid usart_irda_mode_disable(uint32_t usart_periph);
N/* configure the peripheral clock prescaler */
Nvoid usart_prescaler_config(uint32_t usart_periph, uint8_t psc);
N/* configure IrDA low-power */
Nvoid usart_irda_lowpower_config(uint32_t usart_periph, uint32_t irlp);
N
N/* hardware flow communication */
N/* configure hardware flow control RTS */
Nvoid usart_hardware_flow_rts_config(uint32_t usart_periph, uint32_t rtsconfig);
N/* configure hardware flow control CTS */
Nvoid usart_hardware_flow_cts_config(uint32_t usart_periph, uint32_t ctsconfig);
N
N/* coherence control */
N/* configure break frame coherence mode */
Nvoid usart_break_frame_coherence_config(uint32_t usart_periph, uint32_t bcm);
N/* configure parity check coherence mode */
Nvoid usart_parity_check_coherence_config(uint32_t usart_periph, uint32_t pcm);
N/* configure hardware flow control coherence mode */
Nvoid usart_hardware_flow_coherence_config(uint32_t usart_periph, uint32_t hcm);
N
N/* DMA communication */
N/* configure USART DMA for reception */
Nvoid usart_dma_receive_config(uint32_t usart_periph, uint32_t dmacmd);
N/* configure USART DMA for transmission */
Nvoid usart_dma_transmit_config(uint32_t usart_periph, uint32_t dmacmd);
N
N/* flag & interrupt functions */
N/* get flag in STAT0/STAT1 register */
NFlagStatus usart_flag_get(uint32_t usart_periph, usart_flag_enum flag);
N/* clear flag in STAT0/STAT1 register */
Nvoid usart_flag_clear(uint32_t usart_periph, usart_flag_enum flag);
N/* enable USART interrupt */
Nvoid usart_interrupt_enable(uint32_t usart_periph, usart_interrupt_enum interrupt);
N/* disable USART interrupt */
Nvoid usart_interrupt_disable(uint32_t usart_periph, usart_interrupt_enum interrupt);
N/* get USART interrupt and flag status */
NFlagStatus usart_interrupt_flag_get(uint32_t usart_periph, usart_interrupt_flag_enum int_flag);
N/* clear interrupt flag in STAT0/STAT1 register */
Nvoid usart_interrupt_flag_clear(uint32_t usart_periph, usart_interrupt_flag_enum int_flag);
N
N#endif /* GD32F4XX_USART_H */ 
