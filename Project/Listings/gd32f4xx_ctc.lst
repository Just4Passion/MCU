Nvoid iref_deinit(void);
N/* enable IREF */
Nvoid iref_enable(void);
N/* disable IREF */
Nvoid iref_disable(void);
N
N/* set IREF mode*/
Nvoid iref_mode_set(uint32_t step);
N/* set IREF sink current mode*/
Nvoid iref_sink_set(uint32_t sinkmode);
N/* set IREF current precision trim value */
Nvoid iref_precision_trim_value_set(uint32_t precisiontrim);
N/* set IREF step data*/
Nvoid iref_step_data_config(uint32_t stepdata);
N
