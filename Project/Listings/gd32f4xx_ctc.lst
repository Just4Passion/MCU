N#define RCU_APB2SPEN_ADC0SPEN           BIT(8)                    /*!< ADC0 clock enable when sleep mode */
N#define RCU_APB2SPEN_ADC1SPEN           BIT(9)                    /*!< ADC1 clock enable when sleep mode */
N#define RCU_APB2SPEN_ADC2SPEN           BIT(10)                   /*!< ADC2 clock enable when sleep mode */
N#define RCU_APB2SPEN_SDIOSPEN           BIT(11)                   /*!< SDIO clock enable when sleep mode */
N#define RCU_APB2SPEN_SPI0SPEN           BIT(12)                   /*!< SPI0 clock enable when sleep mode */
N#define RCU_APB2SPEN_SPI3SPEN           BIT(13)                   /*!< SPI3 clock enable when sleep mode */
N#define RCU_APB2SPEN_SYSCFGSPEN         BIT(14)                   /*!< SYSCFG clock enable when sleep mode */
N#define RCU_APB2SPEN_TIMER8SPEN         BIT(16)                   /*!< TIMER8 clock enable when sleep mode */
N#define RCU_APB2SPEN_TIMER9SPEN         BIT(17)                   /*!< TIMER9 clock enable when sleep mode */
N#define RCU_APB2SPEN_TIMER10SPEN        BIT(18)                   /*!< TIMER10 clock enable when sleep mode */
N#define RCU_APB2SPEN_SPI4SPEN           BIT(20)                   /*!< SPI4 clock enable when sleep mode */
N#define RCU_APB2SPEN_SPI5SPEN           BIT(21)                   /*!< SPI5 clock enable when sleep mode */
N#define RCU_APB2SPEN_TLISPEN            BIT(26)                   /*!< TLI clock enable when sleep mode*/
N
N/* RCU_BDCTL */
N#define RCU_BDCTL_LXTALEN               BIT(0)                    /*!< LXTAL enable */
N#define RCU_BDCTL_LXTALSTB              BIT(1)                    /*!< low speed crystal oscillator stabilization flag */
N#define RCU_BDCTL_LXTALBPS              BIT(2)                    /*!< LXTAL bypass mode enable */
N#define RCU_BDCTL_LXTALDRI              BIT(3)                    /*!< LXTAL drive capability */
N#define RCU_BDCTL_RTCSRC                BITS(8,9)                 /*!< RTC clock entry selection */
N#define RCU_BDCTL_RTCEN                 BIT(15)                   /*!< RTC clock enable */
N#define RCU_BDCTL_BKPRST                BIT(16)                   /*!< backup domain reset */
N
N/* RCU_RSTSCK */
N#define RCU_RSTSCK_IRC32KEN             BIT(0)                    /*!< IRC32K enable */
N#define RCU_RSTSCK_IRC32KSTB            BIT(1)                    /*!< IRC32K stabilization flag */
N#define RCU_RSTSCK_RSTFC                BIT(24)                   /*!< reset flag clear */
N#define RCU_RSTSCK_BORRSTF              BIT(25)                   /*!< BOR reset flag */
N#define RCU_RSTSCK_EPRSTF               BIT(26)                   /*!< external pin reset flag */
N#define RCU_RSTSCK_PORRSTF              BIT(27)                   /*!< power reset flag */
N#define RCU_RSTSCK_SWRSTF               BIT(28)                   /*!< software reset flag */
N#define RCU_RSTSCK_FWDGTRSTF            BIT(29)                   /*!< free watchdog timer reset flag */
N#define RCU_RSTSCK_WWDGTRSTF            BIT(30)                   /*!< window watchdog timer reset flag */
N#define RCU_RSTSCK_LPRSTF               BIT(31)                   /*!< low-power reset flag */
N
N/* RCU_PLLSSCTL */
N#define RCU_PLLSSCTL_MODCNT             BITS(0,12)                /*!< these bits configure PLL spread spectrum modulation 
N                                                                       profile amplitude and frequency. the following criteria 
N                                                                       must be met: MODSTEP*MODCNT=215-1 */
N#define RCU_PLLSSCTL_MODSTEP            BITS(13,27)               /*!< these bits configure PLL spread spectrum modulation 
N                                                                       profile amplitude and frequency. the following criteria 
N                                                                       must be met: MODSTEP*MODCNT=215-1 */
N#define RCU_PLLSSCTL_SS_TYPE            BIT(30)                   /*!< PLL spread spectrum modulation type select */
N#define RCU_PLLSSCTL_SSCGON             BIT(31)                   /*!< PLL spread spectrum modulation enable */
N
N/* RCU_PLLI2S */
N#define RCU_PLLI2S_PLLI2SN              BITS(6,14)                /*!< the PLLI2S VCO clock multi factor */
N#define RCU_PLLI2S_PLLI2SQ              BITS(24,27)               /*!< the PLLI2S Q output frequency division factor from PLLI2S VCO clock */
N#define RCU_PLLI2S_PLLI2SR              BITS(28,30)               /*!< the PLLI2S R output frequency division factor from PLLI2S VCO clock */
N
N/* RCU_PLLSAI */
N#define RCU_PLLSAI_PLLSAIN              BITS(6,14)                /*!< the PLLSAI VCO clock multi factor */
N#define RCU_PLLSAI_PLLSAIP              BITS(16,17)               /*!< the PLLSAI P output frequency division factor from PLLSAI VCO clock */
N#define RCU_PLLSAI_PLLSAIQ              BITS(24,27)               /*!< the PLLSAI Q output frequency division factor from PLLSAI VCO clock */
N#define RCU_PLLSAI_PLLSAIR              BITS(28,30)               /*!< the PLLSAI R output frequency division factor from PLLSAI VCO clock */
N
N/* RCU_CFG1 */
N#define RCU_CFG1_PLLSAIRDIV             BITS(16,17)               /*!< the divider factor from PLLSAIR clock */
N#define RCU_CFG1_TIMERSEL               BIT(24)                   /*!< TIMER clock selection */
N
N/* RCU_ADDCTL */
N#define RCU_ADDCTL_CK48MSEL             BIT(0)                    /*!< 48MHz clock selection */
N#define RCU_ADDCTL_PLL48MSEL            BIT(1)                    /*!< PLL48M clock selection */
N#define RCU_ADDCTL_IRC48MEN             BIT(16)                   /*!< internal 48MHz RC oscillator enable */
N#define RCU_ADDCTL_IRC48MSTB            BIT(17)                   /*!< internal 48MHz RC oscillator clock stabilization flag */
N#define RCU_ADDCTL_IRC48MCAL            BITS(24,31)               /*!< internal 48MHz RC oscillator calibration value register */
N
N/* RCU_ADDINT */
N#define RCU_ADDINT_IRC48MSTBIF          BIT(6)                    /*!< IRC48M stabilization interrupt flag */
N#define RCU_ADDINT_IRC48MSTBIE          BIT(14)                   /*!< internal 48 MHz RC oscillator stabilization interrupt enable */
N#define RCU_ADDINT_IRC48MSTBIC          BIT(22)                   /*!< internal 48 MHz RC oscillator stabilization interrupt clear */
N
N/* RCU_ADDAPB1RST */
N#define RCU_ADDAPB1RST_CTCRST           BIT(27)                   /*!< CTC reset */
N#define RCU_ADDAPB1RST_IREFRST          BIT(31)                   /*!< IREF reset */
N
N/* RCU_ADDAPB1EN */
N#define RCU_ADDAPB1EN_CTCEN             BIT(27)                   /*!< CTC clock enable */
N#define RCU_ADDAPB1EN_IREFEN            BIT(31)                   /*!< IREF interface clock enable */
N
N/* RCU_ADDAPB1SPEN */
N#define RCU_ADDAPB1SPEN_CTCSPEN         BIT(27)                   /*!< CTC clock enable during sleep mode */
N#define RCU_ADDAPB1SPEN_IREFSPEN        BIT(31)                   /*!< IREF interface clock enable during sleep mode */
N
N/* RCU_VKEY */
N#define RCU_VKEY_KEY                    BITS(0,31)                /*!< RCU_DSV key register */
N
N/* RCU_DSV */
N#define RCU_DSV_DSLPVS                  BITS(0,2)                 /*!< deep-sleep mode voltage select */
N
N/* constants definitions */
N/* define the peripheral clock enable bit position and its register index offset */
N#define RCU_REGIDX_BIT(regidx, bitpos)      (((uint32_t)(regidx) << 6) | (uint32_t)(bitpos))
N#define RCU_REG_VAL(periph)                 (REG32(RCU + ((uint32_t)(periph) >> 6)))
N#define RCU_BIT_POS(val)                    ((uint32_t)(val) & 0x1FU)
N/* define the voltage key unlock value */
N#define RCU_VKEY_UNLOCK                 ((uint32_t)0x1A2B3C4DU)
N
N/* register offset */
N/* peripherals enable */
N#define AHB1EN_REG_OFFSET               0x30U                     /*!< AHB1 enable register offset */
N#define AHB2EN_REG_OFFSET               0x34U                     /*!< AHB2 enable register offset */
N#define AHB3EN_REG_OFFSET               0x38U                     /*!< AHB3 enable register offset */
N#define APB1EN_REG_OFFSET               0x40U                     /*!< APB1 enable register offset */
N#define APB2EN_REG_OFFSET               0x44U                     /*!< APB2 enable register offset */
N#define AHB1SPEN_REG_OFFSET             0x50U                     /*!< AHB1 sleep mode enable register offset */
N#define AHB2SPEN_REG_OFFSET             0x54U                     /*!< AHB2 sleep mode enable register offset */
N#define AHB3SPEN_REG_OFFSET             0x58U                     /*!< AHB3 sleep mode enable register offset */
N#define APB1SPEN_REG_OFFSET             0x60U                     /*!< APB1 sleep mode enable register offset */
N#define APB2SPEN_REG_OFFSET             0x64U                     /*!< APB2 sleep mode enable register offset */
N#define ADD_APB1EN_REG_OFFSET           0xE4U                     /*!< APB1 additional enable register offset */
N#define ADD_APB1SPEN_REG_OFFSET         0xE8U                     /*!< APB1 additional sleep mode enable register offset */
N
N/* peripherals reset */                                        
N#define AHB1RST_REG_OFFSET              0x10U                     /*!< AHB1 reset register offset */
N#define AHB2RST_REG_OFFSET              0x14U                     /*!< AHB2 reset register offset */
N#define AHB3RST_REG_OFFSET              0x18U                     /*!< AHB3 reset register offset */
N#define APB1RST_REG_OFFSET              0x20U                     /*!< APB1 reset register offset */
N#define APB2RST_REG_OFFSET              0x24U                     /*!< APB2 reset register offset */
N#define ADD_APB1RST_REG_OFFSET          0xE0U                     /*!< APB1 additional reset register offset */
N#define RSTSCK_REG_OFFSET               0x74U                     /*!< reset source/clock register offset */
N
N/* clock control */
N#define CTL_REG_OFFSET                  0x00U                     /*!< control register offset */
N#define BDCTL_REG_OFFSET                0x70U                     /*!< backup domain control register offset */
N#define ADDCTL_REG_OFFSET               0xC0U                     /*!< additional clock control register offset */
N
N/* clock stabilization and stuck interrupt */
N#define INT_REG_OFFSET                  0x0CU                     /*!< clock interrupt register offset */
N#define ADDINT_REG_OFFSET               0xCCU                     /*!< additional clock interrupt register offset */
N
N/* configuration register */
N#define PLL_REG_OFFSET                  0x04U                     /*!< PLL register offset */
N#define CFG0_REG_OFFSET                 0x08U                     /*!< clock configuration register 0 offset */
N#define PLLSSCTL_REG_OFFSET             0x80U                     /*!< PLL clock spread spectrum control register offset */
N#define PLLI2S_REG_OFFSET               0x84U                     /*!< PLLI2S register offset */
N#define PLLSAI_REG_OFFSET               0x88U                     /*!< PLLSAI register offset */
N#define CFG1_REG_OFFSET                 0x8CU                     /*!< clock configuration register 1 offset */
N
N/* peripheral clock enable */
Ntypedef enum
N{
N    /* AHB1 peripherals */
N    RCU_GPIOA     = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 0U),                  /*!< GPIOA clock */
X    RCU_GPIOA     = (((uint32_t)(0x30U) << 6) | (uint32_t)(0U)),                   
N    RCU_GPIOB     = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 1U),                  /*!< GPIOB clock */
X    RCU_GPIOB     = (((uint32_t)(0x30U) << 6) | (uint32_t)(1U)),                   
N    RCU_GPIOC     = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 2U),                  /*!< GPIOC clock */
X    RCU_GPIOC     = (((uint32_t)(0x30U) << 6) | (uint32_t)(2U)),                   
N    RCU_GPIOD     = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 3U),                  /*!< GPIOD clock */
X    RCU_GPIOD     = (((uint32_t)(0x30U) << 6) | (uint32_t)(3U)),                   
N    RCU_GPIOE     = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 4U),                  /*!< GPIOE clock */
X    RCU_GPIOE     = (((uint32_t)(0x30U) << 6) | (uint32_t)(4U)),                   
N    RCU_GPIOF     = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 5U),                  /*!< GPIOF clock */
X    RCU_GPIOF     = (((uint32_t)(0x30U) << 6) | (uint32_t)(5U)),                   
N    RCU_GPIOG     = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 6U),                  /*!< GPIOG clock */
X    RCU_GPIOG     = (((uint32_t)(0x30U) << 6) | (uint32_t)(6U)),                   
N    RCU_GPIOH     = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 7U),                  /*!< GPIOH clock */
X    RCU_GPIOH     = (((uint32_t)(0x30U) << 6) | (uint32_t)(7U)),                   
N    RCU_GPIOI     = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 8U),                  /*!< GPIOI clock */
X    RCU_GPIOI     = (((uint32_t)(0x30U) << 6) | (uint32_t)(8U)),                   
N    RCU_CRC       = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 12U),                 /*!< CRC clock */
X    RCU_CRC       = (((uint32_t)(0x30U) << 6) | (uint32_t)(12U)),                  
N    RCU_BKPSRAM   = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 18U),                 /*!< BKPSRAM clock */
X    RCU_BKPSRAM   = (((uint32_t)(0x30U) << 6) | (uint32_t)(18U)),                  
N    RCU_TCMSRAM   = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 20U),                 /*!< TCMSRAM clock */
X    RCU_TCMSRAM   = (((uint32_t)(0x30U) << 6) | (uint32_t)(20U)),                  
N    RCU_DMA0      = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 21U),                 /*!< DMA0 clock */
X    RCU_DMA0      = (((uint32_t)(0x30U) << 6) | (uint32_t)(21U)),                  
N    RCU_DMA1      = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 22U),                 /*!< DMA1 clock */
X    RCU_DMA1      = (((uint32_t)(0x30U) << 6) | (uint32_t)(22U)),                  
N    RCU_IPA       = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 23U),                 /*!< IPA clock */
X    RCU_IPA       = (((uint32_t)(0x30U) << 6) | (uint32_t)(23U)),                  
N    RCU_ENET      = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 25U),                 /*!< ENET clock */
X    RCU_ENET      = (((uint32_t)(0x30U) << 6) | (uint32_t)(25U)),                  
N    RCU_ENETTX    = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 26U),                 /*!< ENETTX clock */
X    RCU_ENETTX    = (((uint32_t)(0x30U) << 6) | (uint32_t)(26U)),                  
N    RCU_ENETRX    = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 27U),                 /*!< ENETRX clock */
X    RCU_ENETRX    = (((uint32_t)(0x30U) << 6) | (uint32_t)(27U)),                  
N    RCU_ENETPTP   = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 28U),                 /*!< ENETPTP clock */
X    RCU_ENETPTP   = (((uint32_t)(0x30U) << 6) | (uint32_t)(28U)),                  
N    RCU_USBHS     = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 29U),                 /*!< USBHS clock */
X    RCU_USBHS     = (((uint32_t)(0x30U) << 6) | (uint32_t)(29U)),                  
N    RCU_USBHSULPI = RCU_REGIDX_BIT(AHB1EN_REG_OFFSET, 30U),                 /*!< USBHSULPI clock */
X    RCU_USBHSULPI = (((uint32_t)(0x30U) << 6) | (uint32_t)(30U)),                  
N    /* AHB2 peripherals */
N    RCU_DCI       = RCU_REGIDX_BIT(AHB2EN_REG_OFFSET, 0U),                  /*!< DCI clock */
X    RCU_DCI       = (((uint32_t)(0x34U) << 6) | (uint32_t)(0U)),                   
N    RCU_TRNG      = RCU_REGIDX_BIT(AHB2EN_REG_OFFSET, 6U),                  /*!< TRNG clock */
X    RCU_TRNG      = (((uint32_t)(0x34U) << 6) | (uint32_t)(6U)),                   
N    RCU_USBFS     = RCU_REGIDX_BIT(AHB2EN_REG_OFFSET, 7U),                  /*!< USBFS clock */
X    RCU_USBFS     = (((uint32_t)(0x34U) << 6) | (uint32_t)(7U)),                   
N    /* AHB3 peripherals */
N    RCU_EXMC      = RCU_REGIDX_BIT(AHB3EN_REG_OFFSET, 0U),                  /*!< EXMC clock */
X    RCU_EXMC      = (((uint32_t)(0x38U) << 6) | (uint32_t)(0U)),                   
N    /* APB1 peripherals */
N    RCU_TIMER1    = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 0U),                  /*!< TIMER1 clock */
X    RCU_TIMER1    = (((uint32_t)(0x40U) << 6) | (uint32_t)(0U)),                   
N    RCU_TIMER2    = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 1U),                  /*!< TIMER2 clock */
X    RCU_TIMER2    = (((uint32_t)(0x40U) << 6) | (uint32_t)(1U)),                   
N    RCU_TIMER3    = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 2U),                  /*!< TIMER3 clock */
X    RCU_TIMER3    = (((uint32_t)(0x40U) << 6) | (uint32_t)(2U)),                   
N    RCU_TIMER4    = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 3U),                  /*!< TIMER4 clock */
X    RCU_TIMER4    = (((uint32_t)(0x40U) << 6) | (uint32_t)(3U)),                   
N    RCU_TIMER5    = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 4U),                  /*!< TIMER5 clock */
X    RCU_TIMER5    = (((uint32_t)(0x40U) << 6) | (uint32_t)(4U)),                   
N    RCU_TIMER6    = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 5U),                  /*!< TIMER6 clock */
X    RCU_TIMER6    = (((uint32_t)(0x40U) << 6) | (uint32_t)(5U)),                   
N    RCU_TIMER11   = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 6U),                  /*!< TIMER11 clock */
X    RCU_TIMER11   = (((uint32_t)(0x40U) << 6) | (uint32_t)(6U)),                   
N    RCU_TIMER12   = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 7U),                  /*!< TIMER12 clock */
X    RCU_TIMER12   = (((uint32_t)(0x40U) << 6) | (uint32_t)(7U)),                   
N    RCU_TIMER13   = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 8U),                  /*!< TIMER13 clock */   
X    RCU_TIMER13   = (((uint32_t)(0x40U) << 6) | (uint32_t)(8U)),                      
N    RCU_WWDGT     = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 11U),                 /*!< WWDGT clock */
X    RCU_WWDGT     = (((uint32_t)(0x40U) << 6) | (uint32_t)(11U)),                  
N    RCU_SPI1      = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 14U),                 /*!< SPI1 clock */
X    RCU_SPI1      = (((uint32_t)(0x40U) << 6) | (uint32_t)(14U)),                  
N    RCU_SPI2      = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 15U),                 /*!< SPI2 clock */
X    RCU_SPI2      = (((uint32_t)(0x40U) << 6) | (uint32_t)(15U)),                  
N    RCU_USART1    = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 17U),                 /*!< USART1 clock */
X    RCU_USART1    = (((uint32_t)(0x40U) << 6) | (uint32_t)(17U)),                  
N    RCU_USART2    = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 18U),                 /*!< USART2 clock */
X    RCU_USART2    = (((uint32_t)(0x40U) << 6) | (uint32_t)(18U)),                  
N    RCU_UART3     = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 19U),                 /*!< UART3 clock */
X    RCU_UART3     = (((uint32_t)(0x40U) << 6) | (uint32_t)(19U)),                  
N    RCU_UART4     = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 20U),                 /*!< UART4 clock */
X    RCU_UART4     = (((uint32_t)(0x40U) << 6) | (uint32_t)(20U)),                  
N    RCU_I2C0      = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 21U),                 /*!< I2C0 clock */
X    RCU_I2C0      = (((uint32_t)(0x40U) << 6) | (uint32_t)(21U)),                  
N    RCU_I2C1      = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 22U),                 /*!< I2C1 clock */
X    RCU_I2C1      = (((uint32_t)(0x40U) << 6) | (uint32_t)(22U)),                  
N    RCU_I2C2      = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 23U),                 /*!< I2C2 clock */   
X    RCU_I2C2      = (((uint32_t)(0x40U) << 6) | (uint32_t)(23U)),                     
N    RCU_CAN0      = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 25U),                 /*!< CAN0 clock */
X    RCU_CAN0      = (((uint32_t)(0x40U) << 6) | (uint32_t)(25U)),                  
N    RCU_CAN1      = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 26U),                 /*!< CAN1 clock */
X    RCU_CAN1      = (((uint32_t)(0x40U) << 6) | (uint32_t)(26U)),                  
N    RCU_PMU       = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 28U),                 /*!< PMU clock */
X    RCU_PMU       = (((uint32_t)(0x40U) << 6) | (uint32_t)(28U)),                  
N    RCU_DAC       = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 29U),                 /*!< DAC clock */
X    RCU_DAC       = (((uint32_t)(0x40U) << 6) | (uint32_t)(29U)),                  
N    RCU_UART6     = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 30U),                 /*!< UART6 clock */
X    RCU_UART6     = (((uint32_t)(0x40U) << 6) | (uint32_t)(30U)),                  
N    RCU_UART7     = RCU_REGIDX_BIT(APB1EN_REG_OFFSET, 31U),                 /*!< UART7 clock */
X    RCU_UART7     = (((uint32_t)(0x40U) << 6) | (uint32_t)(31U)),                  
N    RCU_RTC       = RCU_REGIDX_BIT(BDCTL_REG_OFFSET, 15U),                  /*!< RTC clock */
