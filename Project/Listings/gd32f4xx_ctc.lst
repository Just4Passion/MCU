X    interrupt_flag = (*(volatile uint32_t *)(uint32_t)(((((uint32_t)0x40000000U) + 0x00006C00U)) + 0x08U)) & int_flag;
N
N    if(interrupt_flag && intenable){
N        return SET;
N    }else{
N        return RESET;
N    }
N}
