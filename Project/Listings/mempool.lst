Nstruct rt_thread;
N
Ntypedef rt_uint8_t rt_sched_thread_status_t;
N
N/**
N * Scheduler private status binding on thread. Caller should never accessing
N * these members.
N */
Nstruct rt_sched_thread_priv
N{
N    rt_tick_t                   init_tick;              /**< thread's initialized tick */
N    rt_tick_t                   remaining_tick;         /**< remaining tick */
N
N    /* priority */
N    rt_uint8_t                  current_priority;       /**< current priority */
N    rt_uint8_t                  init_priority;          /**< initialized priority */
N#if RT_THREAD_PRIORITY_MAX > 32
X#if 32 > 32
S    rt_uint8_t                  number;                 /**< priority low number */
S    rt_uint8_t                  high_mask;              /**< priority high mask */
N#endif /* RT_THREAD_PRIORITY_MAX > 32 */
N    rt_uint32_t                 number_mask;            /**< priority number mask */
N
N};
N
N/**
N * Scheduler public status binding on thread. Caller must hold the scheduler
N * lock before access any one of its member.
N */
Nstruct rt_sched_thread_ctx
N{
N    rt_list_t                   thread_list_node;       /**< node in thread list */
N
N    rt_uint8_t                  stat;                   /**< thread status */
N    rt_uint8_t                  sched_flag_locked:1;    /**< calling thread have the scheduler locked */
N    rt_uint8_t                  sched_flag_ttmr_set:1;  /**< thread timer is start */
N
N#ifdef ARCH_USING_HW_THREAD_SELF
S    rt_uint8_t                  critical_switch_flag:1; /**< critical switch pending */
N#endif /* ARCH_USING_HW_THREAD_SELF */
N
N#ifdef RT_USING_SMP
S    rt_uint8_t                  bind_cpu;               /**< thread is bind to cpu */
S    rt_uint8_t                  oncpu;                  /**< process on cpu */
S
S    rt_base_t                   critical_lock_nest;     /**< critical lock count */
N#endif
N
N    struct rt_sched_thread_priv sched_thread_priv;      /**< private context of scheduler */
N};
N
N#define RT_SCHED_THREAD_CTX struct rt_sched_thread_ctx sched_thread_ctx;
N
N#define RT_SCHED_PRIV(thread) ((thread)->sched_thread_ctx.sched_thread_priv)
N#define RT_SCHED_CTX(thread) ((thread)->sched_thread_ctx)
N
N/**
N * Convert a list node in container RT_SCHED_CTX(thread)->thread_list_node
N * to a thread pointer.
N */
N#define RT_THREAD_LIST_NODE_ENTRY(node)                                      \
N    rt_container_of(                                                         \
N        rt_list_entry((node), struct rt_sched_thread_ctx, thread_list_node), \
N        struct rt_thread, sched_thread_ctx)
X#define RT_THREAD_LIST_NODE_ENTRY(node)                                          rt_container_of(                                                                 rt_list_entry((node), struct rt_sched_thread_ctx, thread_list_node),         struct rt_thread, sched_thread_ctx)
N#define RT_THREAD_LIST_NODE(thread) (RT_SCHED_CTX(thread).thread_list_node)
N
