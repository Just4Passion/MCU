N#ifndef GD32F4XX_DCI_H
N#define GD32F4XX_DCI_H
N
N#include "gd32f4xx.h"
N
N/* DCI definitions */
N#define DCI                       DCI_BASE
N
N/* registers definitions */
N#define DCI_CTL                   REG32(DCI + 0x00U) /*!< DCI control register */
N#define DCI_STAT0                 REG32(DCI + 0x04U) /*!< DCI status register 0 */
N#define DCI_STAT1                 REG32(DCI + 0x08U) /*!< DCI status register 1 */
N#define DCI_INTEN                 REG32(DCI + 0x0CU) /*!< DCI interrupt enable register */
N#define DCI_INTF                  REG32(DCI + 0x10U) /*!< DCI interrupt flag register */
N#define DCI_INTC                  REG32(DCI + 0x14U) /*!< DCI interrupt clear register */
N#define DCI_SC                    REG32(DCI + 0x18U) /*!< DCI synchronization codes register */
N#define DCI_SCUMSK                REG32(DCI + 0x1CU) /*!< DCI synchronization codes unmask register */
N#define DCI_CWSPOS                REG32(DCI + 0x20U) /*!< DCI cropping window start position register */
N#define DCI_CWSZ                  REG32(DCI + 0x24U) /*!< DCI cropping window size register */
N#define DCI_DATA                  REG32(DCI + 0x28U) /*!< DCI data register */
N
N/* bits definitions */
N/* DCI_CTL */
N#define DCI_CTL_CAP               BIT(0)             /*!< capture enable */
N#define DCI_CTL_SNAP              BIT(1)             /*!< snapshot mode */
N#define DCI_CTL_WDEN              BIT(2)             /*!< window enable */
N#define DCI_CTL_JM                BIT(3)             /*!< JPEG mode */
N#define DCI_CTL_ESM               BIT(4)             /*!< embedded synchronous mode */
N#define DCI_CTL_CKS               BIT(5)             /*!< clock polarity selection */
N#define DCI_CTL_HPS               BIT(6)             /*!< horizontal polarity selection */
N#define DCI_CTL_VPS               BIT(7)             /*!< vertical polarity selection */
N#define DCI_CTL_FR                BITS(8,9)          /*!< frame rate */
N#define DCI_CTL_DCIF              BITS(10,11)        /*!< digital camera interface format */
N#define DCI_CTL_DCIEN             BIT(14)            /*!< DCI enable */
N
N/* DCI_STAT0 */
N#define DCI_STAT0_HS              BIT(0)            /*!< HS line status */
N#define DCI_STAT0_VS              BIT(1)            /*!< VS line status */
N#define DCI_STAT0_FV              BIT(2)            /*!< FIFO valid */
N
N/* DCI_STAT1 */
N#define DCI_STAT1_EFF             BIT(0)            /*!< end of frame flag */
N#define DCI_STAT1_OVRF            BIT(1)            /*!< FIFO overrun flag */
N#define DCI_STAT1_ESEF            BIT(2)            /*!< embedded synchronous error flag */
N#define DCI_STAT1_VSF             BIT(3)            /*!< vsync flag */
N#define DCI_STAT1_ELF             BIT(4)            /*!< end of line flag */
N
N/* DCI_INTEN */
N#define DCI_INTEN_EFIE            BIT(0)            /*!< end of frame interrupt enable */
N#define DCI_INTEN_OVRIE           BIT(1)            /*!< FIFO overrun interrupt enable */
N#define DCI_INTEN_ESEIE           BIT(2)            /*!< embedded synchronous error interrupt enable */
N#define DCI_INTEN_VSIE            BIT(3)            /*!< vsync interrupt enable */
N#define DCI_INTEN_ELIE            BIT(4)            /*!< end of line interrupt enable */
N
N/* DCI_INTF */
N#define DCI_INTF_EFIF             BIT(0)            /*!< end of frame interrupt flag */
N#define DCI_INTF_OVRIF            BIT(1)            /*!< FIFO overrun interrupt flag */
N#define DCI_INTF_ESEIF            BIT(2)            /*!< embedded synchronous error interrupt flag */
N#define DCI_INTF_VSIF             BIT(3)            /*!< vsync interrupt flag  */
N#define DCI_INTF_ELIF             BIT(4)            /*!< end of line interrupt flag */
N
N/* DCI_INTC */
N#define DCI_INTC_EFFC             BIT(0)            /*!< clear end of frame flag */
N#define DCI_INTC_OVRFC            BIT(1)            /*!< clear FIFO overrun flag */
N#define DCI_INTC_ESEFC            BIT(2)            /*!< clear embedded synchronous error flag */
N#define DCI_INTC_VSFC             BIT(3)            /*!< vsync flag clear */
N#define DCI_INTC_ELFC             BIT(4)            /*!< end of line flag clear */
N
N/* DCI_SC */
N#define DCI_SC_FS                 BITS(0,7)         /*!< frame start code in embedded synchronous mode */
N#define DCI_SC_LS                 BITS(8,15)        /*!< line start code in embedded synchronous mode */
N#define DCI_SC_LE                 BITS(16,23)       /*!< line end code in embedded synchronous mode */
N#define DCI_SC_FE                 BITS(24,31)       /*!< frame end code in embedded synchronous mode */
N
N/* DCI_SCUNMSK */
N#define DCI_SCUMSK_FSM            BITS(0,7)         /*!< frame start code unmask bits in embedded synchronous mode */
N#define DCI_SCUMSK_LSM            BITS(8,15)        /*!< line start code unmask bits in embedded synchronous mode */
N#define DCI_SCUMSK_LEM            BITS(16,23)       /*!< line end code unmask bits in embedded synchronous mode */
N#define DCI_SCUMSK_FEM            BITS(24,31)       /*!< frame end code unmask bits in embedded synchronous mode */
N
N/* DCI_CWSPOS */
N#define DCI_CWSPOS_WHSP           BITS(0,13)        /*!< window horizontal start position */
N#define DCI_CWSPOS_WVSP           BITS(16,28)       /*!< window vertical start position */
N
N/* DCI_CWSZ */
N#define DCI_CWSZ_WHSZ             BITS(0,13)        /*!< window horizontal size */
N#define DCI_CWSZ_WVSZ             BITS(16,29)       /*!< window vertical size */
N
N/* constants definitions */
N/* DCI parameter structure definitions */
Ntypedef struct
N{   
N    uint32_t capture_mode;                                           /*!< DCI capture mode: continuous or snapshot */
N    uint32_t clock_polarity;                                         /*!< clock polarity selection */
N    uint32_t hsync_polarity;                                         /*!< horizontal polarity selection */
N    uint32_t vsync_polarity;                                         /*!< vertical polarity selection */
N    uint32_t frame_rate;                                             /*!< frame capture rate */
N    uint32_t interface_format;                                       /*!< digital camera interface format */
N}dci_parameter_struct;                                                         
N
N#define DCI_CAPTURE_MODE_CONTINUOUS   ((uint32_t)0x00000000U)        /*!< continuous capture mode */
N#define DCI_CAPTURE_MODE_SNAPSHOT     DCI_CTL_SNAP                   /*!< snapshot capture mode */
N
N#define DCI_CK_POLARITY_FALLING       ((uint32_t)0x00000000U)        /*!< capture at falling edge */
N#define DCI_CK_POLARITY_RISING        DCI_CTL_CKS                    /*!< capture at rising edge */
N
N#define DCI_HSYNC_POLARITY_LOW        ((uint32_t)0x00000000U)        /*!< low level during blanking period */
N#define DCI_HSYNC_POLARITY_HIGH       DCI_CTL_HPS                    /*!< high level during blanking period */
N
N#define DCI_VSYNC_POLARITY_LOW        ((uint32_t)0x00000000U)        /*!< low level during blanking period */
N#define DCI_VSYNC_POLARITY_HIGH       DCI_CTL_VPS                    /*!< high level during blanking period*/
N 
N#define CTL_FR(regval)                (BITS(8,9)&((uint32_t)(regval) << 8U))    
N#define DCI_FRAME_RATE_ALL            CTL_FR(0)                      /*!< capture all frames */
N#define DCI_FRAME_RATE_1_2            CTL_FR(1)                      /*!< capture one in 2 frames */
N#define DCI_FRAME_RATE_1_4            CTL_FR(2)                      /*!< capture one in 4 frames */
N
N#define CTL_DCIF(regval)              (BITS(10,11)&((uint32_t)(regval) << 10U)) 
N#define DCI_INTERFACE_FORMAT_8BITS    CTL_DCIF(0)                    /*!< 8-bit data on every pixel clock */
N#define DCI_INTERFACE_FORMAT_10BITS   CTL_DCIF(1)                    /*!< 10-bit data on every pixel clock */
N#define DCI_INTERFACE_FORMAT_12BITS   CTL_DCIF(2)                    /*!< 12-bit data on every pixel clock */
N#define DCI_INTERFACE_FORMAT_14BITS   CTL_DCIF(3)                    /*!< 14-bit data on every pixel clock */
N
N/* DCI interrupt constants definitions */
N#define DCI_INT_EF                    BIT(0)                         /*!< end of frame interrupt */
N#define DCI_INT_OVR                   BIT(1)                         /*!< FIFO overrun interrupt */
N#define DCI_INT_ESE                   BIT(2)                         /*!< embedded synchronous error interrupt */
N#define DCI_INT_VSYNC                 BIT(3)                         /*!< vsync interrupt */
N#define DCI_INT_EL                    BIT(4)                         /*!< end of line interrupt */
N
N/* DCI interrupt flag definitions */
N#define DCI_INT_FLAG_EF               BIT(0)                         /*!< end of frame interrupt flag */
N#define DCI_INT_FLAG_OVR              BIT(1)                         /*!< FIFO overrun interrupt flag */
N#define DCI_INT_FLAG_ESE              BIT(2)                         /*!< embedded synchronous error interrupt flag */
N#define DCI_INT_FLAG_VSYNC            BIT(3)                         /*!< vsync interrupt flag */
N#define DCI_INT_FLAG_EL               BIT(4)                         /*!< end of line interrupt flag */
N
N/* DCI flag definitions */  
N#define DCI_FLAG_HS                   DCI_STAT0_HS                   /*!< HS line status */
N#define DCI_FLAG_VS                   DCI_STAT0_VS                   /*!< VS line status */
N#define DCI_FLAG_FV                   DCI_STAT0_FV                   /*!< FIFO valid */
N#define DCI_FLAG_EF                   (DCI_STAT1_EFF | BIT(31))      /*!< end of frame flag */
N#define DCI_FLAG_OVR                  (DCI_STAT1_OVRF | BIT(31))     /*!< FIFO overrun flag */
N#define DCI_FLAG_ESE                  (DCI_STAT1_ESEF | BIT(31))     /*!< embedded synchronous error flag */
N#define DCI_FLAG_VSYNC                (DCI_STAT1_VSF | BIT(31))      /*!< vsync flag */
N#define DCI_FLAG_EL                   (DCI_STAT1_ELF | BIT(31))      /*!< end of line flag */
N
N/* function declarations */
N/* initialization functions */
N/* DCI deinit */
Nvoid dci_deinit(void);
N/* initialize DCI registers */
Nvoid dci_init(dci_parameter_struct* dci_struct);
N
N/* enable DCI function */
Nvoid dci_enable(void);
N/* disable DCI function */
Nvoid dci_disable(void);
N/* enable DCI capture */
Nvoid dci_capture_enable(void);
N/* disable DCI capture */
Nvoid dci_capture_disable(void);
N/* enable DCI jpeg mode */
Nvoid dci_jpeg_enable(void);
N/* disable DCI jpeg mode */
Nvoid dci_jpeg_disable(void);
N
N/* function configuration */
N/* enable cropping window function */
Nvoid dci_crop_window_enable(void);
N/* disable cropping window function */
Nvoid dci_crop_window_disable(void);
N/* configure DCI cropping window */
Nvoid dci_crop_window_config(uint16_t start_x, uint16_t start_y, uint16_t size_width, uint16_t size_height);
N
N/* enable embedded synchronous mode */
Nvoid dci_embedded_sync_enable(void);
N/* disable embedded synchronous mode */
Nvoid dci_embedded_sync_disable(void);
N/* configure synchronous codes in embedded synchronous mode */
Nvoid dci_sync_codes_config(uint8_t frame_start, uint8_t line_start, uint8_t line_end, uint8_t frame_end);
N/* configure synchronous codes unmask in embedded synchronous mode */
Nvoid dci_sync_codes_unmask_config(uint8_t frame_start, uint8_t line_start, uint8_t line_end, uint8_t frame_end);
N
N/* read DCI data register */
Nuint32_t dci_data_read(void);
N
N/* interrupt & flag functions */
N/* get specified flag */
NFlagStatus dci_flag_get(uint32_t flag);
N/* enable specified DCI interrupt */
Nvoid dci_interrupt_enable(uint32_t interrupt);
N/* disable specified DCI interrupt */
Nvoid dci_interrupt_disable(uint32_t interrupt);
N
N
N/* get specified interrupt flag */
NFlagStatus dci_interrupt_flag_get(uint32_t int_flag);
N/* clear specified interrupt flag */
Nvoid dci_interrupt_flag_clear(uint32_t int_flag);
N
N#endif /* GD32F4XX_DCI_H */
L 50 "..\User\config\gd32f4xx_libopt.h" 2
N#include "gd32f4xx_dma.h"
