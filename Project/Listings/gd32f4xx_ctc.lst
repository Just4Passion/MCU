L 41 "..\Libraries\GD32F4xx_standard_peripheral\Include\gd32f4xx_ctc.h" 2
N
N/* CTC definitions */
N#define CTC                          CTC_BASE
N
N/* registers definitions */
N#define CTC_CTL0                     REG32((CTC) + 0x00U)      /*!< CTC control register 0 */
N#define CTC_CTL1                     REG32((CTC) + 0x04U)      /*!< CTC control register 1 */
N#define CTC_STAT                     REG32((CTC) + 0x08U)      /*!< CTC status register */
N#define CTC_INTC                     REG32((CTC) + 0x0CU)      /*!< CTC interrupt clear register */
N
N/* bits definitions */
N/* CTC_CTL0 */
N#define CTC_CTL0_CKOKIE              BIT(0)                    /*!< clock trim OK(CKOKIF) interrupt enable */ 
N#define CTC_CTL0_CKWARNIE            BIT(1)                    /*!< clock trim warning(CKWARNIF) interrupt enable */
N#define CTC_CTL0_ERRIE               BIT(2)                    /*!< error(ERRIF) interrupt enable */
N#define CTC_CTL0_EREFIE              BIT(3)                    /*!< EREFIF interrupt enable */
N#define CTC_CTL0_CNTEN               BIT(5)                    /*!< CTC counter enable */
N#define CTC_CTL0_AUTOTRIM            BIT(6)                    /*!< hardware automatically trim mode */
N#define CTC_CTL0_SWREFPUL            BIT(7)                    /*!< software reference source sync pulse */
N#define CTC_CTL0_TRIMVALUE           BITS(8,13)                /*!< IRC48M trim value */
N
N/* CTC_CTL1 */
N#define CTC_CTL1_RLVALUE             BITS(0,15)                /*!< CTC counter reload value */
N#define CTC_CTL1_CKLIM               BITS(16,23)               /*!< clock trim base limit value */
N#define CTC_CTL1_REFPSC              BITS(24,26)               /*!< reference signal source prescaler */
N#define CTC_CTL1_REFSEL              BITS(28,29)               /*!< reference signal source selection */
N#define CTC_CTL1_USBSOFSEL           BIT(30)                   /*!< USBFS or USBHS SOF signal selection */
N#define CTC_CTL1_REFPOL              BIT(31)                   /*!< reference signal source polarity */
N
N/* CTC_STAT */
N#define CTC_STAT_CKOKIF              BIT(0)                    /*!< clock trim OK interrupt flag */
N#define CTC_STAT_CKWARNIF            BIT(1)                    /*!< clock trim warning interrupt flag */
N#define CTC_STAT_ERRIF               BIT(2)                    /*!< error interrupt flag */
N#define CTC_STAT_EREFIF              BIT(3)                    /*!< expect reference interrupt flag */
N#define CTC_STAT_CKERR               BIT(8)                    /*!< clock trim error bit */
N#define CTC_STAT_REFMISS             BIT(9)                    /*!< reference sync pulse miss */
N#define CTC_STAT_TRIMERR             BIT(10)                   /*!< trim value error bit */
N#define CTC_STAT_REFDIR              BIT(15)                   /*!< CTC trim counter direction when reference sync pulse occurred */
N#define CTC_STAT_REFCAP              BITS(16,31)               /*!< CTC counter capture when reference sync pulse occurred */
N
N/* CTC_INTC */
N#define CTC_INTC_CKOKIC              BIT(0)                    /*!< CKOKIF interrupt clear bit */
N#define CTC_INTC_CKWARNIC            BIT(1)                    /*!< CKWARNIF interrupt clear bit */
N#define CTC_INTC_ERRIC               BIT(2)                    /*!< ERRIF interrupt clear bit */
N#define CTC_INTC_EREFIC              BIT(3)                    /*!< EREFIF interrupt clear bit */
N
N/* constants definitions */
N/* hardware automatically trim mode definitions */
N#define CTC_HARDWARE_TRIM_MODE_ENABLE                    CTC_CTL0_AUTOTRIM            /*!< hardware automatically trim mode enable*/
N#define CTC_HARDWARE_TRIM_MODE_DISABLE                   ((uint32_t)0x00000000U)      /*!< hardware automatically trim mode disable*/
N
N/* reference signal source polarity definitions */
N#define CTC_REFSOURCE_POLARITY_FALLING                   CTC_CTL1_REFPOL              /*!< reference signal source polarity is falling edge*/
N#define CTC_REFSOURCE_POLARITY_RISING                    ((uint32_t)0x00000000U)      /*!< reference signal source polarity is rising edge*/
N
N/* USBFS or USBHS SOF signal selection definitions */
N#define CTC_USBSOFSEL_USBHS                              CTC_CTL1_USBSOFSEL           /*!< USBHS SOF signal is selected*/
N#define CTC_USBSOFSEL_USBFS                              ((uint32_t)0x00000000U)      /*!< USBFS SOF signal is selected*/
N
N/* reference signal source selection definitions */
N#define CTL1_REFSEL(regval)                              (BITS(28,29) & ((uint32_t)(regval) << 28))
N#define CTC_REFSOURCE_GPIO                               CTL1_REFSEL(0)               /*!< GPIO is selected */
N#define CTC_REFSOURCE_LXTAL                              CTL1_REFSEL(1)               /*!< LXTAL is clock selected */
N#define CTC_REFSOURCE_USBSOF                             CTL1_REFSEL(2)               /*!< USBSOF is selected */
N
N/* reference signal source prescaler definitions */
N#define CTL1_REFPSC(regval)                              (BITS(24,26) & ((uint32_t)(regval) << 24))
N#define CTC_REFSOURCE_PSC_OFF                            CTL1_REFPSC(0)               /*!< reference signal not divided */
N#define CTC_REFSOURCE_PSC_DIV2                           CTL1_REFPSC(1)               /*!< reference signal divided by 2 */
N#define CTC_REFSOURCE_PSC_DIV4                           CTL1_REFPSC(2)               /*!< reference signal divided by 4 */
N#define CTC_REFSOURCE_PSC_DIV8                           CTL1_REFPSC(3)               /*!< reference signal divided by 8 */
N#define CTC_REFSOURCE_PSC_DIV16                          CTL1_REFPSC(4)               /*!< reference signal divided by 16 */
N#define CTC_REFSOURCE_PSC_DIV32                          CTL1_REFPSC(5)               /*!< reference signal divided by 32 */
N#define CTC_REFSOURCE_PSC_DIV64                          CTL1_REFPSC(6)               /*!< reference signal divided by 64 */
