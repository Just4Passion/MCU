S/* includes */
S#include "core_cm4.h"
S#include "system_gd32f4xx.h"
S#include <stdint.h>
S
S/* enum definitions */
Stypedef enum {DISABLE = 0, ENABLE = !DISABLE} EventStatus, ControlStatus, FunctionalState;
Stypedef enum {RESET = 0, SET = !RESET} FlagStatus, ITStatus;
Stypedef enum {ERROR = 0, SUCCESS = !ERROR} ErrStatus, ErrorStatus;
S
S
S#define IS_FUNCTIONAL_STATE(STATE) (((STATE) == DISABLE) || ((STATE) == ENABLE))
S
S
S#ifndef __cplusplus
Stypedef enum {FALSE = 0, TRUE = !FALSE} bool;
S#endif
S
S
S/* bit operations */
S#define REG32(addr)                  (*(volatile uint32_t *)(uint32_t)(addr))
S#define REG16(addr)                  (*(volatile uint16_t *)(uint32_t)(addr))
S#define REG8(addr)                   (*(volatile uint8_t *)(uint32_t)(addr))
S#define BIT(x)                       ((uint32_t)((uint32_t)0x01U<<(x)))
S#define BITS(start, end)             ((0xFFFFFFFFUL << (start)) & (0xFFFFFFFFUL >> (31U - (uint32_t)(end))))
S#define GET_BITS(regval, start, end) (((regval) & BITS((start),(end))) >> (start))
S
S/* main flash and SRAM memory map */
S#define FLASH_BASE            ((uint32_t)0x08000000U)        /*!< main FLASH base address          */
S#define TCMSRAM_BASE          ((uint32_t)0x10000000U)        /*!< TCMSRAM(64KB) base address       */
S#define OPTION_BASE           ((uint32_t)0x1FFEC000U)        /*!< Option bytes base address        */
S#define SRAM_BASE             ((uint32_t)0x20000000U)        /*!< SRAM0 base address               */
S
S/* peripheral memory map */
S#define APB1_BUS_BASE         ((uint32_t)0x40000000U)        /*!< apb1 base address                */
S#define APB2_BUS_BASE         ((uint32_t)0x40010000U)        /*!< apb2 base address                */
S#define AHB1_BUS_BASE         ((uint32_t)0x40020000U)        /*!< ahb1 base address                */
S#define AHB2_BUS_BASE         ((uint32_t)0x50000000U)        /*!< ahb2 base address                */
S
S/* EXMC memory map */
S#define EXMC_BASE             ((uint32_t)0xA0000000U)        /*!< EXMC register base address       */
S
S/* advanced peripheral bus 1 memory map */
S#define TIMER_BASE            (APB1_BUS_BASE + 0x00000000U)  /*!< TIMER base address               */
S#define RTC_BASE              (APB1_BUS_BASE + 0x00002800U)  /*!< RTC base address                 */
S#define WWDGT_BASE            (APB1_BUS_BASE + 0x00002C00U)  /*!< WWDGT base address               */
S#define FWDGT_BASE            (APB1_BUS_BASE + 0x00003000U)  /*!< FWDGT base address               */
S#define I2S_ADD_BASE          (APB1_BUS_BASE + 0x00003400U)  /*!< I2S1_add base address            */
S#define SPI_BASE              (APB1_BUS_BASE + 0x00003800U)  /*!< SPI base address                 */
S#define USART_BASE            (APB1_BUS_BASE + 0x00004400U)  /*!< USART base address               */
S#define I2C_BASE              (APB1_BUS_BASE + 0x00005400U)  /*!< I2C base address                 */
S#define CAN_BASE              (APB1_BUS_BASE + 0x00006400U)  /*!< CAN base address                 */
S#define CTC_BASE              (APB1_BUS_BASE + 0x00006C00U)  /*!< CTC base address                 */
S#define PMU_BASE              (APB1_BUS_BASE + 0x00007000U)  /*!< PMU base address                 */
S#define DAC_BASE              (APB1_BUS_BASE + 0x00007400U)  /*!< DAC base address                 */
S#define IREF_BASE             (APB1_BUS_BASE + 0x0000C400U)  /*!< IREF base address                */
S
S/* advanced peripheral bus 2 memory map */
S#define TLI_BASE              (APB2_BUS_BASE + 0x00006800U)  /*!< TLI base address                 */
S#define SYSCFG_BASE           (APB2_BUS_BASE + 0x00003800U)  /*!< SYSCFG base address              */
S#define EXTI_BASE             (APB2_BUS_BASE + 0x00003C00U)  /*!< EXTI base address                */
S#define SDIO_BASE             (APB2_BUS_BASE + 0x00002C00U)  /*!< SDIO base address                */
S#define ADC_BASE              (APB2_BUS_BASE + 0x00002000U)  /*!< ADC base address                 */
S/* advanced high performance bus 1 memory map */
S#define GPIO_BASE             (AHB1_BUS_BASE + 0x00000000U)  /*!< GPIO base address                */
S#define CRC_BASE              (AHB1_BUS_BASE + 0x00003000U)  /*!< CRC base address                 */
S#define RCU_BASE              (AHB1_BUS_BASE + 0x00003800U)  /*!< RCU base address                 */
S#define FMC_BASE              (AHB1_BUS_BASE + 0x00003C00U)  /*!< FMC base address                 */
S#define BKPSRAM_BASE          (AHB1_BUS_BASE + 0x00004000U)  /*!< BKPSRAM base address             */
S#define DMA_BASE              (AHB1_BUS_BASE + 0x00006000U)  /*!< DMA base address                 */
S#define ENET_BASE             (AHB1_BUS_BASE + 0x00008000U)  /*!< ENET base address                */
S#define IPA_BASE              (AHB1_BUS_BASE + 0x0000B000U)  /*!< IPA base address                 */
S#define USBHS_BASE            (AHB1_BUS_BASE + 0x00020000U)  /*!< USBHS base address               */
S
S/* advanced high performance bus 2 memory map */
S#define USBFS_BASE            (AHB2_BUS_BASE + 0x00000000U)  /*!< USBFS base address               */
S#define DCI_BASE              (AHB2_BUS_BASE + 0x00050000U)  /*!< DCI base address                 */
S#define TRNG_BASE             (AHB2_BUS_BASE + 0x00060800U)  /*!< TRNG base address                */
S/* option byte and debug memory map */
S#define OB_BASE               ((uint32_t)0x1FFEC000U)        /*!< OB base address                  */
S#define DBG_BASE              ((uint32_t)0xE0042000U)        /*!< DBG base address                 */
S
S
Stypedef signed long    Int32;
Stypedef unsigned long  uint32;
Stypedef unsigned char  uint8;
S
S
Stypedef uint64_t  u64;
Stypedef uint32_t  u32;
Stypedef uint16_t u16;
Stypedef uint8_t  u8;
S
Stypedef __IO uint32_t  vu32;
Stypedef __IO uint16_t vu16;
Stypedef __IO uint8_t  vu8;
S
Stypedef int32_t  s32;
Stypedef int16_t s16;
Stypedef int8_t  s8;
S
Stypedef const int32_t sc32;  /*!< Read Only */
Stypedef const int16_t sc16;  /*!< Read Only */
Stypedef const int8_t sc8;   /*!< Read Only */
S
Stypedef __IO int32_t  vs32;
Stypedef __IO int16_t  vs16;
Stypedef __IO int8_t   vs8;
S
Stypedef __I int32_t vsc32;  /*!< Read Only */
Stypedef __I int16_t vsc16;  /*!< Read Only */
Stypedef __I int8_t vsc8;   /*!< Read Only */
S
S
