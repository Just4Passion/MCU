N/*!
N    \brief    get CTC interrupt flag
N    \param[in]  int_flag: the CTC interrupt flag
N                only one parameter can be selected which is shown as below:
N      \arg        CTC_INT_FLAG_CKOK: clock trim OK interrupt
N      \arg        CTC_INT_FLAG_CKWARN: clock trim warning interrupt 
N      \arg        CTC_INT_FLAG_ERR: error interrupt 
N      \arg        CTC_INT_FLAG_EREF: expect reference interrupt
N      \arg        CTC_INT_FLAG_CKERR: clock trim error bit interrupt
N      \arg        CTC_INT_FLAG_REFMISS: reference sync pulse miss interrupt 
N      \arg        CTC_INT_FLAG_TRIMERR: trim value error interrupt
N    \param[out] none
N    \retval     FlagStatus: SET or RESET
