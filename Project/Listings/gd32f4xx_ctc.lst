N/* GPIOx(x=A,B,C,D,E,F,G,H,I) definitions */
N#define GPIOA                      (GPIO_BASE + 0x00000000U)
N#define GPIOB                      (GPIO_BASE + 0x00000400U)
N#define GPIOC                      (GPIO_BASE + 0x00000800U)
N#define GPIOD                      (GPIO_BASE + 0x00000C00U)
N#define GPIOE                      (GPIO_BASE + 0x00001000U)
N#define GPIOF                      (GPIO_BASE + 0x00001400U)
N#define GPIOG                      (GPIO_BASE + 0x00001800U)
N#define GPIOH                      (GPIO_BASE + 0x00001C00U)
N#define GPIOI                      (GPIO_BASE + 0x00002000U)
N
N/* registers definitions */
N#define GPIO_CTL(gpiox)            REG32((gpiox) + 0x00U)    /*!< GPIO port control register */
N#define GPIO_OMODE(gpiox)          REG32((gpiox) + 0x04U)    /*!< GPIO port output mode register */
N#define GPIO_OSPD(gpiox)           REG32((gpiox) + 0x08U)    /*!< GPIO port output speed register */
N#define GPIO_PUD(gpiox)            REG32((gpiox) + 0x0CU)    /*!< GPIO port pull-up/pull-down register */
N#define GPIO_ISTAT(gpiox)          REG32((gpiox) + 0x10U)    /*!< GPIO port input status register */
N#define GPIO_OCTL(gpiox)           REG32((gpiox) + 0x14U)    /*!< GPIO port output control register */
N#define GPIO_BOP(gpiox)            REG32((gpiox) + 0x18U)    /*!< GPIO port bit operation register */
N#define GPIO_LOCK(gpiox)           REG32((gpiox) + 0x1CU)    /*!< GPIO port configuration lock register */
N#define GPIO_AFSEL0(gpiox)         REG32((gpiox) + 0x20U)    /*!< GPIO alternate function selected register 0 */
N#define GPIO_AFSEL1(gpiox)         REG32((gpiox) + 0x24U)    /*!< GPIO alternate function selected register 1 */
N#define GPIO_BC(gpiox)             REG32((gpiox) + 0x28U)    /*!< GPIO bit clear register */
N#define GPIO_TG(gpiox)             REG32((gpiox) + 0x2CU)    /*!< GPIO port bit toggle register */
