N#ifndef GD32F4XX_FMC_H
N#define GD32F4XX_FMC_H
N
N#include "gd32f4xx.h"
N
N/* FMC and option byte definition */
N#define FMC                        FMC_BASE                       /*!< FMC register base address */
N#define OB                         OB_BASE                        /*!< option byte base address */
N
N/* registers definitions */
N#define FMC_WS                     REG32((FMC) + 0x0000U)           /*!< FMC wait state register */
N#define FMC_KEY                    REG32((FMC) + 0x0004U)           /*!< FMC unlock key register */
N#define FMC_OBKEY                  REG32((FMC) + 0x0008U)           /*!< FMC option byte unlock key register */
N#define FMC_STAT                   REG32((FMC) + 0x000CU)           /*!< FMC status register */
N#define FMC_CTL                    REG32((FMC) + 0x0010U)           /*!< FMC control register */
N#define FMC_OBCTL0                 REG32((FMC) + 0x0014U)           /*!< FMC option byte control register 0 */
N#define FMC_OBCTL1                 REG32((FMC) + 0x0018U)           /*!< FMC option byte control register 1 */
N#define FMC_WSEN                   REG32((FMC) + 0x00FCU)           /*!< FMC wait state enable register */
N#define FMC_PID                    REG32((FMC) + 0x0100U)           /*!< FMC product ID register */
N
N#define OB_WP1                     REG32((OB) + 0x00000008U)      /*!< option byte write protection 1 */
N#define OB_USER                    REG32((OB) + 0x00010000U)      /*!< option byte user value*/
N#define OB_SPC                     REG32((OB) + 0x00010001U)      /*!< option byte security protection value */
N#define OB_WP0                     REG32((OB) + 0x00010008U)      /*!< option byte write protection 0 */
N
N/* bits definitions */
N/* FMC_WS */
N#define FMC_WC_WSCNT               BITS(0,3)                      /*!< wait state counter */
N
N/* FMC_KEY */
N#define FMC_KEY_KEY                BITS(0,31)                     /*!< FMC main flash key bits */
N
N/* FMC_OBKEY */
N#define FMC_OBKEY_OBKEY            BITS(0,31)                     /*!< option byte key bits */
N
N/* FMC_STAT */
N#define FMC_STAT_END               BIT(0)                         /*!< end of operation flag bit */
N#define FMC_STAT_OPERR             BIT(1)                         /*!< flash operation error flag bit */
N#define FMC_STAT_WPERR             BIT(4)                         /*!< erase/Program protection error flag bit */
N#define FMC_STAT_PGMERR            BIT(6)                         /*!< program size not match error flag bit */
N#define FMC_STAT_PGSERR            BIT(7)                         /*!< program sequence error flag bit */
N#define FMC_STAT_RDDERR            BIT(8)                         /*!< read D-bus protection error flag bit */
N#define FMC_STAT_BUSY              BIT(16)                        /*!< flash busy flag bit */
N
N/* FMC_CTL */
N#define FMC_CTL_PG                 BIT(0)                         /*!< main flash program command bit */
N#define FMC_CTL_SER                BIT(1)                         /*!< main flash sector erase command bit */
N#define FMC_CTL_MER0               BIT(2)                         /*!< main flash mass erase for bank0 command bit */
N#define FMC_CTL_SN                 BITS(3,7)                      /*!< select which sector number to be erased */
N#define FMC_CTL_PSZ                BITS(8,9)                      /*!< program size bit */
N#define FMC_CTL_MER1               BIT(15)                        /*!< main flash mass erase for bank1 command bit */
N#define FMC_CTL_START              BIT(16)                        /*!< send erase command to FMC bit */
N#define FMC_CTL_ENDIE              BIT(24)                        /*!< end of operation interrupt enable bit */
N#define FMC_CTL_ERRIE              BIT(25)                        /*!< error interrupt enable bit */
N#define FMC_CTL_LK                 BIT(31)                        /*!< FMC_CTL lock bit */
N
N/* FMC_OBCTL0 */
N#define FMC_OBCTL0_OB_LK           BIT(0)                         /*!< FMC_OBCTL0 lock bit */
N#define FMC_OBCTL0_OB_START        BIT(1)                         /*!< send option byte change command to FMC bit */
N#define FMC_OBCTL0_BOR_TH          BITS(2,3)                      /*!< option byte BOR threshold value */
N#define FMC_OBCTL0_BB              BIT(4)                         /*!< option byte boot bank value */
N#define FMC_OBCTL0_NWDG_HW         BIT(5)                         /*!< option byte watchdog value */
N#define FMC_OBCTL0_NRST_DPSLP      BIT(6)                         /*!< option byte deepsleep reset value */
N#define FMC_OBCTL0_NRST_STDBY      BIT(7)                         /*!< option byte standby reset value */
N#define FMC_OBCTL0_SPC             BITS(8,15)                     /*!< option byte Security Protection code */
N#define FMC_OBCTL0_WP0             BITS(16,27)                    /*!< erase/program protection of each sector when DRP is 0 */
N#define FMC_OBCTL0_DBS             BIT(30)                        /*!< double banks or single bank selection when flash size is 1M bytes */
N#define FMC_OBCTL0_DRP             BIT(31)                        /*!< D-bus read protection bit */
N
N/* FMC_OBCTL1 */
N#define FMC_OBCTL1_WP1             BITS(16,27)                    /*!< erase/program protection of each sector when DRP is 0 */
N
N/* FMC_WSEN */
N#define FMC_WSEN_WSEN              BIT(0)                         /*!< FMC wait state enable bit */
N
N/* FMC_PID */
N#define FMC_PID_PID                BITS(0,31)                     /*!< product ID bits */
N
N/* constants definitions */
N/* fmc state */
Ntypedef enum
N{
N    FMC_READY,                                                    /*!< the operation has been completed */
N    FMC_BUSY,                                                     /*!< the operation is in progress */
N    FMC_RDDERR,                                                   /*!< read D-bus protection error */
N    FMC_PGSERR,                                                   /*!< program sequence error */
N    FMC_PGMERR,                                                   /*!< program size not match error */
N    FMC_WPERR,                                                    /*!< erase/program protection error */
N    FMC_OPERR,                                                    /*!< operation error */
N    FMC_PGERR,                                                    /*!< program error */
N    FMC_TOERR,                                                    /*!< timeout error */
N}fmc_state_enum;
N
N/* unlock key */
N#define UNLOCK_KEY0                ((uint32_t)0x45670123U)        /*!< unlock key 0 */
N#define UNLOCK_KEY1                ((uint32_t)0xCDEF89ABU)        /*!< unlock key 1 */
N
N#define OB_UNLOCK_KEY0             ((uint32_t)0x08192A3BU)        /*!< ob unlock key 0 */
N#define OB_UNLOCK_KEY1             ((uint32_t)0x4C5D6E7FU)        /*!< ob unlock key 1 */
N
N/* option byte write protection */
N#define OB_LWP                     ((uint32_t)0x000000FFU)        /*!< write protection low bits */
N#define OB_HWP                     ((uint32_t)0x0000FF00U)        /*!< write protection high bits */
N
N/* FMC wait state counter */
N#define WC_WSCNT(regval)           (BITS(0,3) & ((uint32_t)(regval)))
N#define WS_WSCNT_0                 WC_WSCNT(0)                    /*!< FMC 0 wait */
N#define WS_WSCNT_1                 WC_WSCNT(1)                    /*!< FMC 1 wait */
N#define WS_WSCNT_2                 WC_WSCNT(2)                    /*!< FMC 2 wait */
N#define WS_WSCNT_3                 WC_WSCNT(3)                    /*!< FMC 3 wait */
N#define WS_WSCNT_4                 WC_WSCNT(4)                    /*!< FMC 4 wait */
N#define WS_WSCNT_5                 WC_WSCNT(5)                    /*!< FMC 5 wait */
N#define WS_WSCNT_6                 WC_WSCNT(6)                    /*!< FMC 6 wait */
N#define WS_WSCNT_7                 WC_WSCNT(7)                    /*!< FMC 7 wait */
N#define WS_WSCNT_8                 WC_WSCNT(8)                    /*!< FMC 8 wait */
N#define WS_WSCNT_9                 WC_WSCNT(9)                    /*!< FMC 9 wait */
N#define WS_WSCNT_10                WC_WSCNT(10)                   /*!< FMC 10 wait */
N#define WS_WSCNT_11                WC_WSCNT(11)                   /*!< FMC 11 wait */
N#define WS_WSCNT_12                WC_WSCNT(12)                   /*!< FMC 12 wait */
N#define WS_WSCNT_13                WC_WSCNT(13)                   /*!< FMC 13 wait */
N#define WS_WSCNT_14                WC_WSCNT(14)                   /*!< FMC 14 wait */
N#define WS_WSCNT_15                WC_WSCNT(15)                   /*!< FMC 15 wait */
N
N/* option byte BOR threshold value */
N#define OBCTL0_BOR_TH(regval)      (BITS(2,3) & ((uint32_t)(regval))<< 2)
N#define OB_BOR_TH_VALUE3           OBCTL0_BOR_TH(0)               /*!< BOR threshold value 3 */
N#define OB_BOR_TH_VALUE2           OBCTL0_BOR_TH(1)               /*!< BOR threshold value 2 */
N#define OB_BOR_TH_VALUE1           OBCTL0_BOR_TH(2)               /*!< BOR threshold value 1 */
N#define OB_BOR_TH_OFF              OBCTL0_BOR_TH(3)               /*!< no BOR function */
N
N/* option byte boot bank value */
N#define OBCTL0_BB(regval)          (BIT(4) & ((uint32_t)(regval)<<4))
N#define OB_BB_DISABLE              OBCTL0_BB(0)                   /*!< boot from bank0 */
N#define OB_BB_ENABLE               OBCTL0_BB(1)                   /*!< boot from bank1 or bank0 if bank1 is void */
N
N/* option byte software/hardware free watch dog timer */  
N#define OBCTL0_NWDG_HW(regval)     (BIT(5) & ((uint32_t)(regval))<< 5)
N#define OB_FWDGT_SW                OBCTL0_NWDG_HW(1)              /*!< software free watchdog */
N#define OB_FWDGT_HW                OBCTL0_NWDG_HW(0)              /*!< hardware free watchdog */
N
N/* option byte reset or not entering deep sleep mode */
N#define OBCTL0_NRST_DPSLP(regval)  (BIT(6) & ((uint32_t)(regval))<< 6)
N#define OB_DEEPSLEEP_NRST          OBCTL0_NRST_DPSLP(1)           /*!< no reset when entering deepsleep mode */
N#define OB_DEEPSLEEP_RST           OBCTL0_NRST_DPSLP(0)           /*!< generate a reset instead of entering deepsleep mode */
N
N/* option byte reset or not entering standby mode */
N#define OBCTL0_NRST_STDBY(regval)  (BIT(7) & ((uint32_t)(regval))<< 7)
N#define OB_STDBY_NRST              OBCTL0_NRST_STDBY(1)           /*!< no reset when entering deepsleep mode */
N#define OB_STDBY_RST               OBCTL0_NRST_STDBY(0)           /*!< generate a reset instead of entering standby mode */
N
N/* read protect configure */
N#define FMC_NSPC                   ((uint8_t)0xAAU)               /*!< no security protection */
N#define FMC_LSPC                   ((uint8_t)0xABU)               /*!< low security protection */
N#define FMC_HSPC                   ((uint8_t)0xCCU)               /*!< high security protection */
N
N/* option bytes write protection */
N#define OB_WP_0                    ((uint32_t)0x00000001U)        /*!< erase/program protection of sector 0  */
N#define OB_WP_1                    ((uint32_t)0x00000002U)        /*!< erase/program protection of sector 1  */
N#define OB_WP_2                    ((uint32_t)0x00000004U)        /*!< erase/program protection of sector 2  */
N#define OB_WP_3                    ((uint32_t)0x00000008U)        /*!< erase/program protection of sector 3  */
N#define OB_WP_4                    ((uint32_t)0x00000010U)        /*!< erase/program protection of sector 4  */
N#define OB_WP_5                    ((uint32_t)0x00000020U)        /*!< erase/program protection of sector 5  */
N#define OB_WP_6                    ((uint32_t)0x00000040U)        /*!< erase/program protection of sector 6  */
N#define OB_WP_7                    ((uint32_t)0x00000080U)        /*!< erase/program protection of sector 7  */
N#define OB_WP_8                    ((uint32_t)0x00000100U)        /*!< erase/program protection of sector 8  */
N#define OB_WP_9                    ((uint32_t)0x00000200U)        /*!< erase/program protection of sector 9  */
N#define OB_WP_10                   ((uint32_t)0x00000400U)        /*!< erase/program protection of sector 10 */
N#define OB_WP_11                   ((uint32_t)0x00000800U)        /*!< erase/program protection of sector 11 */
N#define OB_WP_12                   ((uint32_t)0x00010000U)        /*!< erase/program protection of sector 12 */
N#define OB_WP_13                   ((uint32_t)0x00020000U)        /*!< erase/program protection of sector 13 */
N#define OB_WP_14                   ((uint32_t)0x00040000U)        /*!< erase/program protection of sector 14 */
N#define OB_WP_15                   ((uint32_t)0x00080000U)        /*!< erase/program protection of sector 15 */
N#define OB_WP_16                   ((uint32_t)0x00100000U)        /*!< erase/program protection of sector 16 */
N#define OB_WP_17                   ((uint32_t)0x00200000U)        /*!< erase/program protection of sector 17 */
N#define OB_WP_18                   ((uint32_t)0x00400000U)        /*!< erase/program protection of sector 18 */
N#define OB_WP_19                   ((uint32_t)0x00800000U)        /*!< erase/program protection of sector 19 */
N#define OB_WP_20                   ((uint32_t)0x01000000U)        /*!< erase/program protection of sector 20 */
N#define OB_WP_21                   ((uint32_t)0x02000000U)        /*!< erase/program protection of sector 21 */
N#define OB_WP_22                   ((uint32_t)0x04000000U)        /*!< erase/program protection of sector 22 */
N#define OB_WP_23_27                ((uint32_t)0x08000000U)        /*!< erase/program protection of sector 23~27 */
N#define OB_WP_ALL                  ((uint32_t)0x0FFF0FFFU)        /*!< erase/program protection of all sectors */
N
N/* option bytes D-bus read protection */
N#define OB_DRP_0                   ((uint32_t)0x00000001U)        /*!< D-bus read protection protection of sector 0  */
N#define OB_DRP_1                   ((uint32_t)0x00000002U)        /*!< D-bus read protection protection of sector 1  */
N#define OB_DRP_2                   ((uint32_t)0x00000004U)        /*!< D-bus read protection protection of sector 2  */
N#define OB_DRP_3                   ((uint32_t)0x00000008U)        /*!< D-bus read protection protection of sector 3  */
N#define OB_DRP_4                   ((uint32_t)0x00000010U)        /*!< D-bus read protection protection of sector 4  */
N#define OB_DRP_5                   ((uint32_t)0x00000020U)        /*!< D-bus read protection protection of sector 5  */
N#define OB_DRP_6                   ((uint32_t)0x00000040U)        /*!< D-bus read protection protection of sector 6  */
N#define OB_DRP_7                   ((uint32_t)0x00000080U)        /*!< D-bus read protection protection of sector 7  */
N#define OB_DRP_8                   ((uint32_t)0x00000100U)        /*!< D-bus read protection protection of sector 8  */
N#define OB_DRP_9                   ((uint32_t)0x00000200U)        /*!< D-bus read protection protection of sector 9  */
N#define OB_DRP_10                  ((uint32_t)0x00000400U)        /*!< D-bus read protection protection of sector 10 */
N#define OB_DRP_11                  ((uint32_t)0x00000800U)        /*!< D-bus read protection protection of sector 11 */
N#define OB_DRP_12                  ((uint32_t)0x00010000U)        /*!< D-bus read protection protection of sector 12 */
N#define OB_DRP_13                  ((uint32_t)0x00020000U)        /*!< D-bus read protection protection of sector 13 */
N#define OB_DRP_14                  ((uint32_t)0x00040000U)        /*!< D-bus read protection protection of sector 14 */
N#define OB_DRP_15                  ((uint32_t)0x00080000U)        /*!< D-bus read protection protection of sector 15 */
N#define OB_DRP_16                  ((uint32_t)0x00100000U)        /*!< D-bus read protection protection of sector 16 */
N#define OB_DRP_17                  ((uint32_t)0x00200000U)        /*!< D-bus read protection protection of sector 17 */
N#define OB_DRP_18                  ((uint32_t)0x00400000U)        /*!< D-bus read protection protection of sector 18 */
N#define OB_DRP_19                  ((uint32_t)0x00800000U)        /*!< D-bus read protection protection of sector 19 */
N#define OB_DRP_20                  ((uint32_t)0x01000000U)        /*!< D-bus read protection protection of sector 20 */
N#define OB_DRP_21                  ((uint32_t)0x02000000U)        /*!< D-bus read protection protection of sector 21 */
N#define OB_DRP_22                  ((uint32_t)0x04000000U)        /*!< D-bus read protection protection of sector 22 */
N#define OB_DRP_23_27               ((uint32_t)0x08000000U)        /*!< D-bus read protection protection of sector 23~27 */
N
N/* double banks or single bank selection when flash size is 1M bytes */  
N#define OBCTL0_DBS(regval)         (BIT(30) & ((uint32_t)(regval)<<30))
N#define OB_DBS_DISABLE             OBCTL0_DBS(0)                  /*!< single bank when flash size is 1M bytes */
N#define OB_DBS_ENABLE              OBCTL0_DBS(1)                  /*!< double bank when flash size is 1M bytes */
N
N/* option bytes D-bus read protection mode */  
N#define OBCTL0_DRP(regval)         (BIT(31) & ((uint32_t)(regval)<<31))
N#define OB_DRP_DISABLE             OBCTL0_DRP(0)                  /*!< the WPx bits used as erase/program protection of each sector */
N#define OB_DRP_ENABLE              OBCTL0_DRP(1)                  /*!< the WPx bits used as erase/program protection and D-bus read protection of each sector */
N
N/* FMC sectors */
N#define CTL_SN(regval)             (BITS(3,7) & ((uint32_t)(regval))<< 3)
N#define CTL_SECTOR_NUMBER_0        CTL_SN(0)                      /*!< sector 0   */
N#define CTL_SECTOR_NUMBER_1        CTL_SN(1)                      /*!< sector 1   */
N#define CTL_SECTOR_NUMBER_2        CTL_SN(2)                      /*!< sector 2   */
N#define CTL_SECTOR_NUMBER_3        CTL_SN(3)                      /*!< sector 3   */
N#define CTL_SECTOR_NUMBER_4        CTL_SN(4)                      /*!< sector 4   */
N#define CTL_SECTOR_NUMBER_5        CTL_SN(5)                      /*!< sector 5   */
N#define CTL_SECTOR_NUMBER_6        CTL_SN(6)                      /*!< sector 6   */
N#define CTL_SECTOR_NUMBER_7        CTL_SN(7)                      /*!< sector 7   */
N#define CTL_SECTOR_NUMBER_8        CTL_SN(8)                      /*!< sector 8   */
N#define CTL_SECTOR_NUMBER_9        CTL_SN(9)                      /*!< sector 9   */
N#define CTL_SECTOR_NUMBER_10       CTL_SN(10)                     /*!< sector 10  */
N#define CTL_SECTOR_NUMBER_11       CTL_SN(11)                     /*!< sector 11  */
N#define CTL_SECTOR_NUMBER_24       CTL_SN(12)                     /*!< sector 24  */
N#define CTL_SECTOR_NUMBER_25       CTL_SN(13)                     /*!< sector 25  */
N#define CTL_SECTOR_NUMBER_26       CTL_SN(14)                     /*!< sector 26  */
N#define CTL_SECTOR_NUMBER_27       CTL_SN(15)                     /*!< sector 27  */
N#define CTL_SECTOR_NUMBER_12       CTL_SN(16)                     /*!< sector 12  */
N#define CTL_SECTOR_NUMBER_13       CTL_SN(17)                     /*!< sector 13  */
N#define CTL_SECTOR_NUMBER_14       CTL_SN(18)                     /*!< sector 14  */
N#define CTL_SECTOR_NUMBER_15       CTL_SN(19)                     /*!< sector 15  */
N#define CTL_SECTOR_NUMBER_16       CTL_SN(20)                     /*!< sector 16  */
N#define CTL_SECTOR_NUMBER_17       CTL_SN(21)                     /*!< sector 17  */
N#define CTL_SECTOR_NUMBER_18       CTL_SN(22)                     /*!< sector 18  */
N#define CTL_SECTOR_NUMBER_19       CTL_SN(23)                     /*!< sector 19  */
N#define CTL_SECTOR_NUMBER_20       CTL_SN(24)                     /*!< sector 20  */
N#define CTL_SECTOR_NUMBER_21       CTL_SN(25)                     /*!< sector 21  */
N#define CTL_SECTOR_NUMBER_22       CTL_SN(26)                     /*!< sector 22  */
N#define CTL_SECTOR_NUMBER_23       CTL_SN(27)                     /*!< sector 23  */
N
N
N/* FMC program size */ 
N#define CTL_PSZ(regval)            (BITS(8,9) & ((uint32_t)(regval))<< 8)
N#define CTL_PSZ_BYTE               CTL_PSZ(0)                     /*!< FMC program by byte access */
N#define CTL_PSZ_HALF_WORD          CTL_PSZ(1)                     /*!< FMC program by half-word access */
N#define CTL_PSZ_WORD               CTL_PSZ(2)                     /*!< FMC program by word access */
N
N/* FMC interrupt enable */
N#define FMC_INT_END                ((uint32_t)0x01000000U)        /*!< enable FMC end of program interrupt */
N#define FMC_INT_ERR                ((uint32_t)0x02000000U)        /*!< enable FMC error interrupt */
N
N/* FMC flags */
N#define FMC_FLAG_END               ((uint32_t)0x00000001U)        /*!< FMC end of operation flag bit */
N#define FMC_FLAG_OPERR             ((uint32_t)0x00000002U)        /*!< FMC operation error flag bit */
N#define FMC_FLAG_WPERR             ((uint32_t)0x00000010U)        /*!< FMC erase/program protection error flag bit */
N#define FMC_FLAG_PGMERR            ((uint32_t)0x00000040U)        /*!< FMC program size not match error flag bit */
N#define FMC_FLAG_PGSERR            ((uint32_t)0x00000080U)        /*!< FMC program sequence error flag bit */
N#define FMC_FLAG_RDDERR            ((uint32_t)0x00000100U)        /*!< FMC read D-bus protection error flag bit */
N#define FMC_FLAG_BUSY              ((uint32_t)0x00010000U)        /*!< FMC busy flag */
N
N/* FMC time out */
N#define FMC_TIMEOUT_COUNT          ((uint32_t)0xFFFFFFFFU)        /*!< count to judge of FMC timeout */
N
N/* function declarations */
N/* FMC main memory programming functions */
N/* set the FMC wait state counter */
Nvoid fmc_wscnt_set(uint32_t wscnt);
N/* unlock the main FMC operation */
Nvoid fmc_unlock(void);
N/* lock the main FMC operation */
Nvoid fmc_lock(void);
N/* FMC erase sector */
Nfmc_state_enum fmc_sector_erase(uint32_t fmc_sector);
N/* FMC erase whole chip */
Nfmc_state_enum fmc_mass_erase(void);
N/* FMC erase whole bank0 */
Nfmc_state_enum fmc_bank0_erase(void);
N/* FMC erase whole bank1 */
Nfmc_state_enum fmc_bank1_erase(void);
N/* FMC program a word at the corresponding address */
Nfmc_state_enum fmc_word_program(uint32_t address, uint32_t data);
N/* FMC program a half word at the corresponding address */
Nfmc_state_enum fmc_halfword_program(uint32_t address, uint16_t data);
N/* FMC program a byte at the corresponding address */
Nfmc_state_enum fmc_byte_program(uint32_t address, uint8_t data);
N
N/* FMC option bytes programming functions */
N/* unlock the option byte operation */
Nvoid ob_unlock(void);
N/* lock the option byte operation */
Nvoid ob_lock(void);
N/* send option byte change command */
Nvoid ob_start(void);
N/* erase option byte */
Nvoid ob_erase(void);
N/* enable write protect */
Nvoid ob_write_protection_enable(uint32_t ob_wp);
N/* disable write protect */
Nvoid ob_write_protection_disable(uint32_t ob_wp);
N/* enable erase/program protection and D-bus read protection */
Nvoid ob_drp_enable(uint32_t ob_drp);
N/* disable erase/program protection and D-bus read protection */
Nvoid ob_drp_disable(uint32_t ob_drp);
N/* set the option byte security protection level */
Nvoid ob_security_protection_config(uint8_t ob_spc);
N/* write the FMC option byte user */
Nvoid ob_user_write(uint32_t ob_fwdgt, uint32_t ob_deepsleep, uint32_t ob_stdby);
N/* option byte BOR threshold value */
Nvoid ob_user_bor_threshold(uint32_t ob_bor_th);
N/* configure the boot mode */
Nvoid ob_boot_mode_config(uint32_t boot_mode);
N/* get the FMC option byte user */
Nuint8_t ob_user_get(void);
N/* get the FMC option byte write protection */
Nuint16_t ob_write_protection0_get(void);
N/* get the FMC option byte write protection */
Nuint16_t ob_write_protection1_get(void);
N/* get the FMC erase/program protection and D-bus read protection option bytes value */
Nuint16_t ob_drp0_get(void);
N/* get the FMC erase/program protection and D-bus read protection option bytes value */
Nuint16_t ob_drp1_get(void);
N/* get option byte security protection code value */
NFlagStatus ob_spc_get(void);
N/* get the FMC threshold value */
Nuint8_t ob_user_bor_threshold_get(void);
N
N/* FMC interrupts and flags management functions */
N/* enable FMC interrupt */
Nvoid fmc_interrupt_enable(uint32_t fmc_int);
N/* disable FMC interrupt */
Nvoid fmc_interrupt_disable(uint32_t fmc_int);
N/* get flag set or reset */
NFlagStatus fmc_flag_get(uint32_t fmc_flag);
N/* clear the FMC pending flag */
Nvoid fmc_flag_clear(uint32_t fmc_flag);
N/* return the FMC state */
Nfmc_state_enum fmc_state_get(void);
N/* check FMC ready or not */
Nfmc_state_enum fmc_ready_wait(uint32_t timeout);
N
N#endif /* GD32F4XX_FMC_H */
L 53 "..\User\config\gd32f4xx_libopt.h" 2
N#include "gd32f4xx_fwdgt.h"
L 1 "..\Libraries\GD32F4xx_standard_peripheral\Include\gd32f4xx_fwdgt.h" 1
