N
N/* define value of high speed crystal oscillator (HXTAL) in Hz */
N#if !defined  (HXTAL_VALUE)
X#if !0L
N#define HXTAL_VALUE    ((uint32_t)25000000)
N#endif /* high speed crystal oscillator value */
N
N/* define startup timeout value of high speed crystal oscillator (HXTAL) */
N#if !defined  (HXTAL_STARTUP_TIMEOUT)
X#if !0L
N#define HXTAL_STARTUP_TIMEOUT   ((uint16_t)0xFFFF)
N#endif /* high speed crystal oscillator startup timeout */
N
N/* define value of internal 16MHz RC oscillator (IRC16M) in Hz */
N#if !defined  (IRC16M_VALUE)
X#if !0L
N#define IRC16M_VALUE  ((uint32_t)16000000)
N#endif /* internal 16MHz RC oscillator value */
N
N/* define startup timeout value of internal 16MHz RC oscillator (IRC16M) */
N#if !defined  (IRC16M_STARTUP_TIMEOUT)
X#if !0L
N#define IRC16M_STARTUP_TIMEOUT   ((uint16_t)0x0500)
N#endif /* internal 16MHz RC oscillator startup timeout */
N
N/* define value of internal 32KHz RC oscillator(IRC32K) in Hz */
N#if !defined  (IRC32K_VALUE)
X#if !0L
N#define IRC32K_VALUE  ((uint32_t)32000)
N#endif /* internal 32KHz RC oscillator value */
N
N/* define value of low speed crystal oscillator (LXTAL)in Hz */
N#if !defined  (LXTAL_VALUE)
X#if !0L
N#define LXTAL_VALUE  ((uint32_t)32768)
N#endif /* low speed crystal oscillator value */
