N/***********************************************************
N * 
N *          最小内核配置: 纳米级内核
N * 多线程调度（支持优先级抢占）
N * 线程间同步：信号量、互斥锁
N * 线程间通信：邮箱、消息队列
N * 内存管理：小内存管理算法
N * 软件定时器
N * 
N ***********************************************************/
N#define RT_USING_NANO
N#define RT_CPUS_NR 1
N#define RT_NAME_MAX 8
N#define RT_ALIGN_SIZE 4
N#define RT_USING_OVERFLOW_CHECK             //栈溢出检查
N#define RT_TICK_PER_SECOND 1000             //1秒钟多少个tick
N#define RT_THREAD_PRIORITY_MAX 32           //任务优先级
N#define IDLE_THREAD_STACK_SIZE 256          //空闲线程栈
N#define RT_BACKTRACE_LEVEL_MAX_NR 32        //回溯信息最大层级. 定义函数调用栈回溯的最大层级数; 用于调试功能，如异常时的调用栈打印
N#define RT_USING_SEMAPHORE                  //信号量
N#define RT_USING_MUTEX                      //互斥锁
N#define RT_USING_MAILBOX                    //邮箱
N#define RT_USING_MESSAGEQUEUE               //消息队列
N/************************************************
N * mempool.c和memheap.c是两种不同的内存管理机制
N * 1. mempool.c: 内存池管理
N *  (1)特点: 固定大小内存块; 无内存碎片; 快速分配; 线程安全
N *  (2)数据结构: 内存池起始地址, 总大小, 每个内存块大小, 内存块链表, 总块数, 空闲块数
N *  (3)创建: rt_mp_init(start_addr, BLOCK_SIZE * BLOCK_COUNT, BLOCK_SIZE)
N *  (4)使用场景: 固定大小, 高频分配, 性能要求高
N * 2. memheap.c: 内存堆管理
N *  (1)特点: 可变大小分配; 多内存区域管理; 内存碎片处理; 通用性强
N *  (2)数据结构: 堆起始地址, 总大小, 可用大小, 空闲链表
N *  (3)使用场景: 变长大小, 灵活性好
N * 
N * 
N * 1. 小内存算法作为堆: rt_malloc() 使用小内存算法
N * #define RT_USING_HEAP                    // 启用堆框架
N * #define RT_USING_SMALL_MEM               // 启用小内存算法
N * #define RT_USING_SMALL_MEM_AS_HEAP       // 将小内存算法绑定到堆
N * 
N * 2. SLAB算法作为堆: rt_malloc() 使用SLAB算法
N * #define RT_USING_HEAP                    // 启用堆框架  
N * #define RT_USING_SLAB                    // 启用SLAB算法
N * #define RT_USING_SLAB_AS_HEAP            // 将SLAB算法绑定到堆
N * 
N * 3. 使用memheap算法作为堆
N * #define RT_USING_HEAP                    // 启用堆框架
N * #define RT_USING_MEMHEAP                 // 启用内存堆算法
N * 
N ************************************************/
N//#define RT_USING_MEMPOOL                  //RT_USING_MEMPOOL 是独立功能，与其他宏无关
N#define RT_USING_SMALL_MEM                 //启用小内存算法
N#define RT_USING_SMALL_MEM_AS_HEAP         //使用小内存管理算法管理堆
N#define RT_USING_HEAP                      //RT_USING_HEAP 是堆功能的开关，但需要具体算法支持
N
N#define RT_USING_TIMER_SOFT                 //软件定时器
N#define RT_TIMER_THREAD_PRIO 4              //定时器线程优先级
N#define RT_TIMER_THREAD_STACK_SIZE 256      //定时器线程栈大小
N
N#define RT_USING_DEVICE
N
N/***********************************************************
N * 
N *                  最小系统要求
N *  RT-Thread 的内核本身是独立的，只需要以下基本组件就能运行：
N *  内核核心 (src/) - 调度器、线程管理、IPC 等
N *  CPU 移植层 (libcpu/) - 上下文切换、中断处理等
N *  板级支持包 (bsp/) - 时钟配置、串口初始化等
N *  C 库适配 (components/libc/ 中的最小实现)
N * 
N ***********************************************************/
N
N
N /***********************************************************
N * 
N *                  从RT-Thread BSP - gd32-f407 DEMO查看依赖
N *  
N *  
N *  
N *  
N * 
N * 
N ***********************************************************/
N
N
