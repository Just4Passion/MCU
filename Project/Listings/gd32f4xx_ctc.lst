N
N/* GPIO mode configuration values */
N#define GPIO_MODE_SET(n, mode)     ((uint32_t)((uint32_t)(mode) << (2U * (n))))
N#define GPIO_MODE_MASK(n)          (0x3U << (2U * (n)))
N
N/* GPIO pull-up/ pull-down values */
N#define GPIO_PUPD_SET(n, pupd)     ((uint32_t)((uint32_t)(pupd) << (2U * (n))))
N#define GPIO_PUPD_MASK(n)          (0x3U << (2U * (n)))
N
N/* GPIO output speed values */
N#define GPIO_OSPEED_SET(n, speed)  ((uint32_t)((uint32_t)(speed) << (2U * (n))))
N#define GPIO_OSPEED_MASK(n)        (0x3U << (2U * (n)))
N
N/* GPIO output type */
N#define GPIO_OTYPE_PP              ((uint8_t)(0x00U))        /*!< push pull mode */
N#define GPIO_OTYPE_OD              ((uint8_t)(0x01U))        /*!< open drain mode */
N
N/* GPIO output max speed level */
N#define OSPD_OSPD(regval)          (BITS(0,1) & ((uint32_t)(regval) << 0))
N#define GPIO_OSPEED_LEVEL0         OSPD_OSPD(0)              /*!< output max speed level 0 */
N#define GPIO_OSPEED_LEVEL1         OSPD_OSPD(1)              /*!< output max speed level 1 */
N#define GPIO_OSPEED_LEVEL2         OSPD_OSPD(2)              /*!< output max speed level 2 */
N#define GPIO_OSPEED_LEVEL3         OSPD_OSPD(3)              /*!< output max speed level 3 */
N
N/* GPIO output max speed value */
N#define GPIO_OSPEED_2MHZ           GPIO_OSPEED_LEVEL0        /*!< output max speed 2MHz */
N#define GPIO_OSPEED_25MHZ          GPIO_OSPEED_LEVEL1        /*!< output max speed 25MHz */
N#define GPIO_OSPEED_50MHZ          GPIO_OSPEED_LEVEL2        /*!< output max speed 50MHz */
N#define GPIO_OSPEED_200MHZ         GPIO_OSPEED_LEVEL3        /*!< output max speed 200MHz */
N
N/* GPIO alternate function values */
N#define GPIO_AFR_SET(n, af)        ((uint32_t)((uint32_t)(af) << (4U * (n))))
N#define GPIO_AFR_MASK(n)           (0xFU << (4U * (n)))
N 
N/* GPIO alternate function */
N#define AF(regval)                 (BITS(0,3) & ((uint32_t)(regval) << 0)) 
N#define GPIO_AF_0                   AF(0)                    /*!< alternate function 0 selected */
N#define GPIO_AF_1                   AF(1)                    /*!< alternate function 1 selected */
N#define GPIO_AF_2                   AF(2)                    /*!< alternate function 2 selected */
N#define GPIO_AF_3                   AF(3)                    /*!< alternate function 3 selected */
N#define GPIO_AF_4                   AF(4)                    /*!< alternate function 4 selected */
N#define GPIO_AF_5                   AF(5)                    /*!< alternate function 5 selected */
N#define GPIO_AF_6                   AF(6)                    /*!< alternate function 6 selected */
N#define GPIO_AF_7                   AF(7)                    /*!< alternate function 7 selected */
N#define GPIO_AF_8                   AF(8)                    /*!< alternate function 8 selected */
N#define GPIO_AF_9                   AF(9)                    /*!< alternate function 9 selected */
N#define GPIO_AF_10                  AF(10)                   /*!< alternate function 10 selected */
N#define GPIO_AF_11                  AF(11)                   /*!< alternate function 11 selected */
N#define GPIO_AF_12                  AF(12)                   /*!< alternate function 12 selected */
N#define GPIO_AF_13                  AF(13)                   /*!< alternate function 13 selected */
N#define GPIO_AF_14                  AF(14)                   /*!< alternate function 14 selected */
N#define GPIO_AF_15                  AF(15)                   /*!< alternate function 15 selected */
N
N
N/** 
N  * @brief  Bit_SET and Bit_RESET enumeration  
N  */
N
Ntypedef enum
N{ Bit_RESET = 0,
N  Bit_SET
N}BitAction;
N
N
N/* function declarations */
N/* reset GPIO port */
Nvoid gpio_deinit(uint32_t gpio_periph);
N/* set GPIO mode */
Nvoid gpio_mode_set(uint32_t gpio_periph, uint32_t mode, uint32_t pull_up_down, uint32_t pin);
N/* set GPIO output type and speed */
Nvoid gpio_output_options_set(uint32_t gpio_periph, uint8_t otype, uint32_t speed, uint32_t pin);
N
N/* set GPIO pin bit */
Nvoid gpio_bit_set(uint32_t gpio_periph, uint32_t pin);
N/* reset GPIO pin bit */
Nvoid gpio_bit_reset(uint32_t gpio_periph, uint32_t pin);
N/* write data to the specified GPIO pin */
Nvoid gpio_bit_write(uint32_t gpio_periph, uint32_t pin, bit_status bit_value);
N/* write data to the specified GPIO port */
Nvoid gpio_port_write(uint32_t gpio_periph, uint16_t data);
N
N/* get GPIO pin input status */
NFlagStatus gpio_input_bit_get(uint32_t gpio_periph, uint32_t pin);
N/* get GPIO port input status */
Nuint16_t gpio_input_port_get(uint32_t gpio_periph);
N/* get GPIO pin output status */
NFlagStatus gpio_output_bit_get(uint32_t gpio_periph, uint32_t pin);
N/* get GPIO port output status */
Nuint16_t gpio_output_port_get(uint32_t gpio_periph);
N
N/* set GPIO alternate function */
Nvoid gpio_af_set(uint32_t gpio_periph, uint32_t alt_func_num, uint32_t pin);
N/* lock GPIO pin bit */
Nvoid gpio_pin_lock(uint32_t gpio_periph, uint32_t pin);
N
N/* toggle GPIO pin status */
Nvoid gpio_bit_toggle(uint32_t gpio_periph, uint32_t pin);
N/* toggle GPIO port status */
Nvoid gpio_port_toggle(uint32_t gpio_periph);
N
N#endif /* GD32F4XX_GPIO_H */
