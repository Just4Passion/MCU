NPROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, 
NWHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) 
NARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY 
NOF SUCH DAMAGE.
N*/
N
N#ifndef GD32F4XX_DMA_H
N#define GD32F4XX_DMA_H
N
N#include "gd32f4xx.h"
N
N/* DMA definitions */
N#define DMA0                              (DMA_BASE)                    /*!< DMA0 base address */
N#define DMA1                              (DMA_BASE + 0x0400U)          /*!< DMA1 base address */
N
N/* registers definitions */
N#define DMA_INTF0(dmax)                    REG32((dmax) + 0x00U)        /*!< DMA interrupt flag register 0 */
N#define DMA_INTF1(dmax)                    REG32((dmax) + 0x04U)        /*!< DMA interrupt flag register 1 */
N#define DMA_INTC0(dmax)                    REG32((dmax) + 0x08U)        /*!< DMA interrupt flag clear register 0 */
N#define DMA_INTC1(dmax)                    REG32((dmax) + 0x0CU)        /*!< DMA interrupt flag clear register 1 */
N
N#define DMA_CH0CTL(dmax)                   REG32((dmax) + 0x10U)        /*!< DMA channel 0 control register */
N#define DMA_CH0CNT(dmax)                   REG32((dmax) + 0x14U)        /*!< DMA channel 0 counter register */
N#define DMA_CH0PADDR(dmax)                 REG32((dmax) + 0x18U)        /*!< DMA channel 0 peripheral base address register */
N#define DMA_CH0M0ADDR(dmax)                REG32((dmax) + 0x1CU)        /*!< DMA channel 0 memory 0 base address register */
N#define DMA_CH0M1ADDR(dmax)                REG32((dmax) + 0x20U)        /*!< DMA channel 0 memory 1 base address register */
N#define DMA_CH0FCTL(dmax)                  REG32((dmax) + 0x24U)        /*!< DMA channel 0 FIFO control register */
N
N#define DMA_CH1CTL(dmax)                   REG32((dmax) + 0x28U)        /*!< DMA channel 1 control register */
N#define DMA_CH1CNT(dmax)                   REG32((dmax) + 0x2CU)        /*!< DMA channel 1 counter register */
N#define DMA_CH1PADDR(dmax)                 REG32((dmax) + 0x30U)        /*!< DMA channel 1 peripheral base address register */
N#define DMA_CH1M0ADDR(dmax)                REG32((dmax) + 0x34U)        /*!< DMA channel 1 memory 0 base address register */
N#define DMA_CH1M1ADDR(dmax)                REG32((dmax) + 0x38U)        /*!< DMA channel 1 memory 1 base address register */
N#define DMA_CH1FCTL(dmax)                  REG32((dmax) + 0x3CU)        /*!< DMA channel 1 FIFO control register */
N
N#define DMA_CH2CTL(dmax)                   REG32((dmax) + 0x40U)        /*!< DMA channel 2 control register */
N#define DMA_CH2CNT(dmax)                   REG32((dmax) + 0x44U)        /*!< DMA channel 2 counter register */
N#define DMA_CH2PADDR(dmax)                 REG32((dmax) + 0x48U)        /*!< DMA channel 2 peripheral base address register */
N#define DMA_CH2M0ADDR(dmax)                REG32((dmax) + 0x4CU)        /*!< DMA channel 2 memory 0 base address register */
N#define DMA_CH2M1ADDR(dmax)                REG32((dmax) + 0x50U)        /*!< DMA channel 2 memory 1 base address register */
N#define DMA_CH2FCTL(dmax)                  REG32((dmax) + 0x54U)        /*!< DMA channel 2 FIFO control register */
N
N#define DMA_CH3CTL(dmax)                   REG32((dmax) + 0x58U)        /*!< DMA channel 3 control register */
N#define DMA_CH3CNT(dmax)                   REG32((dmax) + 0x5CU)        /*!< DMA channel 3 counter register */
N#define DMA_CH3PADDR(dmax)                 REG32((dmax) + 0x60U)        /*!< DMA channel 3 peripheral base address register */
N#define DMA_CH3M0ADDR(dmax)                REG32((dmax) + 0x64U)        /*!< DMA channel 3 memory 0 base address register */
N#define DMA_CH3M1ADDR(dmax)                REG32((dmax) + 0x68U)        /*!< DMA channel 3 memory 1 base address register */
N#define DMA_CH3FCTL(dmax)                  REG32((dmax) + 0x6CU)        /*!< DMA channel 3 FIFO control register */
N
N#define DMA_CH4CTL(dmax)                   REG32((dmax) + 0x70U)        /*!< DMA channel 4 control register */
N#define DMA_CH4CNT(dmax)                   REG32((dmax) + 0x74U)        /*!< DMA channel 4 counter register */
N#define DMA_CH4PADDR(dmax)                 REG32((dmax) + 0x78U)        /*!< DMA channel 4 peripheral base address register */
N#define DMA_CH4M0ADDR(dmax)                REG32((dmax) + 0x7CU)        /*!< DMA channel 4 memory 0 base address register */
N#define DMA_CH4M1ADDR(dmax)                REG32((dmax) + 0x80U)        /*!< DMA channel 4 memory 1 base address register */
N#define DMA_CH4FCTL(dmax)                  REG32((dmax) + 0x84U)        /*!< DMA channel 4 FIFO control register */
N
N#define DMA_CH5CTL(dmax)                   REG32((dmax) + 0x88U)        /*!< DMA channel 5 control register */
N#define DMA_CH5CNT(dmax)                   REG32((dmax) + 0x8CU)        /*!< DMA channel 5 counter register */
N#define DMA_CH5PADDR(dmax)                 REG32((dmax) + 0x90U)        /*!< DMA channel 5 peripheral base address register */
N#define DMA_CH5M0ADDR(dmax)                REG32((dmax) + 0x94U)        /*!< DMA channel 5 memory 0 base address register */
N#define DMA_CH5M1ADDR(dmax)                REG32((dmax) + 0x98U)        /*!< DMA channel 5 memory 1 base address register */
N#define DMA_CH5FCTL(dmax)                  REG32((dmax) + 0x9CU)        /*!< DMA channel 5 FIFO control register */
N
N#define DMA_CH6CTL(dmax)                   REG32((dmax) + 0xA0U)        /*!< DMA channel 6 control register */
N#define DMA_CH6CNT(dmax)                   REG32((dmax) + 0xA4U)        /*!< DMA channel 6 counter register */
N#define DMA_CH6PADDR(dmax)                 REG32((dmax) + 0xA8U)        /*!< DMA channel 6 peripheral base address register */
N#define DMA_CH6M0ADDR(dmax)                REG32((dmax) + 0xACU)        /*!< DMA channel 6 memory 0 base address register */
N#define DMA_CH6M1ADDR(dmax)                REG32((dmax) + 0xB0U)        /*!< DMA channel 6 memory 1 base address register */
N#define DMA_CH6FCTL(dmax)                  REG32((dmax) + 0xB4U)        /*!< DMA channel 6 FIFO control register */
N
N#define DMA_CH7CTL(dmax)                   REG32((dmax) + 0xB8U)        /*!< DMA channel 7 control register */
N#define DMA_CH7CNT(dmax)                   REG32((dmax) + 0xBCU)        /*!< DMA channel 7 counter register */
N#define DMA_CH7PADDR(dmax)                 REG32((dmax) + 0xC0U)        /*!< DMA channel 7 peripheral base address register */
N#define DMA_CH7M0ADDR(dmax)                REG32((dmax) + 0xC4U)        /*!< DMA channel 7 memory 0 base address register */
N#define DMA_CH7M1ADDR(dmax)                REG32((dmax) + 0xC8U)        /*!< DMA channel 7 memory 1 base address register */
N#define DMA_CH7FCTL(dmax)                  REG32((dmax) + 0xCCU)        /*!< DMA channel 7 FIFO control register */
N
N/* bits definitions */
N/* DMA_INTF */
N#define DMA_INTF_FEEIF                    BIT(0)                        /*!< FIFO error and exception flag */
N#define DMA_INTF_SDEIF                    BIT(2)                        /*!< single data mode exception flag */
N#define DMA_INTF_TAEIF                    BIT(3)                        /*!< transfer access error flag */
N#define DMA_INTF_HTFIF                    BIT(4)                        /*!< half transfer finish flag */
N#define DMA_INTF_FTFIF                    BIT(5)                        /*!< full transger finish flag */
N
N/* DMA_INTC */
N#define DMA_INTC_FEEIFC                   BIT(0)                        /*!< clear FIFO error and exception flag */
N#define DMA_INTC_SDEIFC                   BIT(2)                        /*!< clear single data mode exception flag */
N#define DMA_INTC_TAEIFC                   BIT(3)                        /*!< clear single data mode exception flag */
N#define DMA_INTC_HTFIFC                   BIT(4)                        /*!< clear half transfer finish flag */
N#define DMA_INTC_FTFIFC                   BIT(5)                        /*!< clear full transger finish flag */
N
N/* DMA_CHxCTL,x=0..7 */
N#define DMA_CHXCTL_CHEN                   BIT(0)                        /*!< channel x enable */
N#define DMA_CHXCTL_SDEIE                  BIT(1)                        /*!< enable bit for channel x single data mode exception interrupt */
N#define DMA_CHXCTL_TAEIE                  BIT(2)                        /*!< enable bit for channel x tranfer access error interrupt */
N#define DMA_CHXCTL_HTFIE                  BIT(3)                        /*!< enable bit for channel x half transfer finish interrupt */
N#define DMA_CHXCTL_FTFIE                  BIT(4)                        /*!< enable bit for channel x full transfer finish interrupt */
N#define DMA_CHXCTL_TFCS                   BIT(5)                        /*!< transfer flow controller select */
N#define DMA_CHXCTL_TM                     BITS(6,7)                     /*!< transfer mode */
N#define DMA_CHXCTL_CMEN                   BIT(8)                        /*!< circulation mode */
N#define DMA_CHXCTL_PNAGA                  BIT(9)                        /*!< next address generation algorithm of peripheral */
N#define DMA_CHXCTL_MNAGA                  BIT(10)                       /*!< next address generation algorithm of memory */
N#define DMA_CHXCTL_PWIDTH                 BITS(11,12)                   /*!< transfer width of peipheral */
N#define DMA_CHXCTL_MWIDTH                 BITS(13,14)                   /*!< transfer width of memory */
N#define DMA_CHXCTL_PAIF                   BIT(15)                       /*!< peripheral address increment fixed */
N#define DMA_CHXCTL_PRIO                   BITS(16,17)                   /*!< priority level */
N#define DMA_CHXCTL_SBMEN                  BIT(18)                       /*!< switch-buffer mode enable */
N#define DMA_CHXCTL_MBS                    BIT(19)                       /*!< memory buffer select */
N#define DMA_CHXCTL_PBURST                 BITS(21,22)                   /*!< transfer burst type of peripheral */
N#define DMA_CHXCTL_MBURST                 BITS(23,24)                   /*!< transfer burst type of memory */
N#define DMA_CHXCTL_PERIEN                 BITS(25,27)                   /*!< peripheral enable */
N
N/* DMA_CHxCNT,x=0..7 */
N#define DMA_CHXCNT_CNT                    BITS(0,15)                    /*!< transfer counter */
N
N/* DMA_CHxPADDR,x=0..7 */
N#define DMA_CHXPADDR_PADDR                BITS(0,31)                    /*!< peripheral base address */
N
N/* DMA_CHxM0ADDR,x=0..7 */
N#define DMA_CHXM0ADDR_M0ADDR              BITS(0,31)                    /*!< memory 0 base address */
N
N/* DMA_CHxM1ADDR,x=0..7 */
N#define DMA_CHXM1ADDR_M0ADDR              BITS(0,31)                    /*!< memory 1 base address */
N
N/* DMA_CHxFCTL,x=0..7 */
N#define DMA_CHXFCTL_FCCV                  BITS(0,1)                     /*!< FIFO counter critical value */
N#define DMA_CHXFCTL_MDMEN                 BIT(2)                        /*!< multi-data mode enable */
N#define DMA_CHXFCTL_FCNT                  BITS(3,5)                     /*!< FIFO counter */
N#define DMA_CHXFCTL_FEEIE                 BIT(7)                        /*!< FIFO exception interrupt enable */
N
N/* constants definitions */
N/* DMA channel select */
Ntypedef enum 
N{
N    DMA_CH0 = 0,                                    /*!< DMA Channel 0 */
N    DMA_CH1,                                        /*!< DMA Channel 1 */
N    DMA_CH2,                                        /*!< DMA Channel 2 */
N    DMA_CH3,                                        /*!< DMA Channel 3 */
N    DMA_CH4,                                        /*!< DMA Channel 4 */
N    DMA_CH5,                                        /*!< DMA Channel 5 */
N    DMA_CH6,                                        /*!< DMA Channel 6 */
N    DMA_CH7                                         /*!< DMA Channel 7 */
N} dma_channel_enum;
N
N/* DMA peripheral select */
Ntypedef enum 
N{
N    DMA_SUBPERI0 = 0,                               /*!< DMA Peripheral 0 */
N    DMA_SUBPERI1,                                   /*!< DMA Peripheral 1 */
N    DMA_SUBPERI2,                                   /*!< DMA Peripheral 2 */
N    DMA_SUBPERI3,                                   /*!< DMA Peripheral 3 */
N    DMA_SUBPERI4,                                   /*!< DMA Peripheral 4 */
N    DMA_SUBPERI5,                                   /*!< DMA Peripheral 5 */
N    DMA_SUBPERI6,                                   /*!< DMA Peripheral 6 */
N    DMA_SUBPERI7                                    /*!< DMA Peripheral 7 */
N} dma_subperipheral_enum;
N
N/* DMA multidata mode initialize struct */
Ntypedef struct
N{
N    uint32_t periph_addr;                           /*!< peripheral base address */
N    uint32_t periph_width;                          /*!< transfer data size of peripheral */
N    uint32_t periph_inc;                            /*!< peripheral increasing mode */  
N
N    uint32_t memory0_addr;                          /*!< memory 0 base address */
N    uint32_t memory_width;                          /*!< transfer data size of memory */
N    uint32_t memory_inc;                            /*!< memory increasing mode */
N
N    uint32_t memory_burst_width;                    /*!< multi data mode enable */
N    uint32_t periph_burst_width;                    /*!< multi data mode enable */
N    uint32_t critical_value;                        /*!< FIFO critical */
N
N    uint32_t circular_mode;                         /*!< DMA circular mode */
N    uint32_t direction;                             /*!< channel data transfer direction */
N    uint32_t number;                                /*!< channel transfer number */
N    uint32_t priority;                              /*!< channel priority level */
N}dma_multi_data_parameter_struct;
N
N/* DMA singledata mode initialize struct */
Ntypedef struct
N{
N    uint32_t periph_addr;                           /*!< peripheral base address */
N    uint32_t periph_inc;                            /*!< peripheral increasing mode */  
N
N    uint32_t memory0_addr;                          /*!< memory 0 base address */
N    uint32_t memory_inc;                            /*!< memory increasing mode */
N
N    uint32_t periph_memory_width;                   /*!< transfer data size of peripheral */
N
N    uint32_t circular_mode;                         /*!< DMA circular mode */
N    uint32_t direction;                             /*!< channel data transfer direction */
N    uint32_t number;                                /*!< channel transfer number */
N    uint32_t priority;                              /*!< channel priority level */
N} dma_single_data_parameter_struct;
N
N#define DMA_FLAG_ADD(flag,channel)        ((uint32_t)((flag)<<((((uint32_t)(channel)*6U))+((uint32_t)(((uint32_t)(channel)) >> 1U)&0x01U)*4U)))   /*!< DMA channel flag shift */
N
N/* DMA_register address */
N#define DMA_CHCTL(dma,channel)            REG32(((dma) + 0x10U) + 0x18U*(channel))  /*!< the address of DMA channel CHXCTL register  */
N#define DMA_CHCNT(dma,channel)            REG32(((dma) + 0x14U) + 0x18U*(channel))  /*!< the address of DMA channel CHXCNT register */
N#define DMA_CHPADDR(dma,channel)          REG32(((dma) + 0x18U) + 0x18U*(channel))  /*!< the address of DMA channel CHXPADDR register */
N#define DMA_CHM0ADDR(dma,channel)         REG32(((dma) + 0x1CU) + 0x18U*(channel))  /*!< the address of DMA channel CHXM0ADDR register */
N#define DMA_CHM1ADDR(dma,channel)         REG32(((dma) + 0x20U) + 0x18U*(channel))  /*!< the address of DMA channel CHXM1ADDR register */
N#define DMA_CHFCTL(dma,channel)           REG32(((dma) + 0x24U) + 0x18U*(channel))  /*!< the address of DMA channel CHXMADDR register */
N
N/* peripheral select */
N#define CHCTL_PERIEN(regval)              (BITS(25,27) & ((uint32_t)(regval) << 25))
N#define DMA_PERIPH_0_SELECT               CHCTL_PERIEN(0)                           /*!< peripheral 0 select */
N#define DMA_PERIPH_1_SELECT               CHCTL_PERIEN(1)                           /*!< peripheral 1 select */
N#define DMA_PERIPH_2_SELECT               CHCTL_PERIEN(2)                           /*!< peripheral 2 select */
N#define DMA_PERIPH_3_SELECT               CHCTL_PERIEN(3)                           /*!< peripheral 3 select */
N#define DMA_PERIPH_4_SELECT               CHCTL_PERIEN(4)                           /*!< peripheral 4 select */
N#define DMA_PERIPH_5_SELECT               CHCTL_PERIEN(5)                           /*!< peripheral 5 select */
N#define DMA_PERIPH_6_SELECT               CHCTL_PERIEN(6)                           /*!< peripheral 6 select */
N#define DMA_PERIPH_7_SELECT               CHCTL_PERIEN(7)                           /*!< peripheral 7 select */
N
N/* burst type of memory */
N#define CHCTL_MBURST(regval)              (BITS(23,24) & ((uint32_t)(regval) << 23))
N#define DMA_MEMORY_BURST_SINGLE           CHCTL_MBURST(0)                           /*!< single burst */
N#define DMA_MEMORY_BURST_4_BEAT           CHCTL_MBURST(1)                           /*!< 4-beat burst */
N#define DMA_MEMORY_BURST_8_BEAT           CHCTL_MBURST(2)                           /*!< 8-beat burst */
N#define DMA_MEMORY_BURST_16_BEAT          CHCTL_MBURST(3)                           /*!< 16-beat burst */
N
N/* burst type of peripheral */
N#define CHCTL_PBURST(regval)              (BITS(21,22) & ((uint32_t)(regval) << 21))
N#define DMA_PERIPH_BURST_SINGLE           CHCTL_PBURST(0)                           /*!< single burst */
N#define DMA_PERIPH_BURST_4_BEAT           CHCTL_PBURST(1)                           /*!< 4-beat burst */
N#define DMA_PERIPH_BURST_8_BEAT           CHCTL_PBURST(2)                           /*!< 8-beat burst */
N#define DMA_PERIPH_BURST_16_BEAT          CHCTL_PBURST(3)                           /*!< 16-beat burst */
N
N/* channel priority level */
N#define CHCTL_PRIO(regval)                (BITS(16,17) & ((uint32_t)(regval) << 16))
N#define DMA_PRIORITY_LOW                  CHCTL_PRIO(0)                             /*!< low priority */
N#define DMA_PRIORITY_MEDIUM               CHCTL_PRIO(1)                             /*!< medium priority */
N#define DMA_PRIORITY_HIGH                 CHCTL_PRIO(2)                             /*!< high priority */
N#define DMA_PRIORITY_ULTRA_HIGH           CHCTL_PRIO(3)                             /*!< ultra high priority */
N
N/* transfer data width of memory */
N#define CHCTL_MWIDTH(regval)              (BITS(13,14) & ((uint32_t)(regval) << 13))
N#define DMA_MEMORY_WIDTH_8BIT             CHCTL_MWIDTH(0)                           /*!< transfer data width of memory is 8-bit */
N#define DMA_MEMORY_WIDTH_16BIT            CHCTL_MWIDTH(1)                           /*!< transfer data width of memory is 16-bit */
N#define DMA_MEMORY_WIDTH_32BIT            CHCTL_MWIDTH(2)                           /*!< transfer data width of memory is 32-bit */
N
N/* transfer data width of peripheral */
N#define CHCTL_PWIDTH(regval)              (BITS(11,12) & ((uint32_t)(regval) << 11))
N#define DMA_PERIPH_WIDTH_8BIT             CHCTL_PWIDTH(0)                           /*!< transfer data width of peripheral is 8-bit */
N#define DMA_PERIPH_WIDTH_16BIT            CHCTL_PWIDTH(1)                           /*!< transfer data width of peripheral is 16-bit */
N#define DMA_PERIPH_WIDTH_32BIT            CHCTL_PWIDTH(2)                           /*!< transfer data width of peripheral is 32-bit */
N
N/* channel transfer mode */
N#define CHCTL_TM(regval)                  (BITS(6,7) & ((uint32_t)(regval) << 6))
N#define DMA_PERIPH_TO_MEMORY              CHCTL_TM(0)                               /*!< read from peripheral and write to memory */
N#define DMA_MEMORY_TO_PERIPH              CHCTL_TM(1)                               /*!< read from memory and write to peripheral */
N#define DMA_MEMORY_TO_MEMORY              CHCTL_TM(2)                               /*!< read from memory and write to memory */
N
N/* FIFO counter critical value */
N#define CHFCTL_FCCV(regval)               (BITS(0,1) & ((uint32_t)(regval) << 0))
N#define DMA_FIFO_1_WORD                   CHFCTL_FCCV(0)                            /*!< critical value 1 word */
N#define DMA_FIFO_2_WORD                   CHFCTL_FCCV(1)                            /*!< critical value 2 word */
N#define DMA_FIFO_3_WORD                   CHFCTL_FCCV(2)                            /*!< critical value 3 word */
N#define DMA_FIFO_4_WORD                   CHFCTL_FCCV(3)                            /*!< critical value 4 word */
N
N/* memory select */
N#define DMA_MEMORY_0                      ((uint32_t)0x00000000U)                   /*!< select memory 0 */
N#define DMA_MEMORY_1                      ((uint32_t)0x00000001U)                   /*!< select memory 1 */
N
N/* DMA circular mode */
N#define DMA_CIRCULAR_MODE_ENABLE          ((uint32_t)0x00000000U)                   /*!< circular mode enable */
N#define DMA_CIRCULAR_MODE_DISABLE         ((uint32_t)0x00000001U)                   /*!< circular mode disable */
N
N/* DMA flow controller select */
N#define DMA_FLOW_CONTROLLER_DMA           ((uint32_t)0x00000000U)                   /*!< DMA is the flow controler */
N#define DMA_FLOW_CONTROLLER_PERI          ((uint32_t)0x00000001U)                   /*!< peripheral is the flow controler */
N
N/* peripheral increasing mode */
N#define DMA_PERIPH_INCREASE_ENABLE        ((uint32_t)0x00000000U)                   /*!< next address of peripheral is increasing address mode */
N#define DMA_PERIPH_INCREASE_DISABLE       ((uint32_t)0x00000001U)                   /*!< next address of peripheral is fixed address mode */
N#define DMA_PERIPH_INCREASE_FIX           ((uint32_t)0x00000002U)                   /*!< next address of peripheral is increasing fixed */
N
N/* memory increasing mode */
N#define DMA_MEMORY_INCREASE_ENABLE        ((uint32_t)0x00000000U)                   /*!< next address of memory is increasing address mode */
N#define DMA_MEMORY_INCREASE_DISABLE       ((uint32_t)0x00000001U)                   /*!< next address of memory is fixed address mode */
N
N/* FIFO status */
N#define DMA_FIFO_STATUS_NODATA            ((uint32_t)0x00000000U)                   /*!< the data in the FIFO less than 1 word */
N#define DMA_FIFO_STATUS_1_WORD            ((uint32_t)0x00000001U)                   /*!< the data in the FIFO more than 1 word, less than 2 words */
N#define DMA_FIFO_STATUS_2_WORD            ((uint32_t)0x00000002U)                   /*!< the data in the FIFO more than 2 word, less than 3 words */
N#define DMA_FIFO_STATUS_3_WORD            ((uint32_t)0x00000003U)                   /*!< the data in the FIFO more than 3 word, less than 4 words */
N#define DMA_FIFO_STATUS_EMPTY             ((uint32_t)0x00000004U)                   /*!< the data in the FIFO is empty */
N#define DMA_FIFO_STATUS_FULL              ((uint32_t)0x00000005U)                   /*!< the data in the FIFO is full */
N
N/* DMA reset value */
N#define DMA_CHCTL_RESET_VALUE             ((uint32_t)0x00000000U)                   /*!< the reset value of DMA channel CHXCTL register */
N#define DMA_CHCNT_RESET_VALUE             ((uint32_t)0x00000000U)                   /*!< the reset value of DMA channel CHXCNT register */
N#define DMA_CHPADDR_RESET_VALUE           ((uint32_t)0x00000000U)                   /*!< the reset value of DMA channel CHXPADDR register */
N#define DMA_CHMADDR_RESET_VALUE           ((uint32_t)0x00000000U)                   /*!< the reset value of DMA channel CHXMADDR register */
N#define DMA_CHINTF_RESET_VALUE            ((uint32_t)0x0000003DU)                   /*!< clear DMA channel CHXINTFS register */
N#define DMA_CHFCTL_RESET_VALUE            ((uint32_t)0x00000000U)                   /*!< the reset value of DMA channel CHXFCTL register */
N
N/* DMA_INTF register */
N/* interrupt flag bits */
N#define DMA_INT_FLAG_FEE                  DMA_INTF_FEEIF                            /*!< FIFO error and exception flag */
N#define DMA_INT_FLAG_SDE                  DMA_INTF_SDEIF                            /*!< single data mode exception flag */
N#define DMA_INT_FLAG_TAE                  DMA_INTF_TAEIF                            /*!< transfer access error flag */
N#define DMA_INT_FLAG_HTF                  DMA_INTF_HTFIF                            /*!< half transfer finish flag */
N#define DMA_INT_FLAG_FTF                  DMA_INTF_FTFIF                            /*!< full transfer finish flag */
N
N/* flag bits */
N#define DMA_FLAG_FEE                      DMA_INTF_FEEIF                            /*!< FIFO error and exception flag */
N#define DMA_FLAG_SDE                      DMA_INTF_SDEIF                            /*!< single data mode exception flag */
N#define DMA_FLAG_TAE                      DMA_INTF_TAEIF                            /*!< transfer access error flag */
N#define DMA_FLAG_HTF                      DMA_INTF_HTFIF                            /*!< half transfer finish flag */
N#define DMA_FLAG_FTF                      DMA_INTF_FTFIF                            /*!< full transfer finish flag */
N
N
N/* function declarations */
N/* DMA deinitialization and initialization functions */
N/* deinitialize DMA a channel registers */
Nvoid dma_deinit(uint32_t dma_periph, dma_channel_enum channelx);
N/* initialize the DMA single data mode parameters struct with the default values */
Nvoid dma_single_data_para_struct_init(dma_single_data_parameter_struct* init_struct);
N/* initialize the DMA multi data mode parameters struct with the default values */
Nvoid dma_multi_data_para_struct_init(dma_multi_data_parameter_struct* init_struct);
N/* DMA single data mode initialize */
Nvoid dma_single_data_mode_init(uint32_t dma_periph, dma_channel_enum channelx, dma_single_data_parameter_struct* init_struct);
N/* DMA multi data mode initialize */
Nvoid dma_multi_data_mode_init(uint32_t dma_periph, dma_channel_enum channelx, dma_multi_data_parameter_struct* init_struct);
N
N/* DMA configuration functions */
N/* set DMA peripheral base address */
Nvoid dma_periph_address_config(uint32_t dma_periph, dma_channel_enum channelx, uint32_t address);
N/* set DMA Memory base address */
Nvoid dma_memory_address_config(uint32_t dma_periph, dma_channel_enum channelx, uint8_t memory_flag, uint32_t address);
N
N/* set the number of remaining data to be transferred by the DMA */
Nvoid dma_transfer_number_config(uint32_t dma_periph,dma_channel_enum channelx, uint32_t number);
N/* get the number of remaining data to be transferred by the DMA */
Nuint32_t dma_transfer_number_get(uint32_t dma_periph, dma_channel_enum channelx);
N
N/* configure priority level of DMA channel */
Nvoid dma_priority_config(uint32_t dma_periph, dma_channel_enum channelx, uint32_t priority);
N
N/* configure transfer burst beats of memory */
Nvoid dma_memory_burst_beats_config (uint32_t dma_periph, dma_channel_enum channelx, uint32_t mbeat);
N/* configure transfer burst beats of peripheral */
Nvoid dma_periph_burst_beats_config (uint32_t dma_periph, dma_channel_enum channelx, uint32_t pbeat);
N/* configure transfer data size of memory */
Nvoid dma_memory_width_config (uint32_t dma_periph, dma_channel_enum channelx, uint32_t msize);
N/* configure transfer data size of peripheral */
Nvoid dma_periph_width_config (uint32_t dma_periph, dma_channel_enum channelx, uint32_t psize);
N
N/* configure next address increasement algorithm of memory */
Nvoid dma_memory_address_generation_config(uint32_t dma_periph, dma_channel_enum channelx, uint8_t generation_algorithm);
N/* configure next address increasement algorithm of peripheral */
Nvoid dma_peripheral_address_generation_config(uint32_t dma_periph, dma_channel_enum channelx, uint8_t generation_algorithm);
N
N/* enable DMA circulation mode */
Nvoid dma_circulation_enable(uint32_t dma_periph, dma_channel_enum channelx);
N/* disable DMA circulation mode */
Nvoid dma_circulation_disable(uint32_t dma_periph, dma_channel_enum channelx);
N/* enable DMA channel */
Nvoid dma_channel_enable(uint32_t dma_periph, dma_channel_enum channelx);
N/* disable DMA channel */
Nvoid dma_channel_disable(uint32_t dma_periph, dma_channel_enum channelx);
N
N/* configure the direction of data transfer on the channel */
Nvoid dma_transfer_direction_config(uint32_t dma_periph, dma_channel_enum channelx, uint8_t direction);
N
N/* DMA switch buffer mode config */
Nvoid dma_switch_buffer_mode_config(uint32_t dma_periph, dma_channel_enum channelx, uint32_t memory1_addr, uint32_t memory_select);
N/* DMA using memory get */
Nuint32_t dma_using_memory_get(uint32_t dma_periph, dma_channel_enum channelx);
N
N/* DMA channel peripheral select */
Nvoid dma_channel_subperipheral_select(uint32_t dma_periph, dma_channel_enum channelx, dma_subperipheral_enum sub_periph);
N/* DMA flow controller configure */
Nvoid dma_flow_controller_config(uint32_t dma_periph, dma_channel_enum channelx, uint32_t controller);
N/* DMA flow controller enable */
Nvoid dma_switch_buffer_mode_enable(uint32_t dma_periph, dma_channel_enum channelx, ControlStatus newvalue);
N/* DMA FIFO status get */
Nuint32_t dma_fifo_status_get(uint32_t dma_periph, dma_channel_enum channelx);
N
N/* flag and interrupt functions */
N/* check DMA flag is set or not */
NFlagStatus dma_flag_get(uint32_t dma_periph, dma_channel_enum channelx, uint32_t flag);
N/* clear DMA a channel flag */
Nvoid dma_flag_clear(uint32_t dma_periph, dma_channel_enum channelx, uint32_t flag);
N/* check DMA flag is set or not */
NFlagStatus dma_interrupt_flag_get(uint32_t dma_periph, dma_channel_enum channelx, uint32_t interrupt);
N/* clear DMA a channel flag */
Nvoid dma_interrupt_flag_clear(uint32_t dma_periph, dma_channel_enum channelx, uint32_t interrupt);
N/* enable DMA interrupt */
Nvoid dma_interrupt_enable(uint32_t dma_periph, dma_channel_enum channelx, uint32_t source);
N/* disable DMA interrupt */
Nvoid dma_interrupt_disable(uint32_t dma_periph, dma_channel_enum channelx, uint32_t source);
N
N#endif /* GD32F4XX_DMA_H */
