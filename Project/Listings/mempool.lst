N#if defined(__ARMCC_VERSION)        /* ARM Compiler */
X#if 1L         
N#define rt_section(x)               __attribute__((section(x)))
N#define rt_used                     __attribute__((used))
N#define rt_align(n)                 __attribute__((aligned(n)))
N#if __ARMCC_VERSION >= 6010050
X#if 5060960 >= 6010050
S#define rt_packed(declare)          declare __attribute__((packed))
N#else
N#define rt_packed(declare)          __packed declare
N#endif
N#define rt_weak                     __attribute__((weak))
N#define rt_typeof                   __typeof
N#define rt_noreturn
N#define rt_inline                   static __inline
N#define rt_always_inline            rt_inline
N#elif defined (__IAR_SYSTEMS_ICC__) /* for IAR Compiler */
S#define rt_section(x)               @ x
S#define rt_used                     __root
S#define PRAGMA(x)                   _Pragma(#x)
S#define rt_align(n)                 PRAGMA(data_alignment=n)
S#define rt_packed(declare)          declare
S#define rt_weak                     __weak
S#define rt_typeof                   __typeof
S#define rt_noreturn
S#define rt_inline                   static inline
S#define rt_always_inline            rt_inline
S#elif defined (__GNUC__)            /* GNU GCC Compiler */
S#define __RT_STRINGIFY(x...)        #x
S#define RT_STRINGIFY(x...)          __RT_STRINGIFY(x)
S#define rt_section(x)               __attribute__((section(x)))
S#define rt_used                     __attribute__((used))
S#define rt_align(n)                 __attribute__((aligned(n)))
S#define rt_packed(declare)          declare __attribute__((packed))
S#define rt_weak                     __attribute__((weak))
S#define rt_typeof                   __typeof__
S#define rt_noreturn                 __attribute__ ((noreturn))
S#define rt_inline                   static __inline
S#define rt_always_inline            static inline __attribute__((always_inline))
S#elif defined (__ADSPBLACKFIN__)    /* for VisualDSP++ Compiler */
S#define rt_section(x)               __attribute__((section(x)))
S#define rt_used                     __attribute__((used))
S#define rt_align(n)                 __attribute__((aligned(n)))
S#define rt_packed(declare)          declare
S#define rt_weak                     __attribute__((weak))
S#define rt_typeof                   typeof
S#define rt_noreturn
S#define rt_inline                   static inline
S#define rt_always_inline            rt_inline
S#elif defined (_MSC_VER)            /* for Visual Studio Compiler */
S#define rt_section(x)
S#define rt_used
S#define rt_align(n)                 __declspec(align(n))
S#define rt_packed(declare)          __pragma(pack(push, 1)) declare __pragma(pack(pop))
S#define rt_weak
S#define rt_typeof                   typeof
S#define rt_noreturn
S#define rt_inline                   static __inline
S#define rt_always_inline            rt_inline
S#elif defined (__TI_COMPILER_VERSION__) /* for TI CCS Compiler */
S/**
S * The way that TI compiler set section is different from other(at least
S * GCC and MDK) compilers. See ARM Optimizing C/C++ Compiler 5.9.3 for more
S * details.
S */
S#define rt_section(x)               __attribute__((section(x)))
S#ifdef __TI_EABI__
S#define rt_used                     __attribute__((retain)) __attribute__((used))
S#else
S#define rt_used                     __attribute__((used))
S#endif
S#define PRAGMA(x)                   _Pragma(#x)
S#define rt_align(n)                 __attribute__((aligned(n)))
S#define rt_packed(declare)          declare __attribute__((packed))
S#ifdef __TI_EABI__
S#define rt_weak                     __attribute__((weak))
S#else
S#define rt_weak
S#endif
S#define rt_typeof                   typeof
S#define rt_noreturn
S#define rt_inline                   static inline
S#define rt_always_inline            rt_inline
S#elif defined (__TASKING__)         /* for TASKING Compiler */
S#define rt_section(x)               __attribute__((section(x)))
S#define rt_used                     __attribute__((used, protect))
S#define PRAGMA(x)                   _Pragma(#x)
S#define rt_align(n)                 __attribute__((__align(n)))
S#define rt_packed(declare)          declare __packed__
S#define rt_weak                     __attribute__((weak))
S#define rt_typeof                   typeof
S#define rt_noreturn
S#define rt_inline                   static inline
S#define rt_always_inline            rt_inline
S#else                              /* Unkown Compiler */
S    #error not supported tool chain
N#endif /* __ARMCC_VERSION */
