N    Copyright (c) 2020, GigaDevice Semiconductor Inc.
N
N    Redistribution and use in source and binary forms, with or without modification, 
Nare permitted provided that the following conditions are met:
N
N    1. Redistributions of source code must retain the above copyright notice, this 
N       list of conditions and the following disclaimer.
N    2. Redistributions in binary form must reproduce the above copyright notice, 
N       this list of conditions and the following disclaimer in the documentation 
N       and/or other materials provided with the distribution.
N    3. Neither the name of the copyright holder nor the names of its contributors 
N       may be used to endorse or promote products derived from this software without 
N       specific prior written permission.
N
N    THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS" 
NAND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED 
NWARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED. 
NIN NO EVENT SHALL THE COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, 
NINDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT 
NNOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR 
NPROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, 
NWHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) 
NARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY 
NOF SUCH DAMAGE.
N*/
N
N#ifndef GD32F4XX_CTC_H
S#define GD32F4XX_CTC_H
S
S#include "gd32f4xx.h"
S
S/* CTC definitions */
S#define CTC                          CTC_BASE
S
S/* registers definitions */
S#define CTC_CTL0                     REG32((CTC) + 0x00U)      /*!< CTC control register 0 */
S#define CTC_CTL1                     REG32((CTC) + 0x04U)      /*!< CTC control register 1 */
S#define CTC_STAT                     REG32((CTC) + 0x08U)      /*!< CTC status register */
S#define CTC_INTC                     REG32((CTC) + 0x0CU)      /*!< CTC interrupt clear register */
S
S/* bits definitions */
S/* CTC_CTL0 */
S#define CTC_CTL0_CKOKIE              BIT(0)                    /*!< clock trim OK(CKOKIF) interrupt enable */ 
S#define CTC_CTL0_CKWARNIE            BIT(1)                    /*!< clock trim warning(CKWARNIF) interrupt enable */
S#define CTC_CTL0_ERRIE               BIT(2)                    /*!< error(ERRIF) interrupt enable */
S#define CTC_CTL0_EREFIE              BIT(3)                    /*!< EREFIF interrupt enable */
S#define CTC_CTL0_CNTEN               BIT(5)                    /*!< CTC counter enable */
S#define CTC_CTL0_AUTOTRIM            BIT(6)                    /*!< hardware automatically trim mode */
S#define CTC_CTL0_SWREFPUL            BIT(7)                    /*!< software reference source sync pulse */
S#define CTC_CTL0_TRIMVALUE           BITS(8,13)                /*!< IRC48M trim value */
S
S/* CTC_CTL1 */
S#define CTC_CTL1_RLVALUE             BITS(0,15)                /*!< CTC counter reload value */
S#define CTC_CTL1_CKLIM               BITS(16,23)               /*!< clock trim base limit value */
S#define CTC_CTL1_REFPSC              BITS(24,26)               /*!< reference signal source prescaler */
S#define CTC_CTL1_REFSEL              BITS(28,29)               /*!< reference signal source selection */
S#define CTC_CTL1_USBSOFSEL           BIT(30)                   /*!< USBFS or USBHS SOF signal selection */
S#define CTC_CTL1_REFPOL              BIT(31)                   /*!< reference signal source polarity */
S
S/* CTC_STAT */
S#define CTC_STAT_CKOKIF              BIT(0)                    /*!< clock trim OK interrupt flag */
S#define CTC_STAT_CKWARNIF            BIT(1)                    /*!< clock trim warning interrupt flag */
S#define CTC_STAT_ERRIF               BIT(2)                    /*!< error interrupt flag */
S#define CTC_STAT_EREFIF              BIT(3)                    /*!< expect reference interrupt flag */
S#define CTC_STAT_CKERR               BIT(8)                    /*!< clock trim error bit */
S#define CTC_STAT_REFMISS             BIT(9)                    /*!< reference sync pulse miss */
S#define CTC_STAT_TRIMERR             BIT(10)                   /*!< trim value error bit */
S#define CTC_STAT_REFDIR              BIT(15)                   /*!< CTC trim counter direction when reference sync pulse occurred */
S#define CTC_STAT_REFCAP              BITS(16,31)               /*!< CTC counter capture when reference sync pulse occurred */
S
S/* CTC_INTC */
S#define CTC_INTC_CKOKIC              BIT(0)                    /*!< CKOKIF interrupt clear bit */
S#define CTC_INTC_CKWARNIC            BIT(1)                    /*!< CKWARNIF interrupt clear bit */
S#define CTC_INTC_ERRIC               BIT(2)                    /*!< ERRIF interrupt clear bit */
S#define CTC_INTC_EREFIC              BIT(3)                    /*!< EREFIF interrupt clear bit */
S
S/* constants definitions */
S/* hardware automatically trim mode definitions */
S#define CTC_HARDWARE_TRIM_MODE_ENABLE                    CTC_CTL0_AUTOTRIM            /*!< hardware automatically trim mode enable*/
S#define CTC_HARDWARE_TRIM_MODE_DISABLE                   ((uint32_t)0x00000000U)      /*!< hardware automatically trim mode disable*/
S
S/* reference signal source polarity definitions */
S#define CTC_REFSOURCE_POLARITY_FALLING                   CTC_CTL1_REFPOL              /*!< reference signal source polarity is falling edge*/
S#define CTC_REFSOURCE_POLARITY_RISING                    ((uint32_t)0x00000000U)      /*!< reference signal source polarity is rising edge*/
S
S/* USBFS or USBHS SOF signal selection definitions */
S#define CTC_USBSOFSEL_USBHS                              CTC_CTL1_USBSOFSEL           /*!< USBHS SOF signal is selected*/
S#define CTC_USBSOFSEL_USBFS                              ((uint32_t)0x00000000U)      /*!< USBFS SOF signal is selected*/
S
S/* reference signal source selection definitions */
S#define CTL1_REFSEL(regval)                              (BITS(28,29) & ((uint32_t)(regval) << 28))
S#define CTC_REFSOURCE_GPIO                               CTL1_REFSEL(0)               /*!< GPIO is selected */
S#define CTC_REFSOURCE_LXTAL                              CTL1_REFSEL(1)               /*!< LXTAL is clock selected */
S#define CTC_REFSOURCE_USBSOF                             CTL1_REFSEL(2)               /*!< USBSOF is selected */
S
S/* reference signal source prescaler definitions */
S#define CTL1_REFPSC(regval)                              (BITS(24,26) & ((uint32_t)(regval) << 24))
S#define CTC_REFSOURCE_PSC_OFF                            CTL1_REFPSC(0)               /*!< reference signal not divided */
S#define CTC_REFSOURCE_PSC_DIV2                           CTL1_REFPSC(1)               /*!< reference signal divided by 2 */
S#define CTC_REFSOURCE_PSC_DIV4                           CTL1_REFPSC(2)               /*!< reference signal divided by 4 */
S#define CTC_REFSOURCE_PSC_DIV8                           CTL1_REFPSC(3)               /*!< reference signal divided by 8 */
S#define CTC_REFSOURCE_PSC_DIV16                          CTL1_REFPSC(4)               /*!< reference signal divided by 16 */
S#define CTC_REFSOURCE_PSC_DIV32                          CTL1_REFPSC(5)               /*!< reference signal divided by 32 */
S#define CTC_REFSOURCE_PSC_DIV64                          CTL1_REFPSC(6)               /*!< reference signal divided by 64 */
S#define CTC_REFSOURCE_PSC_DIV128                         CTL1_REFPSC(7)               /*!< reference signal divided by 128 */
S
S/* CTC interrupt enable definitions */
S#define CTC_INT_CKOK                                     CTC_CTL0_CKOKIE             /*!< clock trim OK interrupt enable */
S#define CTC_INT_CKWARN                                   CTC_CTL0_CKWARNIE           /*!< clock trim warning interrupt enable */
S#define CTC_INT_ERR                                      CTC_CTL0_ERRIE              /*!< error interrupt enable */
S#define CTC_INT_EREF                                     CTC_CTL0_EREFIE             /*!< expect reference interrupt enable */
S
S/* CTC interrupt source definitions */
S#define CTC_INT_FLAG_CKOK                                CTC_STAT_CKOKIF             /*!< clock trim OK interrupt flag */
S#define CTC_INT_FLAG_CKWARN                              CTC_STAT_CKWARNIF           /*!< clock trim warning interrupt flag */
S#define CTC_INT_FLAG_ERR                                 CTC_STAT_ERRIF              /*!< error interrupt flag */
S#define CTC_INT_FLAG_EREF                                CTC_STAT_EREFIF             /*!< expect reference interrupt flag */
S#define CTC_INT_FLAG_CKERR                               CTC_STAT_CKERR              /*!< clock trim error bit */
S#define CTC_INT_FLAG_REFMISS                             CTC_STAT_REFMISS            /*!< reference sync pulse miss */
S#define CTC_INT_FLAG_TRIMERR                             CTC_STAT_TRIMERR            /*!< trim value error */
S
S/* CTC flag definitions */
S#define CTC_FLAG_CKOK                                    CTC_STAT_CKOKIF             /*!< clock trim OK flag */
S#define CTC_FLAG_CKWARN                                  CTC_STAT_CKWARNIF           /*!< clock trim warning flag */
S#define CTC_FLAG_ERR                                     CTC_STAT_ERRIF              /*!< error flag */
S#define CTC_FLAG_EREF                                    CTC_STAT_EREFIF             /*!< expect reference flag */
S#define CTC_FLAG_CKERR                                   CTC_STAT_CKERR              /*!< clock trim error bit */
S#define CTC_FLAG_REFMISS                                 CTC_STAT_REFMISS            /*!< reference sync pulse miss */
S#define CTC_FLAG_TRIMERR                                 CTC_STAT_TRIMERR            /*!< trim value error bit */
S
S/* function declarations */
S/* reset ctc clock trim controller */
Svoid ctc_deinit(void);
S/* enable CTC trim counter */
Svoid ctc_counter_enable(void);
S/* disable CTC trim counter */
Svoid ctc_counter_disable(void);
S
S/* configure the IRC48M trim value */
Svoid ctc_irc48m_trim_value_config(uint8_t trim_value);
S/* generate software reference source sync pulse */
Svoid ctc_software_refsource_pulse_generate(void);
S/* configure hardware automatically trim mode */
Svoid ctc_hardware_trim_mode_config(uint32_t hardmode);
S
S/* configure reference signal source polarity */
Svoid ctc_refsource_polarity_config(uint32_t polarity);
S/* select USBFS or USBHS SOF signal */
Svoid ctc_usbsof_signal_select(uint32_t usbsof);
S/* select reference signal source */
Svoid ctc_refsource_signal_select(uint32_t refs);
S/* configure reference signal source prescaler */
Svoid ctc_refsource_prescaler_config(uint32_t prescaler);
S/* configure clock trim base limit value */
Svoid ctc_clock_limit_value_config(uint8_t limit_value);
S/* configure CTC counter reload value */
Svoid ctc_counter_reload_value_config(uint16_t reload_value);
S
S/* read CTC counter capture value when reference sync pulse occurred */
Suint16_t ctc_counter_capture_value_read(void);
S/* read CTC trim counter direction when reference sync pulse occurred */
SFlagStatus ctc_counter_direction_read(void);
S/* read CTC counter reload value */
Suint16_t ctc_counter_reload_value_read(void);
S/* read the IRC48M trim value */
Suint8_t ctc_irc48m_trim_value_read(void);
S
S/* interrupt & flag functions */
S/* enable the CTC interrupt */
Svoid ctc_interrupt_enable(uint32_t interrupt);
S/* disable the CTC interrupt */
Svoid ctc_interrupt_disable(uint32_t interrupt);
S/* get CTC interrupt flag */
SFlagStatus ctc_interrupt_flag_get(uint32_t int_flag); 
S/* clear CTC interrupt flag */
Svoid ctc_interrupt_flag_clear(uint32_t int_flag);
S/* get CTC flag */
SFlagStatus ctc_flag_get(uint32_t flag);
S/* clear CTC flag */
Svoid ctc_flag_clear(uint32_t flag);
S
N#endif /* GD32F4XX_CTC_H */
L 47 "..\User\config\gd32f4xx_libopt.h" 2
N#include "gd32f4xx_dac.h"
L 1 "..\Libraries\GD32F4xx_standard_peripheral\Include\gd32f4xx_dac.h" 1
N/*!
N    \file    gd32f4xx_dac.h
