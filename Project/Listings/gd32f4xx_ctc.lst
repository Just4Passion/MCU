N/*!
N    \file    gd32f4xx_ctc.h
N    \brief   definitions for the CTC
N
N    \version 2016-08-15, V1.0.0, firmware for GD32F4xx
N    \version 2018-12-12, V2.0.0, firmware for GD32F4xx
N    \version 2020-09-30, V2.1.0, firmware for GD32F4xx
