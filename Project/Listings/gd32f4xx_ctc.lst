N
N/* GD32F4xx firmware library version number V1.0 */
N#define __GD32F4xx_STDPERIPH_VERSION_MAIN   (0x03) /*!< [31:24] main version     */
N#define __GD32F4xx_STDPERIPH_VERSION_SUB1   (0x00) /*!< [23:16] sub1 version     */
N#define __GD32F4xx_STDPERIPH_VERSION_SUB2   (0x00) /*!< [15:8]  sub2 version     */
N#define __GD32F4xx_STDPERIPH_VERSION_RC     (0x00) /*!< [7:0]  release candidate */
N#define __GD32F4xx_STDPERIPH_VERSION        ((__GD32F4xx_STDPERIPH_VERSION_MAIN << 24)\
N                                            |(__GD32F4xx_STDPERIPH_VERSION_SUB1 << 16)\
N                                            |(__GD32F4xx_STDPERIPH_VERSION_SUB2 << 8)\
N                                            |(__GD32F4xx_STDPERIPH_VERSION_RC))
X#define __GD32F4xx_STDPERIPH_VERSION        ((__GD32F4xx_STDPERIPH_VERSION_MAIN << 24)                                            |(__GD32F4xx_STDPERIPH_VERSION_SUB1 << 16)                                            |(__GD32F4xx_STDPERIPH_VERSION_SUB2 << 8)                                            |(__GD32F4xx_STDPERIPH_VERSION_RC))
