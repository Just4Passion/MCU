L 1 "..\Libraries\GD32F4xx_standard_peripheral\Include\gd32f4xx_trng.h" 1
N/*!
N    \file    gd32f4xx_trng.h
N    \brief   definitions for the TRNG
N
N    \version 2016-08-15, V1.0.0, firmware for GD32F4xx
N    \version 2018-12-12, V2.0.0, firmware for GD32F4xx
N    \version 2020-09-30, V2.1.0, firmware for GD32F4xx
N*/
N
N/*
N    Copyright (c) 2020, GigaDevice Semiconductor Inc.
N
N    Redistribution and use in source and binary forms, with or without modification, 
Nare permitted provided that the following conditions are met:
N
N    1. Redistributions of source code must retain the above copyright notice, this 
N       list of conditions and the following disclaimer.
N    2. Redistributions in binary form must reproduce the above copyright notice, 
N       this list of conditions and the following disclaimer in the documentation 
N       and/or other materials provided with the distribution.
N    3. Neither the name of the copyright holder nor the names of its contributors 
N       may be used to endorse or promote products derived from this software without 
N       specific prior written permission.
N
N    THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS" 
NAND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED 
NWARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED. 
NIN NO EVENT SHALL THE COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, 
NINDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT 
NNOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR 
NPROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, 
NWHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) 
NARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY 
NOF SUCH DAMAGE.
N*/
N
N#ifndef GD32F4XX_TRNG_H
N#define GD32F4XX_TRNG_H
N
N#include "gd32f4xx.h"
N
N/* TRNG definitions */
N#define TRNG                        TRNG_BASE
N
N/* registers definitions */
N#define TRNG_CTL                    REG32(TRNG + 0x00U)        /*!< control register */
N#define TRNG_STAT                   REG32(TRNG + 0x04U)        /*!< status register */
N#define TRNG_DATA                   REG32(TRNG + 0x08U)        /*!< data register */
N
N/* bits definitions */
N/* TRNG_CTL */
N#define TRNG_CTL_TRNGEN             BIT(2)                     /*!< TRNG enable bit */
N#define TRNG_CTL_IE                 BIT(3)                     /*!< interrupt enable bit */
N
N/* TRNG_STAT */
N#define TRNG_STAT_DRDY              BIT(0)                     /*!< random data ready status bit */
N#define TRNG_STAT_CECS              BIT(1)                     /*!< clock error current status */
N#define TRNG_STAT_SECS              BIT(2)                     /*!< seed error current status */
N#define TRNG_STAT_CEIF              BIT(5)                     /*!< clock error interrupt flag */
N#define TRNG_STAT_SEIF              BIT(6)                     /*!< seed error interrupt flag */
N
N/* TRNG_DATA */
N#define TRNG_DATA_TRNDATA           BITS(0,31)                 /*!< 32-Bit Random data */
N
N/* constants definitions */
N/* trng status flag */
Ntypedef enum
N{ 
N    TRNG_FLAG_DRDY = TRNG_STAT_DRDY,                           /*!< random Data ready status */
X    TRNG_FLAG_DRDY = ((uint32_t)((uint32_t)0x01U<<(0))),                            
N    TRNG_FLAG_CECS = TRNG_STAT_CECS,                           /*!< clock error current status */
X    TRNG_FLAG_CECS = ((uint32_t)((uint32_t)0x01U<<(1))),                            
N    TRNG_FLAG_SECS = TRNG_STAT_SECS                            /*!< seed error current status */
X    TRNG_FLAG_SECS = ((uint32_t)((uint32_t)0x01U<<(2)))                             
N}trng_flag_enum;
N
N/* trng inerrupt flag */
Ntypedef enum
N{
N    TRNG_INT_FLAG_CEIF = TRNG_STAT_CEIF,                       /*!< clock error interrupt flag */
X    TRNG_INT_FLAG_CEIF = ((uint32_t)((uint32_t)0x01U<<(5))),                        
N    TRNG_INT_FLAG_SEIF = TRNG_STAT_SEIF                        /*!< seed error interrupt flag */
X    TRNG_INT_FLAG_SEIF = ((uint32_t)((uint32_t)0x01U<<(6)))                         
N}trng_int_flag_enum;
N
N/* function declarations */
N/* initialization functions */
N/* deinitialize the TRNG */
Nvoid trng_deinit(void);
N/* enable the TRNG interface */
Nvoid trng_enable(void);
N/* disable the TRNG interface */
Nvoid trng_disable(void);
N/* get the true random data */
Nuint32_t trng_get_true_random_data(void);
N
N/* flag & interrupt functions */
N/* trng interrupt enable */
Nvoid trng_interrupt_enable(void);
N/* trng interrupt disable */
Nvoid trng_interrupt_disable(void);
N/* get the trng status flags */
NFlagStatus trng_flag_get(trng_flag_enum flag);
N/* get the trng interrupt flags */
NFlagStatus trng_interrupt_flag_get(trng_int_flag_enum int_flag);
N/* clear the trng interrupt flags */
Nvoid trng_interrupt_flag_clear(trng_int_flag_enum int_flag);
N
N#endif /* GD32F4XX_TRNG_H */
L 64 "..\User\config\gd32f4xx_libopt.h" 2
N#include "gd32f4xx_usart.h"
L 1 "..\Libraries\GD32F4xx_standard_peripheral\Include\gd32f4xx_usart.h" 1
N/*!
N    \file    gd32f4xx_usart.h
N    \brief   definitions for the USART
N    
N    \version 2016-08-15, V1.0.0, firmware for GD32F4xx
N    \version 2018-12-12, V2.0.0, firmware for GD32F4xx
N    \version 2020-09-30, V2.1.0, firmware for GD32F4xx
N*/
N
